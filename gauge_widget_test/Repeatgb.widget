@class Repeatgb(Gridbox)

@CLASSVARS

@PUBLIC
@var String sensor     = <String> "Repeatgb-DEFAULT-SENSOR"
@var String count      = <String> "Repeatgb-DEFAULT-COUNT"
@var String args       = <String> "Repeatgb-DEFAULT-ARGS"

@PRIVATE


@METHODS
@proc realize
{
    XTFUNC();
    #realize($,mask,attributes);
    repgb_parse( $, $args, $count );
}


@IMPORTS
@incl <X11/Xatom.h>
@incl <X11/Xft/Xft.h>
@incl "converters-xft.h"
@incl "converters.h"
@incl <X11/Xmu/Converters.h>
@incl "mls.h"
@incl "xutil.h"
@incl <X11/Xaw/Command.h>
@incl "xtcw/Wlabel.h"
@incl "repeatergb-tool.h"

