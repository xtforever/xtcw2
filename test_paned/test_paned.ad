*foreground: #ecf0f1
*background: #2c3e50
*fontName: Sans-12

test_paned.WcChildren: paned

*weightx: 1
*weighty: 1
*paned*grip.width: 20
*paned*grip.height: 20
*paned*grip.foreground: blue
*paned*grip.borderWidth: 1
*paned*grip.borderColor: white
*paned*grip.translations: #override \
 <Btn1Down>: GripAction(start, ThisBorderOnly) \n\
 <Btn1Motion>: GripAction(move, ThisBorderOnly) \n\
 <Btn1Up>: GripAction(commit, ThisBorderOnly)



*paned.WcClass: WPaned
*paned.WcChildren: l1 paned1 
*paned.orientation: 0
*paned.width: 600
*paned.height: 500

*l1.WcClass: Wlabel
*l1.label: Left

*paned1.WcClass: WPaned
*paned1.orientation: 1
*paned1.WcChildren: top mid bottom
% *paned1.width: 300
% *paned1.height: 400



*top.WcClass: Wlabel
*top.label: {\\large \\bf Top}  Pane
*top.min: 50
*top.preferredPaneSize: 100
*top.borderWidth: 20
*top.borderColor: Red
*top.bg_norm: Blue
*top.fg_norm: Yellow


*mid.WcClass: Wlabel
*mid.label: Middle Pane
*mid.min: 50
% *mid.preferredPaneSize: 100
*mid.showGrip: True

*bottom.WcClass: Wbutton
*bottom.label: Exit
*bottom.callback: quit_cb
*bottom.min: 30
*bottom.preferredPaneSize: 40
*bottom.showGrip: True
