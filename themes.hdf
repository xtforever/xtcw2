; ---- commonly used themes (official palettes) --------------------------
; Dracula - https://draculatheme.com/contribute  (palette by Zeno Rocha)
(theme dracula (
    bg_norm 0x282a36     ; background
    bg_sel  0x44475a     ; current line / selection
    bg_hi   0x6272a4     ; comment (muted active)
    fg_norm 0xf8f8f2     ; foreground
    fg_sel  0x50fa7b     ; green
    fg_hi   0xff5555     ; red
    switch_off 0x44475a
    switch_on 0x50fa7b
    switch_knob_off 0xf8f8f2
    switch_knob_on 0xffffff
    gridbox_bg 0x282a36
    gridbox_border 0x6272a4
    font_tiny     "Sans-9"
    font_small    "Sans-11"
    font_normal   "Sans-13"
    font_large    "Sans-20"
    font_heading2 "Sans-18"
    font_heading1 "Sans-24"
    borderwidth 0
    bordercolor 0x6272a4
    ; --- style-guide roles ---
    button_bg      0x44475a
    button_fg      0xf8f8f2
    button_border  0x6272a4
    input_bg       0x1e1f29
    input_fg       0xf8f8f2
    input_border   0x6272a4
    accent         0xbd93f9
    accent_fg      0x282a36
    list_bg        0x282a36
    list_fg        0xf8f8f2
    list_sel_bg    0x44475a
    list_sel_fg    0xf8f8f2
    list_header_bg 0x1e1f29
    list_header_fg 0xbd93f9
    list_line      0x44475a
    list_alt_bg    0x2f313e
    font_ui        "Sans-13"
    window_margin  16
    control_height 24
    control_padding 6
    control_border 1
    control_gap    8
    group_gap      12
    action_gap     8
    list_row_height 22
    list_header_height 24
    list_cell_pad_x 8
    list_cell_pad_y 2
    icon_size      16
    bar_size       14
))

; Solarized Dark - https://ethanschoonover.com/solarized  (Ethan Schoonover)
(theme solarized_dark (
    bg_norm 0x002b36     ; base03
    bg_sel  0x073642     ; base02
    bg_hi   0x586e75     ; base01
    fg_norm 0x839496     ; base0
    fg_sel  0x268bd2     ; blue
    fg_hi   0xdc322f     ; red/emphasis
    switch_off 0x073642
    switch_on 0x268bd2
    switch_knob_off 0x839496
    switch_knob_on 0xfdf6e3
    gridbox_bg 0x002b36
    gridbox_border 0x586e75
    font_tiny     "Sans-9"
    font_small    "Sans-11"
    font_normal   "Sans-13"
    font_large    "Sans-20"
    font_heading2 "Sans-18"
    font_heading1 "Sans-24"
    borderwidth 0
    bordercolor 0x586e75 ; base01
    ; --- style-guide roles ---
    button_bg      0x073642
    button_fg      0x93a1a1
    button_border  0x586e75
    input_bg       0x002b36
    input_fg       0x93a1a1
    input_border   0x586e75
    accent         0x268bd2
    accent_fg      0xfdf6e3
    list_bg        0x002b36
    list_fg        0x839496
    list_sel_bg    0x073642
    list_sel_fg    0x93a1a1
    list_header_bg 0x073642
    list_header_fg 0x268bd2
    list_line      0x586e75
    list_alt_bg    0x073642
    font_ui        "Sans-13"
    window_margin  16
