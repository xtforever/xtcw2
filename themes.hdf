    tooltip_fg       0x839496
    tooltip_border   0x586e75
    table_bg         0x002b36
    table_fg         0x839496
    table_sel_bg     0x073642
    table_sel_fg     0x93a1a1
    table_header_bg  0x073642
    table_header_fg  0x268bd2
    table_alt_bg     0x073642
    table_line       0x586e75
    tree_bg          0x002b36
    tree_fg          0x839496
    tree_sel_bg      0x073642
    tree_line        0x586e75
    progress_bg      0x002b36
    progress_fill    0x268bd2
    progress_border  0x586e75
