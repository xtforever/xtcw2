; ---- commonly used themes (official palettes) --------------------------
; Dracula - https://draculatheme.com/contribute  (palette by Zeno Rocha)
(theme dracula (
    bg_norm 0x282a36     ; background
    bg_sel  0x44475a     ; current line / selection
    bg_hi   0x6272a4     ; comment (muted active)
    fg_norm 0xf8f8f2     ; foreground
    fg_sel  0x50fa7b     ; green
    fg_hi   0xff5555     ; red
    switch_off 0x44475a
    switch_on 0x50fa7b
    switch_knob_off 0xf8f8f2
    switch_knob_on 0xffffff
    gridbox_bg 0x282a36
    gridbox_border 0x6272a4
    font_tiny     "Sans-9"
    font_small    "Sans-11"
    font_normal   "Sans-13"
    font_large    "Sans-20"
    font_heading2 "Sans-18"
    font_heading1 "Sans-24"
    borderwidth 0
    bordercolor 0x6272a4
    ; --- style-guide roles ---
    button_bg      0x44475a
    button_fg      0xf8f8f2
    button_border  0x6272a4
    input_bg       0x1e1f29
    input_fg       0xf8f8f2
    input_border   0x6272a4
    accent         0xbd93f9
    accent_fg      0x282a36
    list_bg        0x282a36
    list_fg        0xf8f8f2
    list_sel_bg    0x44475a
    list_sel_fg    0xf8f8f2
    list_header_bg 0x1e1f29
    scrollbar_thumb 0x44475a
    list_header_fg 0xbd93f9
    list_line      0x44475a
    list_alt_bg    0x2f313e
    font_ui        "Sans-13"
    window_margin  16
    control_height 24
    control_padding 6
    control_border 1
    control_gap    8
    group_gap      12
    action_gap     8
    list_row_height "16.5pt"
    list_header_height "18pt"
    list_cell_pad_x "6pt"
    list_cell_pad_y "3pt"
    icon_size      "12pt"
    bar_size       "10.5pt"
    ; --- widget surface roles ---
    menu_bg          0x1e1f29
    menu_fg          0xbd93f9
    menu_sel         0xbd93f9
    menu_border      0x44475a
    toolbar_bg       0x1e1f29
    toolbar_fg       0xf8f8f2
    toolbar_border   0x44475a
    status_bg        0x1e1f29
    status_fg        0xf8f8f2
    status_border    0x44475a
    tooltip_bg       0x1e1f29
    tooltip_fg       0xf8f8f2
    tooltip_border   0x44475a
    table_bg         0x282a36
    table_fg         0xf8f8f2
    table_sel_bg     0x44475a
    table_sel_fg     0xf8f8f2
    table_header_bg  0x1e1f29
    table_header_fg  0xbd93f9
    table_alt_bg     0x2f313e
    table_line       0x44475a
    tree_bg          0x282a36
    tree_fg          0xf8f8f2
    tree_sel_bg      0x44475a
    tree_line        0x44475a
    progress_bg      0x1e1f29
    progress_fill    0xbd93f9
    progress_border  0x44475a
    progress_fg      0xf8f8f2
    dialog_bg        0x282a36
    dialog_border    0x44475a
    menu_height      24
    toolbar_height   24
    status_height    24
    dialog_padding   12
    table_row_height "16.5pt"
    table_header_height "18pt"
    tree_indent      18
    tree_row_height  24
    progress_height  16
))

; Solarized Dark - https://ethanschoonover.com/solarized  (Ethan Schoonover)
(theme solarized_dark (
    bg_norm 0x002b36     ; base03
    bg_sel  0x073642     ; base02
    bg_hi   0x586e75     ; base01
    fg_norm 0x839496     ; base0
    fg_sel  0x268bd2     ; blue
    fg_hi   0xdc322f     ; red/emphasis
    switch_off 0x073642
    switch_on 0x268bd2
    switch_knob_off 0x839496
    switch_knob_on 0xfdf6e3
    gridbox_bg 0x002b36
    gridbox_border 0x586e75
    font_tiny     "Sans-9"
    font_small    "Sans-11"
    font_normal   "Sans-13"
    font_large    "Sans-20"
    font_heading2 "Sans-18"
    font_heading1 "Sans-24"
    borderwidth 0
    bordercolor 0x586e75 ; base01
    ; --- style-guide roles ---
    button_bg      0x073642
    button_fg      0x93a1a1
    button_border  0x586e75
    input_bg       0x002b36
    input_fg       0x93a1a1
    input_border   0x586e75
    accent         0x268bd2
    accent_fg      0xfdf6e3
    list_bg        0x002b36
    list_fg        0x839496
