    list_line      0x586e75
    list_alt_bg    0x073642
    font_ui        "Sans-13"
    window_margin  16
    control_height 24
    control_padding 6
    control_border 1
    control_gap    8
    group_gap      12
    action_gap     8
    list_row_height "16.5pt"
    list_header_height "18pt"
    list_cell_pad_x "6pt"
    list_cell_pad_y "3pt"
    icon_size      "12pt"
    bar_size       "10.5pt"
    ; --- widget surface roles ---
    menu_bg          0x073642
    menu_fg          0x268bd2
    menu_sel         0x268bd2
    menu_border      0x586e75
    toolbar_bg       0x073642
    toolbar_fg       0x93a1a1
    toolbar_border   0x586e75
    status_bg        0x073642
    status_fg        0x839496
    status_border    0x586e75
