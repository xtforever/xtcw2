    list_sel_bg    0x000000
    list_sel_fg    0xffffff
    list_header_bg 0xffffff
    scrollbar_thumb 0x808080
    list_header_fg 0x000000
    list_line      0x000000
    list_alt_bg    0xf0f0f0
    font_ui        "Sans-13"
    window_margin  16
    control_height 24
    control_padding 6
    control_border 1
    control_gap    8
    group_gap      12
    action_gap     8
    list_row_height "16.5pt"
    list_header_height "18pt"
    list_cell_pad_x "6pt"
    list_cell_pad_y "3pt"
    icon_size      "12pt"
    bar_size       "10.5pt"
    ; --- widget surface roles ---
    menu_bg          0xffffff
    menu_fg          0x000000
    menu_sel         0x000000
    menu_border      0x000000
    toolbar_bg       0xffffff
    toolbar_fg       0x000000
    toolbar_border   0x000000
    status_bg        0xffffff
    status_fg        0x000000
    status_border    0x000000
    tooltip_bg       0xffffff
    tooltip_fg       0x000000
    tooltip_border   0x000000
    table_bg         0xffffff
    table_fg         0x000000
    table_sel_bg     0x000000
    table_sel_fg     0xffffff
    table_header_bg  0xffffff
    table_header_fg  0x000000
    table_alt_bg     0xf0f0f0
    table_line       0x000000
    tree_bg          0xffffff
    tree_fg          0x000000
    tree_sel_bg      0x000000
    tree_line        0x000000
    progress_bg      0xffffff
    progress_fill    0x000000
    progress_border  0x000000
    progress_fg      0x000000
    dialog_bg        0xffffff
    dialog_border    0x000000
    menu_height      24
    toolbar_height   24
    status_height    24
    dialog_padding   12
    table_row_height "16.5pt"
    table_header_height "18pt"
    tree_indent      18
    tree_row_height  24
    progress_height  16
))

