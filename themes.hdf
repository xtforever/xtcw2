; xtcw theme store (hdf s-expression format)
; (theme NAME (name value name value ...))
;   colour  := 0xRRGGBB
;   integer := decimal (e.g. borderwidth, 0 = no border)
;   string  := "..."   (double-quoted; spaces allowed, no escape sequences)
;              or a bare token (no whitespace/parens)
;
; "default" and "highcontrast" are production themes (borders off).
; "test" uses a thick, bright border so widget bounds are easy to see.
; "dracula" and "solarized_dark" are widely used, officially defined colour
; schemes used to test the widgets under realistic conditions.
;
; font_* are the default font faces/sizes; heading1 is larger than normal.

(theme default (
    bg_norm 0xadd8e6
    bg_sel  0xffff00
    bg_hi   0xff0000
    fg_norm 0x000000
    fg_sel  0x008000
    fg_hi   0xffffff
    switch_off 0xc9c9c9
    switch_on 0x34c759
    switch_knob_off 0xf2f2f2
    switch_knob_on 0xffffff
    gridbox_bg 0xadd8e6
    gridbox_border 0x000000
    font_tiny     "Sans-9"
    font_small    "Sans-11"
    font_normal   "Sans-13"
    font_large    "Sans-20"
    font_heading2 "Sans-18"
    font_heading1 "Sans-24"
    borderwidth 0
    bordercolor 0x000000
    ; --- style-guide roles ---
    button_bg      0xcfe8f5
    button_fg      0x102030
    button_border  0x7fa8c0
    input_bg       0xffffff
    input_fg       0x102030
    input_border   0x7fa8c0
    accent         0x2f6fd0
    accent_fg      0xffffff
    list_bg        0xf7fbfe
    list_fg        0x102030
    list_sel_bg    0x2f6fd0
    list_sel_fg    0xffffff
    list_header_bg 0xd7e8f4
    list_header_fg 0x102030
    list_line      0xc8d8e4
    list_alt_bg    0xeef6fb
    font_ui        "Sans-13"
    window_margin  16
    control_height 24
    control_padding 6
    control_border 1
    control_gap    8
    group_gap      12
    action_gap     8
    list_row_height 22
    list_header_height 24
    list_cell_pad_x 8
    list_cell_pad_y 2
    icon_size      16
    bar_size       14
))

(theme highcontrast (
    bg_norm 0xffffff
    bg_sel  0x000000
    bg_hi   0x00eeee
    fg_norm 0x000000
    fg_sel  0xffffff
    fg_hi   0x000000
    switch_off 0x808080
    switch_on 0x00cc44
    switch_knob_off 0xf2f2f2
    switch_knob_on 0xffffff
    gridbox_bg 0xffffff
    gridbox_border 0x000000
    font_tiny     "Sans-9"
    font_small    "Sans-11"
    font_normal   "Sans-13"
    font_large    "Sans-20"
    font_heading2 "Sans-18"
    font_heading1 "Sans-24"
    borderwidth 0
    bordercolor 0x000000
    ; --- style-guide roles ---
    button_bg      0xffffff
    button_fg      0x000000
    button_border  0x000000
    input_bg       0xffffff
    input_fg       0x000000
    input_border   0x000000
    accent         0x000000
    accent_fg      0xffffff
    list_bg        0xffffff
    list_fg        0x000000
    list_sel_bg    0x000000
    list_sel_fg    0xffffff
    list_header_bg 0xffffff
    list_header_fg 0x000000
    list_line      0x000000
    list_alt_bg    0xf0f0f0
    font_ui        "Sans-13"
    window_margin  16
    control_height 24
    control_padding 6
    control_border 1
    control_gap    8
    group_gap      12
    action_gap     8
    list_row_height 22
    list_header_height 24
    list_cell_pad_x 8
    list_cell_pad_y 2
    icon_size      16
    bar_size       14
))

