; xtcw theme store (hdf s-expression format)
; (theme NAME (name value name value ...))
;   colour  := 0xRRGGBB
;   integer := decimal (e.g. borderwidth, 0 = no border)
;   string  := "..."   (double-quoted; spaces allowed, no escape sequences)
;              or a bare token (no whitespace/parens)
;
; "default" and "highcontrast" are production themes (borders off).
; "test" uses a thick, bright border so widget bounds are easy to see.
; "dracula" and "solarized_dark" are widely used, officially defined colour
; schemes used to test the widgets under realistic conditions.
;
; font_* are the default font faces/sizes; heading1 is larger than normal.

(theme default (
    bg_norm 0xadd8e6
    bg_sel  0xffff00
    bg_hi   0xff0000
    fg_norm 0x000000
    fg_sel  0x008000
    fg_hi   0xffffff
    switch_off 0xc9c9c9
    switch_on 0x34c759
    switch_knob_off 0xf2f2f2
    switch_knob_on 0xffffff
    gridbox_bg 0xadd8e6
    gridbox_border 0x000000
    font_tiny     "Sans-9"
    font_small    "Sans-11"
    font_normal   "Sans-13"
    font_large    "Sans-20"
    font_heading2 "Sans-18"
    font_heading1 "Sans-24"
    borderwidth 0
    bordercolor 0x000000
    ; --- style-guide roles ---
    button_bg      0xcfe8f5
    button_fg      0x102030
    button_border  0x7fa8c0
    input_bg       0xffffff
    input_fg       0x102030
    input_border   0x7fa8c0
    accent         0x2f6fd0
    accent_fg      0xffffff
    list_bg        0xf7fbfe
    list_fg        0x102030
    list_sel_bg    0x2f6fd0
    list_sel_fg    0xffffff
    list_header_bg 0xd7e8f4
    scrollbar_thumb 0xb8cddd
    list_header_fg 0x102030
    list_line      0xc8d8e4
    list_alt_bg    0xeef6fb
    font_ui        "Sans-13"
    window_margin  16
    control_height 24
    control_padding 6
    control_border 1
    control_gap    8
    group_gap      12
    action_gap     8
    list_row_height "16.5pt"
    list_header_height "18pt"
    list_cell_pad_x "6pt"
    list_cell_pad_y "3pt"
    icon_size      "12pt"
    bar_size       "10.5pt"
    ; --- widget surface roles ---
    menu_bg          0xd7e8f4
    menu_fg          0x102030
    menu_sel         0x2f6fd0
    menu_border      0xc8d8e4
    toolbar_bg       0xd7e8f4
    toolbar_fg       0x102030
    toolbar_border   0xc8d8e4
    status_bg        0xd7e8f4
    status_fg        0x000000
    status_border    0xc8d8e4
    tooltip_bg       0xd7e8f4
    tooltip_fg       0x000000
    tooltip_border   0xc8d8e4
    table_bg         0xf7fbfe
    table_fg         0x102030
    table_sel_bg     0x2f6fd0
    table_sel_fg     0xffffff
    table_header_bg  0xd7e8f4
    table_header_fg  0x102030
    table_alt_bg     0xeef6fb
    table_line       0xc8d8e4
    tree_bg          0xf7fbfe
    tree_fg          0x102030
    tree_sel_bg      0x2f6fd0
    tree_line        0xc8d8e4
    progress_bg      0xffffff
    progress_fill    0x2f6fd0
    progress_border  0xc8d8e4
    progress_fg      0x000000
    dialog_bg        0xf7fbfe
    dialog_border    0xc8d8e4
    menu_height      24
    toolbar_height   24
    status_height    24
    dialog_padding   12
    table_row_height "16.5pt"
    table_header_height "18pt"
    tree_indent      18
    tree_row_height  24
    progress_height  16
))

(theme highcontrast (
    bg_norm 0xffffff
