@class Wcheckbox (Wlabel)
@ Checkbox widget with toggle state

@PUBLIC
@var Boolean checked = False

@PRIVATE
@var int check_state

@METHODS 
@proc initialize
{
    $check_state = $checked ? 1 : 0;
    TRACE(2,"Wcheckbox:%s initialized, checked=%d", $name, $checked);
    /* Controls use the button_* colour roles and the shared UI font. */
    $useControlColors = True;
    wheel_colors_changed($);
}

@proc destroy
{
    if ($para_ptr) { retex_paragraph_free((RetexParagraph*)$para_ptr); $para_ptr = NULL; }
    if ($backend_ptr) {
        Backend *be = (Backend*)$backend_ptr;
        be->destroy(be);
        $backend_ptr = NULL;
    }
    XtFree($label_mem); $label_mem = NULL;
    theme_unregister($);
}

@TRANSLATIONS
@trans   <EnterWindow>: highlight()
@trans   <LeaveWindow>: reset()
@trans   <BtnDown>:     toggle()

@ACTIONS

@proc highlight
{
    if( $state == STATE_SELECTED ) return;
    $state = STATE_SELECTED;
    redraw_label($);
}

@proc reset
{
    if( $state == STATE_NORMAL ) return;
    $state = STATE_NORMAL;
    redraw_label($);
}

@proc toggle
{
    $check_state = $check_state ? 0 : 1;
    $checked = ($check_state == 1);
    redraw_label($);
    XtCallCallbackList( $, $callback, event );
}

@EXPORTS
@proc Boolean wcheckbox_is_checked($)
{
    return ($check_state == 1);
}

@IMPORTS
@incl "mls.h"
@incl <X11/Xft/Xft.h>
@incl "converters-xft.h"
@incl "theme.h"
@incl "retex.h"
@incl "backend.h"
