@class WlistMulti (Wheel)

@ simple multi-column list widget with wheel support and optional re-tex rendering

@exports

@proc void wlist_multi_gotoxy(Widget w, int x, int y)
{
  WlistMultiWidgetClass wc = (WlistMultiWidgetClass)XtClass(w);
  if( XtIsSubclass( w, wlistMultiWidgetClass) && wc->wlistMulti_class.gotoxy )
    {
      wc->wlistMulti_class.gotoxy(w,x,y);
    }
}

@proc void wlist_multi_update_line(Widget w, int line)
{
  WlistMultiWidgetClass wc = (WlistMultiWidgetClass)XtClass(w);
  if( XtIsSubclass( w, wlistMultiWidgetClass) && wc->wlistMulti_class.update_line )
    {
      wc->wlistMulti_class.update_line(w,line);
    }
}

@proc void wlist_multi_set_line_state( Widget w, int lineno, wheel_colors col )
{
  if( XtIsSubclass(w, wlistMultiWidgetClass) )
      set_line_state(  w, lineno, col );
}

@proc void wlist_multi_clear_selection( Widget w )
{
  if( XtIsSubclass(w, wlistMultiWidgetClass) )
      clear_selection(  w );
}


@proc void wlist_multi_update_all($)
{
	init_graphics($);
	update_pixmap_complete($);
	$expose($,0,0);
}

@public
@ mstringlist
@var int tableStrs = 0
@var <XftColor> XftColor fg = <String> "White"
@var <Callback> XtCallbackList notify   = NULL
@var <Callback> XtCallbackList getEntry = NULL
@var <Callback> XtCallbackList updatecb = NULL
@var <Int> int line_distance = 2
@var int top_x = 0
@var int top_y = 0

@var int prefered_width   = 0
@var int prefered_height  = 0
@var int visible_lines    = 3

@var ArrayInt columnWidths = 0
@var Boolean retexCells = False
@var String fontFace = "Sans"
@var int fontSize = 22

@ Die Anzahl Texzeilen pro Feld
        @var int multiline = 1

@ Die Nummer der ersten sichtbaren Zeile 
        @var int first_line = 0

@ Die Anzahl der anzuzeigenden Zeilen

        @var int line_max = 0

@ die Höhe einer Zeile in Pixel

        @var int line_height = 0

@ die Höhe des sichtbaren Bereichs der Liste in Pixel

        @var int list_height = 0

@var int line_width = 0

@var ArrayInt tabs = 0

@ Falls |unit| ==0 wird die breite des Buchstaben "w" angebommen
        @var Distance unit = 0

@var int line_bh = 0
@var ArrayChar titleBar = 0
@var Pixel titleBarCol = <String> "#101010"
@var int key_cursor = -1
@def relgc(var) = do if( var ) { XtReleaseGC($, var ); var=0; } while(0)

@translations
@trans <Btn1Motion>: motion_start()
@trans <Btn1Up>: motion_end()
@trans <EnterWindow>: highlight()
@trans <LeaveWindow>: reset()

@private
@def AUTO_SCROLL_TIME_MS = 200
@def PREFETCH_BUFFER   = 4
@var void *backend
@var int key_cursor_drawn
@var int key_cursor_state
@var int titleBarHeight
@var int titleBarWidth
@var GC gc_copy
@var Pixmap pixmap
@var rect32_t buf
@var XftDraw *draw
@var XftDraw *draw_title
@var Display *dpy
@var int line_state
@var ulong drag_time
@var ulong drag_update
@var int   drag_line_start
@var int   drag_start_y
@var int   drag_last_y
@var XtIntervalId autoscroll_id
@var int pixel_to_scroll
@var int autoscroll_cnt
@var int tab_pos
@var GC titleBarGC
@actions



@proc highlight
{
  if( $state == STATE_NORMAL ) {
    $state = STATE_SELECTED;
    update_widget_state($);
  }
}

@proc reset
{
  if( $state != STATE_NORMAL ) {
    $state = STATE_NORMAL;
    update_widget_state($);
  }
}


@proc motion_start
{
	int y = event->xbutton.y;
	int lineno;
	ulong t = (ulong ) event->xbutton.time;
	lineno = translate_ypos_to_lineno($,y );
	if( $drag_time == 0 ) goto restart_drag;

	/* drag startete vor über einer sekunde, seitdem keine änderung */
	/* darum: vergessen und neu starten */
	if( $drag_update + 1000 < t ) goto restart_drag;
	$drag_update = t;

	if( y != $drag_last_y ) {
	    int top = $top_y + ($drag_last_y - y);
	    $drag_last_y = y;
	    gotoxy( $, -1, top );
	}
	return; /* drag in progress */

  restart_drag:
	$drag_start_y = event->xbutton.y;
	$drag_last_y = event->xbutton.y;
	$drag_time = t;
	$drag_update = t;
	$drag_line_start = lineno;
}

@proc motion_end
{
      int y = event->xbutton.y;
      ulong t = (ulong ) event->xbutton.time;
      int lineno = translate_ypos_to_lineno($,event->xbutton.y );

      if( $drag_time == 0 || t < $drag_time ) goto click;

      t -= $drag_time;
      y -= $drag_start_y;
      if( y > -15 && y < 15 ) goto click;

      goto reset_drag;

      /* kein drag nur ein click */
click:
      XtCallCallbackList($, $notify, (XtPointer) (intptr_t)lineno );
      toggle_line_state( $, lineno );

reset_drag:
      $drag_time = 0;
}

@proc toggle_line_state_act
{
	int lineno = translate_ypos_to_lineno($,event->xbutton.y );
	toggle_line_state( $, lineno );
}


@ Der |select| Action-Handler wertet auswählen eines Eintrags der Liste aus
er muss anhand der Koordinaten das Listen-Element finden auf Highlight setzen
ist schon ein anderes element ausgewählt wird dies wieder abgewählt
zusätzlich wird der |notify| Handler aufgerufen.

@proc select_line
{
	int lineno = translate_ypos_to_lineno($,event->xbutton.y );
	XtCallCallbackList($,$notify,(XtPointer)(intptr_t)lineno);
}


@methods
@proc query_geometry
{
	calc_geometry($);
    reply->request_mode = CWX | CWY | CWWidth | CWHeight;
    reply->x=0; reply->y=0;
    reply->width =  $prefered_width;
    reply->height = $prefered_height;

    TRACE(1, "Wlist:%s: parent request is: %dx%d", XtName($),
             request->width,
             request->width );

    TRACE(1, "Wlist:%s: our prefered size is %dx%d", XtName($),
                  $prefered_width,
                  $prefered_height );

    return XtGeometryAlmost;
}



@ up, down usw. usf.
@proc exec_command
{
  switch( cmd ) {
  case WHEEL_FIRE:
    if( $state == STATE_ARMED ) {
      $state = STATE_SELECTED;
      $key_cursor = -1;
    }
    else {
      $state = STATE_ARMED;
      $key_cursor = $top_y / $line_height;
    }
    update_widget_state($);
    update_cursor($);
    return 1;

  case WHEEL_LEFT:
    if( $state != STATE_ARMED ) return 0;
    if( $key_cursor > 0 )
      $key_cursor--;
    update_cursor($);
    return 1;

  case WHEEL_RIGHT:
    if( $state != STATE_ARMED ) return 0;
    $key_cursor++;
    update_cursor($);
    return 1;
  }

  return 0; /* not used */
}


@ die |gotoxy| Funktion stellt die Liste ab Pixel Pos (x,y) im Fenster dar.

@proc gotoxy( $, int x, int y)
{
	if( x >= 0 ) $top_x = x;
	if( y >= 0 ) $top_y = y;
	TRACE(9, "%d %d", $top_x, $top_y );
	update_list($);
}

@ die |make_visible| Funktion stellt sicher,
 das die Zeile mit der Nummer |line_number| sichtbar wird.

@proc make_visible( $, int line_number )
{
  /* falls line_number im Cache -- redraw */

  /* setze buf.y so dass line_number am ende des cache liegt */
  /* setze top_y so dass letzte cache zeile angezeigt werden kann */
}

@ die |update_line| Funktion stellt sicher,
 das die Zeile mit der Nummer |line_number| aktuell und sichtbar ist.
 Algo: solange die liste nicht das fenster ausfüllt
 ($line_max < $height / $line_height)
 Zeile line_number in den Cache schreiben und expose() aufrufen
   Ansonsten:
  Falls die Zeile im Cache liegt, cache aktualisieren.

@proc update_line( $, int line_number )
{
  int y;

  if( ! $draw ) return;
  update_line_state($);
  y = line_number * $line_height;
  /* inside cache ? */
  if( y >= $buf.y && y < $buf.height + $buf.y ) {
    $draw_line($, line_number);
    /* visible ? */
    if( y >= $top_y && y < $top_y + $height ) {
      $expose( $, NULL, NULL );
      return;
    }
    /* not visible, but inside cache, move top_y */
  }

  /* outside cache! move top_y */
  $top_y = y - $height + $line_height;
  $expose( $, NULL, NULL );
}

@proc draw_line( $, int line_number )
{
  int y = line_number * $line_height;
  /* outside  cache ? */
  if( y < $buf.y || y >= $buf.height + $buf.y ) return;
  y = line_number - ($buf.y / $line_height); /* pos. im cache */
  print_pixmap( $, line_number, y );
}

@proc initialize
{
        /* TODO: dpy initialisierung in andere wlist widgets uebertragen */
        $dpy = XtDisplay($);

  if( $multiline == 0 ) $multiline = 1;
  $backend = NULL;
  $gc_copy =  XtGetGC($, 0,0 );
  $draw = NULL;
  
  /* Ensure xftFont matches fontSize/fontFace */
  char font_buf[128];
  snprintf(font_buf, sizeof(font_buf), "%s-%d", $fontFace, $fontSize);
  $xftFont = XftFontOpenName($dpy, DefaultScreen($dpy), font_buf);
  if (!$xftFont) {
      $xftFont = XftFontOpenName($dpy, DefaultScreen($dpy), "Sans-22");
  }

  /* trennlinie ist 2 pixel hoch */
  $line_height = ($xftFont ? $xftFont->height : 22) * $multiline + $line_distance + 2;
  $line_state = m_create(100,1);
  

  update_tabs($);
  if( $titleBar ) {
      $titleBarHeight = ($xftFont ? $xftFont->height : 22) + 3;
      $titleBarWidth = tabbed_str_width($dpy, $tab_pos, $xftFont, m_buf($titleBar));
   }
   else {
     $titleBarHeight = 1;
     $titleBarWidth  = 20;
   }

  if( $width == 0 ) $width = $titleBarWidth;
  $line_width = $width;

  $key_cursor_drawn = -1;

  XtGCMask mask;
  XGCValues values;
  mask = GCForeground;
  values.foreground = $titleBarCol;
  $titleBarGC = XtGetGC($,mask,&values);

  if( $height == 0 ) $height = 20;
}

@proc destroy
{
  XtReleaseGC($,$titleBarGC);
  XtReleaseGC($,$gc_copy);
  if( $draw) XftDrawDestroy( $draw );
  if ($backend) {
      Backend *be = (Backend*)$backend;
      be->destroy(be);
      $backend = NULL;
      $pixmap = 0; /* backend freed it */
  }
  if( $pixmap ) XFreePixmap( $dpy, $pixmap );
  if( $titleBar ) { m_free( $titleBar ); $titleBar=0; }
  m_free( $tab_pos );
  m_free( $tabs);
  m_free( $line_state );
}

@proc realize
 {
     XtCreateWindow($, (unsigned int) InputOutput,
                    (Visual *) CopyFromParent, *mask, attributes);
     $draw_title = XftDrawCreate( $dpy, XtWindow($),
                                  DefaultVisual($dpy, DefaultScreen($dpy)), None);

     init_graphics($);
     update_pixmap_complete($);
 }

@proc expose
{
	if( !XtIsRealized($)) return;
        if( $titleBar ) update_titlebar($);
        int h = (int)$height - (int)$titleBarHeight;
        $list_height = (Dimension)Max(h, 1);
        update_list($);
}



@proc class_initialize
{
	  converters_init();
}

@ todo: diese funktion muss umbedingt getestet werden

@proc resize
{
	/* der buffer sollte immer 3 zeilen größer als das window sein */
	if( XtIsRealized($) )
	  if( $height + 3 * $line_height > $buf.height || $width > $buf.width )
	  {
	 	init_graphics($);
		update_pixmap_complete($);
	  }
}

@proc set_values
{
	int n = *num_args;
    int font_changed = 0;

	TRACE(2, "Wlist Widget %s", XtName($) );

	/* wenn farben, font, zeilen-daten geändert worden sind,
           muss der cache aktualisiert werden
         */

	 while( n-- )
	 {
                 if(strncmp( args[n].name, "tableS",6 ) == 0 )
                 {
                   clear_selection($);
                   update_pixmap_complete($);
                   break;
                 }

                 if( ( strncmp( args[n].name, "bg_",3 ) == 0 )
		     || ( strncmp( args[n].name, "fg", 2 ) == 0 )
		     || ( strncmp( args[n].name, "xftFont", 7 ) == 0 ) )
                  {
			update_pixmap_complete($);
			break;
		  }
          
          if (strncmp(args[n].name, "fontSize", 8) == 0 ||
              strncmp(args[n].name, "fontFace", 8) == 0) {
              font_changed = 1;
          }
	 }

    if (font_changed) {
        char font_buf[128];
        snprintf(font_buf, sizeof(font_buf), "%s-%d", $fontFace, $fontSize);
        XftFont *nf = XftFontOpenName($dpy, DefaultScreen($dpy), font_buf);
        if (nf) {
            if ($xftFont) XftFontClose($dpy, $xftFont);
            $xftFont = nf;
            $line_height = $xftFont->height * $multiline + $line_distance + 2;
            init_graphics($);
            update_pixmap_complete($);
        }
    }

	return True; /* im zweifelsfall ist ein expose() immer richtig */
}



@utilities

@proc double get_dpi($)
{
    Display *dpy = XtDisplay($);
    char *s = XGetDefault(dpy, "Xft", "dpi");
    if (s) {
        double dpi = atof(s);
        if (dpi < 1.0 || dpi > 1000.0) return 96.0;
        return dpi;
    }
    return 96.0;
}

@proc uint32_t xftcolor_to_argb($, int index)
{
    XftColor *xc = &$xft_col[index];
    /* XftColor stores as 16-bit values (0-65535), need 8-bit (0-255) */
    uint32_t r = xc->color.red >> 8;
    uint32_t g = xc->color.green >> 8;
    uint32_t b = xc->color.blue >> 8;
    uint32_t a = xc->color.alpha >> 8;
    /* Alpha is often 0 in X11 - if so, assume fully opaque */
    if (a == 0) a = 0xFF;
    return (a << 24) | (r << 16) | (g << 8) | b;
}

@proc double pt2px($, double pt)
{
    return pt * get_dpi($) / 72.0;
}

@proc double px2pt($, double px)
{
    return px * 72.0 / get_dpi($);
}

@proc calc_geometry($)
{
	if( $visible_lines > 0 )
	{
		$prefered_height = $visible_lines * $line_height;	
        }

	if( $titleBarWidth > 0 )
	{
		$prefered_width = $titleBarWidth;
	}

	if( $prefered_height < 10 ) $prefered_height = 200;
	if( $prefered_width  < 10 ) $prefered_width  = 50;
}


@ den Puffer um |n| Zeilen nach oben kopieren
@proc scroll_up_lines($, int n)
{
  int dst_y = 0;
  int src_y = n * $line_height;
  int h = $buf.height - src_y;
  assert( h > 0 );
  XCopyArea(XtDisplay($),$pixmap, $pixmap, $gc_copy,
            0, src_y,
            $line_width, h,
            0, dst_y );
}

@ den Puffer um |n| Zeilen nach unten kopieren

@proc scroll_down_lines($, int n)
{
  int src_y = 0;
  int dst_y = n * $line_height;
  int h = $buf.height - dst_y;
  assert( h > 0 );
  XCopyArea($dpy,$pixmap, $pixmap, $gc_copy,
            0, src_y,
            $line_width, h,
            0, dst_y );
}


@proc String get_line_intern( $, int line )
{
      $line_max = m_len($tableStrs);
      TRACE(2, "WlistMulti:%s get_line_intern line=%d line_max=%d", XtName($), line, $line_max);
      m_setlen( $line_state, $line_max );
      if( m_len($tableStrs) <= line ) return "";
      return STR($tableStrs,line);
}


@ Zeile |line| als String holen und zurückgeben.
  |getEntry| callback benutzen
  |line_state| buffer aktualisieren
  |line_max| aktualisieren
@proc String get_line_str($, int line)
{
  if( $tableStrs ) {
      return get_line_intern( $, line );
  }

  wlist_entry_t ent;
  ent.pos = line; ent.max=0; ent.state = $line_state; ent.data="";
  XtCallCallbackList( $, $getEntry, &ent );
  if( ent.max != m_len($line_state) )
    m_setlen( $line_state, ent.max );
  $line_max = m_len($line_state);
  return ent.data;
}

@proc update_line_state($)
{
  get_line_str($,0);
}



@proc render_multiline($, int tabs,
                       XftDraw *draw, XftColor *col, XftFont *font,
                       int x, int y, char *s )
{
  int m_list = m_create(10, sizeof(char*));
  s_split(m_list, s, '\n', 0 );
  int p;
  char **str;
  m_foreach( m_list, p, str ) {
             render_mstr($,tabs,draw,col,font,x,y + $xftFont->ascent,*str);
             y += $xftFont->height;
  }
  m_free_strings(m_list, 1);
  m_free(m_list);
}

@proc render_retex_row($, int x, int y, int h, char *s, int col_idx_wheel)
{
    int columns = m_create(10, sizeof(char*));
    s_split(columns, s, '\t', 0);
    int p;
    char **cell_text;
    int cur_x = x;
    int col_idx = 0;
    Backend *be = (Backend*)$backend;

    if (!be) return;
    be->set_color(be, xftcolor_to_argb($, col_idx_wheel));

    /* Calculate scaling factor if widget is wider than sum of columnWidths */
    double scale = 1.0;
    int total_fixed_w = 0;
    if ($columnWidths > 0) {
        for(int i=0; i<m_len($columnWidths); i++) total_fixed_w += INT($columnWidths, i);
        if (total_fixed_w > 0 && $width > total_fixed_w) {
            scale = (double)$width / total_fixed_w;
        }
    }

    m_foreach(columns, p, cell_text) {
        int cell_w_px = 100;
        if ($columnWidths > 0 && col_idx < m_len($columnWidths)) {
            cell_w_px = (int)(INT($columnWidths, col_idx) * scale);
        }
        
        if (*cell_text && **cell_text) {
            double cell_w_pt = px2pt($, cell_w_px);
            double cell_h_pt = px2pt($, h);
            
            /* Apply cell-level clipping for retex */
            be->set_clip(be, px2pt($, cur_x), px2pt($, y), cell_w_pt, cell_h_pt, 1);

            /* Wrap in \hbox to prevent any wrapping/linebreaking within the cell */
            int hbox_handle = s_printf(0, 0, "\\hbox{%s}", *cell_text);
            RetexParagraph *para = retex_layout(be, m_str(hbox_handle), 100000.0, $fontFace, $fontSize, 0);
            m_free(hbox_handle);

            if (para) {
                double cell_h_pt = px2pt($, h);
                
                /* Get actual retex metrics for proper vertical centering */
                double retex_height = retex_paragraph_get_height(para);
                double retex_first_h = retex_paragraph_get_first_line_height(para);
                
                /* Calculate centering offset using retex's actual metrics */
                double y_off_pt = (cell_h_pt - retex_height) / 2.0;
                if (y_off_pt < 0) y_off_pt = 0;

                double cur_x_pt = px2pt($, cur_x);
                double cur_y_pt = px2pt($, y);
                
                /* Calculate target baseline: cell top + offset to center + retex first line height */
                double target_baseline_pt = cur_y_pt + y_off_pt + retex_first_h;
                
                /* Renderer expects baseline coordinates. Pass target_baseline_pt directly.
                 * Use col_idx_wheel (the line's color state) instead of $state (widget state)
                 * to ensure text colors match the background fill color from print_pixmap.
                 */
                RendererColors colors = {
                    .text = xftcolor_to_argb($, COLOR_FG_NORM + col_idx_wheel),
                    .bg = 0,
                    .reverse_text = xftcolor_to_argb($, COLOR_BG_HI + col_idx_wheel),
                    .reverse_bg = xftcolor_to_argb($, COLOR_FG_HI + col_idx_wheel),
                    .sel_text = xftcolor_to_argb($, COLOR_FG_SEL + col_idx_wheel),
                    .sel_bg = xftcolor_to_argb($, COLOR_BG_SEL + col_idx_wheel)
                };

                retex_paragraph_render(para, be, cur_x_pt, target_baseline_pt, &colors, 0);
                retex_paragraph_free(para);
            }
            
            /* Clear clipping */
            be->set_clip(be, 0, 0, 0, 0, 0);
        }
        cur_x += cell_w_px;
        col_idx++;
    }
    m_free_strings(columns, 1);
    m_free(columns);
}

@proc print_pixmap( $, int line, int ypos )
{
  uint col;
  char *s = NULL;
  int x,y,w,h;

  if( line < 0 || line >= $line_max )
    return;


  s = get_line_str($,line);
  if( line >= m_len($line_state) ) col=0;
  else
    col = UCHAR( $line_state, line);

  if( col > 2 ) col=0;

  TRACE(2,"line %d color %d\n",line, col);

  x=0;
  y=ypos * $line_height;
  w=$buf.width;
  h=$line_height;

  /* zeile zeichnen: Rect( x,y, w,h ) Inhalt: s, Farbe: gc */
  /*  XFillRectangle($dpy, $pixmap, $gc[col], x,y,w,h ); */
  if ($pixmap) {
      XFillRectangle($dpy, $pixmap, $gc[col], x,y,w,h );
  }

  if ($retexCells && $backend) {
      render_retex_row($, x, y, h, s, col);
  } else if ($draw) {
      render_multiline($, $tab_pos, $draw, $xft_col+col, $xftFont,
                      x, y + $line_distance/2, s);
  }

  if ($pixmap) {
      /* Use gc[0] (normal background) for subtle separator lines instead of gc[1] (yellow) */
      XDrawLine($dpy, $pixmap, $gc[0], x,y + h -2, w, y+h-2 );
  }
  TRACE(2, "Update Line: %d\n", line );
}

@proc print($, int x, int y, char *s)
{
  if ($draw && s && *s )
    XftDrawStringUtf8($draw, $xft_col+0, $xftFont, x,y, (FcChar8*)s,strlen(s) );
}

@ erzeuge die pixmap für den Puffer und initialisiere xftDraw
@proc init_graphics($)
{
  if( $line_width < $width ) $line_width = $width;

  /* berechnen der puffer Größe: 4-Zeilen größer als das fenster */
  int height;
  int h_px = (int)$height;
  if (h_px < 1) h_px = 1;
  height = (int)((h_px / $line_height) + PREFETCH_BUFFER) * $line_height;
  $buf.height = height;
  $buf.width  = $line_width;
  $buf.x = 0;
  $buf.y = 0;
  $first_line=0;

  if ($backend) {
      Backend *be = (Backend*)$backend;
      be->destroy(be);
      $backend = NULL;
      $pixmap = 0;
  }
  if( $pixmap ) XFreePixmap( $dpy, $pixmap );
  
  /* Cap buffer dimensions to 4000 to avoid X11 limitations */
  if ($buf.width > 4000) $buf.width = 4000;
  if ($buf.height > 4000) $buf.height = 4000;
  if ($buf.width < 1) $buf.width = 1;
  if ($buf.height < 1) $buf.height = 1;
  
  /* Also constrain widget width to match buffer width to avoid rendering mismatches */
  if ($width > $buf.width) $width = $buf.width;

  $backend = backend_xpixmap_create($dpy, XtWindow($), $buf.width, $buf.height);
  if ($backend) {
      $pixmap = backend_xpixmap_get_pixmap((Backend*)$backend);
  } else {
      $pixmap = XCreatePixmap($dpy, XtWindow($), $buf.width, $buf.height,
                         DefaultDepth($dpy, DefaultScreen($dpy)));
  }

  if( $draw) XftDrawDestroy( $draw );
  if ($pixmap) {
      $draw = XftDrawCreate($dpy, $pixmap,
                           DefaultVisual($dpy, DefaultScreen($dpy)), None);
  }
}

@proc update_pixmap_complete($)
{
	int i = 0;
	int line_no = $buf.y / $line_height;
	int max = $buf.height / $line_height;

	update_line_state($); // check line_max

	if( line_no + max -1 >= $line_max ) {
	    max = ($line_max - line_no);
	    int h = $buf.height - max * $line_height;
	    int w = $buf.width;
	    if ($pixmap) {
	        XFillRectangle( $dpy, $pixmap, $gc[0],
	    		    0, max * $line_height, w, h );
	    }
	}

	while( i< max ) {
	       print_pixmap( $, line_no+i, i );
	       i++;
	}
}

@ |update_cache| stellt fest ob der gewünschte anzuzeigende
@ bereich (top_x,top_y,width,height) im cache vorhanden ist.
@ falls nicht wird der cache aktualisiert

@proc update_cache($)
{
  int ln_pos, ln_no, buf_a, buf_h, cur_buf_a, buf_d, list_h;
  update_line_state($); // check line_max
  list_h = $line_max * $line_height;
  /* top_y, top_x korrigieren */
  /* falls der x-offset zu groß ist, verkleinern */
  if( $top_x &&  ($top_x + (int)$width > $line_width) ) {
    if( (int)$width < $line_width ) $top_x = $line_width - (int)$width;
    else 	     		   $top_x = 0;
  }
  /* falls die liste vollständig angezeigt werden kann, */
  /* falls die liste vollständig angezeigt werden kann, */
  /* oder der rest der liste das fenster nicht füllt */
  if( $top_y + (int)$list_height > list_h ) {
    if( (int)$list_height >= list_h ) $top_y = 0;
    else                    $top_y = list_h - (int)$list_height;
  }

  /* anzuzeigender bereich liegt im puffer */
  if( $top_y + (int)$height <= $buf.y + $buf.height &&
      $top_y >= $buf.y ) return;

  buf_h = $buf.height / $line_height;	/* anzahl zeilen im Puffer */
  cur_buf_a = $buf.y / $line_height;	/* erste zeile */
  buf_a = $top_y / $line_height;        /* neue erste zeile */
  buf_d = buf_a - cur_buf_a;		/* abstand in zeilen */
  $first_line = cur_buf_a;  
  if( buf_d == 0 ) goto update_all;

  if( buf_d > 0 ) {	/* neue erste zeile > puffer erste zeile */
    if( buf_d >= buf_h ) goto update_all;
    scroll_up_lines($, buf_d );
    ln_pos = buf_h - buf_d;
    ln_no = cur_buf_a + buf_h;  /* letzte zeile +1*/
  }
  else {                  /* neue erste zeile < puffer erste zeile */
    buf_d = -buf_d;
    if( buf_d >= buf_h ) goto update_all;

	    if( buf_d < PREFETCH_BUFFER ) {
	    	if( buf_a > PREFETCH_BUFFER - buf_d ) {
		    buf_a -= PREFETCH_BUFFER - buf_d;
		    buf_d = PREFETCH_BUFFER;
		} else {
		    buf_d += buf_a;
		    buf_a = 0;
		}
	    }

	    scroll_down_lines($, buf_d );
	    ln_pos = 0; ln_no = buf_a;
	}

	while( buf_d-- ) {
      	    print_pixmap($, ln_no + buf_d, ln_pos + buf_d );
    	}

	$buf.y = buf_a * $line_height; /* neue startposition setzen */
	$first_line = buf_a;
	return;
	/*-----------------------------------------------------------------*/

	update_all:
	$buf.y = buf_a * $line_height;
	$first_line = buf_a;
	update_pixmap_complete($);
	/*-----------------------------------------------------------------*/
}

@proc int translate_ypos_to_lineno($, int y )
{
  int line_no;
  y -= $titleBarHeight;
  line_no = ($top_y + y) / $line_height;
  if( line_no >= $line_max ) line_no = $line_max - 1;
  if( line_no < 0 ) line_no = 0;
  return line_no;
}


@proc autoscroll_cb(XtPointer client_data, XtIntervalId *id)
{
	Widget self = (Widget) client_data;

	int new_y = $top_y + $pixel_to_scroll;

	if( new_y > 0 && new_y + (int)$height < $line_max * $line_height && $autoscroll_cnt > 0 )
	{
		$autoscroll_id =
	  	   XtAppAddTimeOut( XtWidgetToApplicationContext( self ), 100, autoscroll_cb, self );
		$autoscroll_cnt--;
		gotoxy( $, -1, new_y );
	}
}

@proc void start_autoscroll( $, int y, ulong t )
{
	$autoscroll_cnt  =  25;
	float speed = fabs( ($drag_start_y - y) * 1.0 / t );
	float pixel_total = ($drag_start_y - y) / speed;
	float pixel_per_update = 1+ pixel_total / $autoscroll_cnt;
	TRACE(2, "drag_y0:%d, y1:%d", $drag_start_y, y );
	TRACE(2, "autoscroll started: speed:%f, pixel_total:%f", speed, pixel_total );

	$pixel_to_scroll =  pixel_per_update;

	$autoscroll_id = XtAppAddTimeOut( XtWidgetToApplicationContext( $ ), 40, autoscroll_cb, $ );
}

@proc void set_line_state( $, int lineno, wheel_colors col )
{
	if( lineno < 0 || lineno >= m_len($line_state) ) return;

	CHAR($line_state, lineno) = col;
	/* check screen update */
	int first_line = $buf.y / $line_height;
	int last_line = first_line + $buf.height / $line_height;
	if( lineno >= first_line && lineno < last_line ) {
	    print_pixmap( $, lineno, lineno - first_line );
	    update_list($);
	}
}

@proc void toggle_line_state( $, int lineno )
{
  if( lineno < 0 || lineno >= m_len($line_state) ) return;
  wheel_colors col = CHAR( $line_state, lineno );
  col = !col;
  set_line_state( $, lineno, col );
}

@ aus der Liste |tabs| und der eingestellten |unit|
  die Offsets der Tab-Stops berechnen und in
  der Liste |tab_pos| speichern.
@proc update_tabs($)
{
  if( ! $tabs ) return;
  int mult = $unit;
  if( mult == 0 ) mult = xft_textwidth( $dpy, $xftFont, "w" );
  if( $tab_pos )
    m_clear($tab_pos);
  else $tab_pos = m_create(10,sizeof(int));

  int p,*d, v;
  m_foreach( $tabs, p, d ) {
    v = (*d) * mult;
    m_put( $tab_pos, &v );
  }
}

@proc int tabbed_str_width(Display *dpy, int tabs, XftFont *font, char *buf )
{
  char **str;
  int p,
      cur_x = 0,
      cur_tab = 0;
  int m_list = m_create(10, sizeof(char*));
  s_split(m_list, buf, '\t', 1 );
  int last_substr = m_len(m_list) > 0 ? m_len(m_list)-1 : 0;

  m_foreach( m_list, p, str ) {
    cur_x +=  xft_textwidth( dpy, font, *str );

    if( p != last_substr && tabs ) {
        while( cur_tab < m_len(tabs) ) {
           if( INT(tabs,cur_tab) > cur_x )
           {
              cur_x = INT(tabs,cur_tab);
              break;
           }
           cur_tab++; /* skip this tab */
        }
    }
  }
  m_free_strings(m_list, 1);
  m_free(m_list);
  return cur_x;
}


@proc int render_substr($, XftDraw *draw, XftColor *col, XftFont *font,
                        int x,int y, char *s)
{
  int xoff;
  if(is_empty(s) ) return 0;

  xoff = xft_textwidth( $dpy, font, s );
  XftDrawStringUtf8(draw, col, font,
                    x,y, (FcChar8*)s,strlen(s) );
  return xoff;
}


@proc render_mstr($, int tabs, XftDraw *draw, XftColor *col, XftFont *font, int pix_x, int pix_y, char* buf)
{
  if( is_empty(buf) ) return;

  int cur_tab = 0; /* index des nächsten tab */
  int xoff;        /* größe des teil-str. in pixel */
  int cur_x = 0;   /* x-pos. des nächsten str. in pixel */
  int m_list = m_create(10, sizeof(char*));
  s_split(m_list, buf, '\t', 0 );
  int p;
  char **str;

  /* Calculate scaling factor if widget is wider than sum of columnWidths */
  double scale = 1.0;
  int total_fixed_w = 0;
  if ($columnWidths > 0) {
      for(int i=0; i<m_len($columnWidths); i++) total_fixed_w += INT($columnWidths, i);
      if (total_fixed_w > 0 && $width > total_fixed_w) {
          scale = (double)$width / total_fixed_w;
      }
  }

  m_foreach( m_list, p, str ) {
    if( cur_x >= $buf.width ) break;
    
    int cell_w = 100;
    if ($columnWidths > 0 && p < m_len($columnWidths)) {
        cell_w = (int)(INT($columnWidths, p) * scale);
    }

    /* Apply per-cell clipping for Xft */
    XRectangle clip;
    clip.x = pix_x + cur_x; clip.y = pix_y - font->ascent; clip.width = cell_w; clip.height = font->height;
    XftDrawSetClipRectangles(draw, 0, 0, &clip, 1);

    xoff = render_substr($, draw,col,font, pix_x + cur_x, pix_y, *str);
    cur_x += cell_w;

    if( tabs ) {
        while( cur_tab < m_len(tabs) ) {
           if( INT(tabs,cur_tab) > cur_x )
           {
              cur_x = INT(tabs,cur_tab);
              break;
           }
           cur_tab++; /* skip this tab */
        }
    }
  }
  
  /* Reset clipping */
  XftDrawSetClip(draw, None);

  m_free_strings(m_list, 1);
  m_free(m_list);
}

@proc update_widget_state($)
{
  if( $state >= STATE_MAX ) $state=0;
  XSetWindowBorder( $dpy, XtWindow($),
                        $pixel[$state + COLOR_FG_MAX] );
}

@proc update_titlebar($)
{

  uint y = $titleBarHeight;
  if ($draw_title) {
      XFillRectangle( $dpy,XtWindow($),$titleBarGC, 0,0,$width,y);
      XDrawLine( $dpy,XtWindow($),$gc[1],0,y-2,$width, y-2 );
      render_mstr( $, $tab_pos, $draw_title, $xft_col, $xftFont,
                   0, $xftFont->ascent, m_buf($titleBar) );
  }
}


@proc int is_cached($, int lineno)
{
  int first_line = $buf.y / $line_height;
  int last_line = first_line + $buf.height / $line_height;
  return( lineno >= first_line && lineno < last_line );
}

@proc int redraw_line( $, int lineno )
{
  int first_line = $buf.y / $line_height;
  int last_line = first_line + $buf.height / $line_height;
  if( lineno >= first_line && lineno < last_line ) {
    print_pixmap( $, lineno, lineno - first_line );
    return 1;
  }
  return 0;
}

@proc update_cursor($)
{
  int dirty = 0;
  if( $key_cursor == $key_cursor_drawn ) return;

  if( $key_cursor_drawn >= 0 ) {
    CHAR( $line_state, $key_cursor_drawn ) = $key_cursor_state;
    dirty += redraw_line($,$key_cursor_drawn);
    $key_cursor_drawn=-1;
  }

  if( $key_cursor >= 0 ) {

    if( $key_cursor >= m_len($line_state) )
      $key_cursor = m_len($line_state)-1;

    $key_cursor_state = CHAR( $line_state, $key_cursor );
    CHAR($line_state, $key_cursor) = STATE_ARMED;
    $key_cursor_drawn = $key_cursor;
    redraw_line($,$key_cursor);
    dirty = 1;
    int last_visible_line = ($top_y + (int)$list_height) / $line_height;
    TRACE(2, "crsr:%d Vis:%d", $key_cursor, last_visible_line );

    if( $key_cursor >= last_visible_line ) {
      int y=($key_cursor+1) * $line_height - (int)$list_height;
      $gotoxy($,-1,y); dirty=0;
    }
    else if( $key_cursor < ($top_y / $line_height) )
      {
        $gotoxy($,-1,$key_cursor*$line_height); dirty=0;
      }
  }

  if( dirty ) update_list($);
}

@proc clear_selection($)
{
        int len = m_len($line_state);
        while( len-- ) CHAR($line_state,len)=0;
}


@proc update_list($)
{
  uint bx = 1;
  uint by = $titleBarHeight;
  update_cache($);
  if ($pixmap) {
      int copy_w = $width - 2*bx;
      int copy_h = $height - by;
      if (copy_w > $buf.width) copy_w = $buf.width;
      if (copy_h > $buf.height) copy_h = $buf.height;
      XCopyArea($dpy,$pixmap,XtWindow($), $gc_copy,
                $top_x, $top_y - $buf.y, copy_w, copy_h,
    	    bx, by );
  }

  XtCallCallbackList( $, $updatecb, NULL );
}


@imports
@incl <assert.h>
@incl <math.h>
@incl <X11/Xft/Xft.h>
@incl "retex.h"
@incl "backend_xpixmap.h"
@incl "xutil.h"
@incl "Wlist-common.h"
@incl "mls.h"
@incl "converters.h"
