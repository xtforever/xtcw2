@ Wlabel renders text using re-tex engine (replacing Xft)
@class Wlabel (Wheel)

@CLASSVARS
@var XtEnum compress_exposure = TRUE

@PUBLIC
@var String label = <String> NULL
@var String fontFace = "Sans"
@var int fontSize = 12
@var int cornerRoundPercent = 0
@var int leftOffsetPercent = 5
@var int update = 0
@var int alignment = 0

@PRIVATE
@var void *backend
@var void *para
@var Pixmap pixmap
@var int prefered_width
@var int prefered_height
@var Bool dirty
@var String label_mem

@METHODS

@proc initialize
{
  char *s = $label;
  if( ! s || ! *s ) s=$name;
  $label_mem = XtNewString(s);
  $label = $label_mem;

  $backend = NULL;
  $para = NULL;
  $pixmap = 0;
  $dirty = 1;
  $prefered_width = 100; 
  $prefered_height = 20;

  // Initial measurement
  calculate_size($, &$prefered_width, &$prefered_height);
  if ($width == 0) $width = $prefered_width;
  if ($height == 0) $height = $prefered_height;
}

@proc destroy
{
    if ($para) {
        retex_paragraph_free($para);
        $para = NULL;
    }
    if ($backend) {
        Backend *be = (Backend*)$backend;
        be->destroy(be);
        $backend = NULL;
    }
    XtFree($label_mem);
}

@proc set_values
{
    int do_expose = 0;
    int redraw_flag = 0;

    if ($label != $old$label) {
        XtFree($old$label_mem);
        if ($label == 0) $label = "";
        $label = $label_mem = XtNewString($label);
        redraw_flag = 1;
    }

    if ($fontFace != $old$fontFace || $fontSize != $old$fontSize) {
        redraw_flag = 1;
    }

    if ($update != $old$update) {
    if ($alignment != $old$alignment) { redraw_flag = 1; }
        redraw_flag = 1;
    }

    if (redraw_flag) {
        $dirty = 1;
        calculate_size($, &$prefered_width, &$prefered_height);
        do_expose = 1;
    }

    return do_expose;
}

@proc query_geometry
{
    int w, h;
    calculate_size($, &w, &h);

    reply->request_mode = CWX | CWY | CWWidth | CWHeight;
    reply->x = 0; reply->y = 0;
    reply->width = w;
    reply->height = h;

    return XtGeometryAlmost;
}

@proc resize
{
    // On resize, we need to recreate the backend because pixmap size changes
    if ($backend) {
        Backend *be = (Backend*)$backend;
        be->destroy(be);
        $backend = NULL;
        $pixmap = 0;
    }
    $dirty = 1;
    if (XtIsRealized($)) reshape_widget($);
}

@proc expose
{
    redraw_label($);
}

@proc redraw_label($)
{
    if (!XtIsRealized($)) return;
    
    if ($dirty || !$backend) {
        update_cache($);
        $dirty = 0;
    }

    if ($pixmap) {
        XCopyArea(XtDisplay($), $pixmap, XtWindow($), 
                  DefaultGC(XtDisplay($), DefaultScreen(XtDisplay($))),
                  0, 0, $width, $height, 0, 0);
    }
}

@proc update_cache($)
{
    if (!$backend) {
        $backend = backend_xpixmap_create(XtDisplay($), XtWindow($), $width, $height);
        if (!$backend) return;
        $pixmap = backend_xpixmap_get_pixmap($backend);
    }

    if ($para) {
        retex_paragraph_free($para);
        $para = NULL;
    }

    Backend *be = (Backend*)$backend;
    
    /* Layout */
    double layout_width = ($width > 0) ? $width : 10000.0;
    $para = retex_layout(be, $label, layout_width, $fontFace, $fontSize, $alignment);
    
    /* Clear background (backend_xpixmap creates white bg, but we might want to clear if reusing?) */
    be->draw_rect(be, 0, 0, $width, $height, 0xFFFFFFFF); /* White */

    /* Render centered */
    double text_h = retex_paragraph_get_height($para);
    double text_w = retex_paragraph_get_width($para);
    
    /* Center logic */
    double x = ($width - text_w) / 2.0;
    double y = ($height - text_h) / 2.0;
    if (x < 0) x = 0;
    if (y < 0) y = 0;

    retex_paragraph_render($para, be, x, y);
}

@UTILITIES

@proc calculate_size($, int *w, int *h)
{
    /* Measure without creating full backend if possible? */
    /* retex_layout needs a backend for font metrics. */
    /* create a dummy 1x1 backend */
    Display *dpy = XtDisplay($);
    Window root = DefaultRootWindow(dpy);
    
    Backend *be = backend_xpixmap_create(dpy, root, 10, 10);
    if (!be) { *w=10; *h=10; return; }
    
    /* Use a large width to check natural width (single line) */
    /* Let's assume infinite width for preferred size (no wrapping) */
    double target_width = ($width > 0) ? $width : 10000.0;
    RetexParagraph *p = retex_layout(be, $label, target_width, $fontFace, $fontSize, $alignment);
    
    if (p) {
        *w = ($width > 0) ? $width : (int)retex_paragraph_get_width(p) + 4; /* margin */
        *h = (int)retex_paragraph_get_height(p) + 4;
        retex_paragraph_free(p);
    } else {
        *w = 50; *h = 20;
    }
    
    be->destroy(be);
}

@proc reshape_widget($)
{
	int w;
	if( $cornerRoundPercent >0 && $cornerRoundPercent < 100 ) {
	    w = Min($height,$width);
	    w = w * $cornerRoundPercent / 100;
	    XmuReshapeWidget( $, XmuShapeRoundedRectangle, w, w );
	}
}

@IMPORTS
@incl "retex.h"
@incl "backend_xpixmap.h"
@incl "mls.h"
@incl <X11/Xmu/Converters.h>
@incl <X11/Xft/Xft.h>