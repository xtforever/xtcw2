@ Wlabel renders text using re-tex engine (replacing Xft)
@class Wlabel (Wheel)

@CLASSVARS
@var XtEnum compress_exposure = TRUE

@PUBLIC
@ a simple string. but double newlines define paragraphs
@var String label = <String> NULL
@ freetype font name
@var String fontFace = "Sans"
@ default size
@var int fontSize = 12
@var int topGap = 0
@var int bottomGap = 0
@var int leftGap = 0
@var int rightGap = 0
@var Boolean autoHeight = FALSE
@var int cornerRoundPercent = 0
@var int leftOffsetPercent = 5
@var int update = 0
@ use 3 for right-justified
@var int alignment = 0

@PRIVATE
@var void *backend
@var void *para
@var Pixmap pixmap
@var int prefered_width
@var int prefered_height
@var Bool dirty
@var String label_mem
@var int last_state

@METHODS

@proc class_initialize
{
    converters_init();
    m_init();
    conststr_init();
}

@proc initialize
{
  char *s = $label;
  if( ! s || ! *s ) s=$name;
  $label_mem = XtNewString(s);
  $label = $label_mem;

  $backend = NULL;
  $para = NULL;
  $pixmap = 0;
  $dirty = 1;
  $last_state = -1;
  $prefered_width = 100; 
  $prefered_height = 20;

  // Initial measurement
  calculate_size($, 0, &$prefered_width, &$prefered_height);
  if ($width == 0) $width = $prefered_width;
  if ($height == 0) $height = $prefered_height;
}

@proc destroy
{
    if ($para) {
        retex_paragraph_free($para);
        $para = NULL;
    }
    if ($backend) {
        Backend *be = (Backend*)$backend;
        be->destroy(be);
        $backend = NULL;
    }
    XtFree($label_mem);
}

@proc set_values
{
    int do_expose = 0;
    int redraw_flag = 0;

    if ($label != $old$label) {
        XtFree($old$label_mem);
        if ($label == 0) $label = "";
        $label = $label_mem = XtNewString($label);
        redraw_flag = 1;
    }

    if ($fontFace != $old$fontFace || $fontSize != $old$fontSize) {
        redraw_flag = 1;
    }

    if ($update != $old$update) {
    if ($alignment != $old$alignment) { redraw_flag = 1; }
        redraw_flag = 1;
    }

    if ($fg_norm != $old$fg_norm || $bg_norm != $old$bg_norm ||
        $fg_sel != $old$fg_sel || $bg_sel != $old$bg_sel ||
        $fg_hi != $old$fg_hi || $bg_hi != $old$bg_hi ||
        $state != $old$state || 
        $topGap != $old$topGap || $bottomGap != $old$bottomGap ||
        $leftGap != $old$leftGap || $rightGap != $old$rightGap ) {
        redraw_flag = 1;
    }

    if (redraw_flag) {
        $dirty = 1;
        calculate_size($, $width, &$prefered_width, &$prefered_height);
        do_expose = 1;
    }

    return do_expose;
}

@proc query_geometry
{
    int tw = (request->request_mode & CWWidth) ? request->width : $width;
    int w, h;
    calculate_size($, tw, &w, &h);

    reply->request_mode = CWWidth | CWHeight;
    reply->width = w;
    reply->height = h;

    return XtGeometryAlmost;
}

@proc resize
{
    // On resize, we need to recreate the backend because pixmap size changes
    if ($backend) {
        Backend *be = (Backend*)$backend;
        be->destroy(be);
        $backend = NULL;
        $pixmap = 0;
    }
    $dirty = 1;
    if (XtIsRealized($)) reshape_widget($);
}

@proc expose
{
    redraw_label($);
}

@proc redraw_label($)
{
    if (!XtIsRealized($)) return;
    
    /* state might have changed without set_values (e.g. from actions) */
    /* but if state changed, we MUST redraw. */
    if( $state != $last_state ) { $dirty = 1; $last_state = $state; }

    if ($dirty || !$backend) {
        update_cache($);
        $dirty = 0;
    }

    if ($pixmap) {
        XCopyArea(XtDisplay($), $pixmap, XtWindow($), 
                  $gc[0],
                  0, 0, $width, $height, 0, 0);
    }
}

@proc update_cache($)
{
    if (!$backend) {
        if (!XtIsRealized($)) return;
        $backend = backend_xpixmap_create(XtDisplay($), XtWindow($), $width, $height);
        if (!$backend) return;
        $pixmap = backend_xpixmap_get_pixmap($backend);
    }

    if ($para) {
        retex_paragraph_free($para);
        $para = NULL;
    }

    Backend *be = (Backend*)$backend;
    
    /* Calculate available width for layout after gaps */
    int avail_w = (int)$width - ($leftGap + $rightGap);
    if (avail_w < 10) avail_w = 10;
    double layout_width_pt = px2pt($, avail_w);

    $para = retex_layout(be, $label, layout_width_pt, $fontFace, $fontSize, $alignment);
    if (!$para) return;

    /* Clear background */
    be->draw_rect(be, 0, 0, px2pt($, $width), px2pt($, $height), xftcolor_to_argb($, COLOR_BG_NORM + $state));

    /* Render centered in the available area defined by gaps */
    double text_h_px = pt2px($, retex_paragraph_get_height($para));
    double text_w_px = pt2px($, retex_paragraph_get_width($para));
    
    double avail_h_px = (double)$height - ($topGap + $bottomGap);
    double avail_w_px = (double)$width - ($leftGap + $rightGap);
    if (avail_h_px < 1.0) avail_h_px = 1.0;
    if (avail_w_px < 1.0) avail_w_px = 1.0;

    /* Centering offset (in pixels) within the available gap-adjusted area */
    double v_off_px = (avail_h_px - text_h_px) / 2.0;
    double h_off_px = (avail_w_px - text_w_px) / 2.0;
    if (v_off_px < 0) v_off_px = 0;
    if (h_off_px < 0) h_off_px = 0;

    /* re-tex renderer expects y to be the baseline of the first line (in points). */
    double x_pt = px2pt($, (double)$leftGap + h_off_px);
    double y_pt = px2pt($, (double)$topGap + v_off_px) + retex_paragraph_get_first_line_height($para);

    TRACE(2, "Wlabel %s: h=%d, text_h_px=%.1f, topGap=%d, v_off_px=%.1f, y_pt=%.1f\n", 
          $name, $height, text_h_px, $topGap, v_off_px, y_pt);

    be->set_color(be, xftcolor_to_argb($, COLOR_FG_NORM + $state));
    retex_paragraph_render($para, be, x_pt, y_pt);
}

@UTILITIES

@proc uint32_t xftcolor_to_argb($, int index)
{
    XftColor *xc = &$xft_col[index];
    uint32_t r = xc->color.red >> 8;
    uint32_t g = xc->color.green >> 8;
    uint32_t b = xc->color.blue >> 8;
    uint32_t a = xc->color.alpha >> 8;
    return (a << 24) | (r << 16) | (g << 8) | b;
}

@proc double get_dpi($)
{
    Display *dpy = XtDisplay($);
    char *s = XGetDefault(dpy, "Xft", "dpi");
    if (s) {
        double dpi = atof(s);
        if (dpi < 1.0 || dpi > 1000.0) return 96.0;
        return dpi;
    }
    return 96.0;
}

@proc double pt2px($, double pt)
{
    return pt * get_dpi($) / 72.0;
}

@proc double px2pt($, double px)
{
    return px * 72.0 / get_dpi($);
}

@proc calculate_size($, int tw, int *w, int *h)
{
    Display *dpy = XtDisplay($);
    Window root = DefaultRootWindow(dpy);
    
    Backend *be = backend_xpixmap_create(dpy, root, 10, 10);
    if (!be) { *w=10; *h=10; return; }
    
    /* Use current gaps for measurement */
    int adj_tw = (tw > 0) ? (tw - ($leftGap + $rightGap)) : 10000;
    if (adj_tw < 10) adj_tw = 10;
    double target_width_pt = px2pt($, adj_tw);

    RetexParagraph *p = retex_layout(be, $label, target_width_pt, $fontFace, $fontSize, $alignment);
    
    if (p) {
        if (tw > 0) {
            *w = tw;
        } else {
            *w = (int)pt2px($, retex_paragraph_get_width(p)) + $leftGap + $rightGap;
        }
        double h_px = pt2px($, retex_paragraph_get_height(p)) + $topGap + $bottomGap;
        
        /* If not autoHeight, respect explicitly set height if larger */
        if (!$autoHeight && $height > h_px) h_px = $height;

        /* SAFETY: Cap pixel height to prevent XCreatePixmap BadAlloc (max 4000px) */
        if (h_px > 4000) h_px = 4000;
        *h = (int)h_px;
        retex_paragraph_free(p);
    } else {
        *w = 50 + $leftGap + $rightGap;
        *h = 20 + $topGap + $bottomGap;
    }
    
    be->destroy(be);
}

@proc reshape_widget($)
{
	int w;
	if( $cornerRoundPercent >0 && $cornerRoundPercent < 100 ) {
	    w = Min($height,$width);
	    w = w * $cornerRoundPercent / 100;
	    XmuReshapeWidget( $, XmuShapeRoundedRectangle, w, w );
	}
}

@IMPORTS
@incl "retex.h"
@incl "backend_xpixmap.h"
@incl "mls.h"
@incl "conststr.h"
@incl "converters.h"
@incl <X11/Xmu/Converters.h>
@incl <X11/Xft/Xft.h>