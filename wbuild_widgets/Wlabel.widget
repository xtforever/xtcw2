@ Wlabel renders text using re-tex engine (replacing Xft)
@class Wlabel (Wheel)

@CLASSVARS
@var XtEnum compress_exposure = TRUE

@PUBLIC
@ a simple string. but double newlines define paragraphs
@var String label = <String> NULL
@ freetype font name
@var String fontFace = "Sans"
@ default size
@var int fontSize = 12
@var int topGap = 0
@var int bottomGap = 0
@var int leftGap = 0
@var int rightGap = 0
@var Boolean autoHeight = FALSE
@var int cornerRoundPercent = 0
@var int leftOffsetPercent = 5
@var int update = 0
@ 0=left, 1=center, 2=right, 3=justify
@var int alignment = 0
@var int selection_start = -1
@var int selection_end = -1

@PRIVATE
@var void *backend_ptr
@var void *para_ptr
@var Pixmap pixmap
@var int prefered_width
@var int prefered_height
@var Bool dirty
@var String label_mem
@var double layout_x_offset_pt
@var double layout_y_offset_pt
@var int last_state

@METHODS

@proc class_initialize
{
    converters_init();
    m_init();
    conststr_init();
}

@proc initialize
{
  char *s = $label;
  if( ! s || ! *s ) s=$name;
  $label_mem = XtNewString(s);
  $label = $label_mem;

  $backend_ptr = NULL;
  $para_ptr = NULL;
  $pixmap = 0;
  $dirty = 1;
  $last_state = -1;
  $prefered_width = 100; 
  $prefered_height = 20;

  // Initial measurement
  calculate_size($, 0, &$prefered_width, &$prefered_height);
  if ($width == 0) $width = $prefered_width;
  if ($height == 0) $height = $prefered_height;

  $dirty = 1;
  TRACE(2, "LAYOUT handle %p, class %s, name %s, width %d, height %d, x %d, y %d, color %08x, content %s", 
        $, "Wlabel", $name, (int)$width, (int)$height, (int)$x, (int)$y, 0, $label);
}

@proc destroy
{
    if ($para_ptr) {
        retex_paragraph_free($para_ptr);
        $para_ptr = NULL;
    }
    if ($backend_ptr) {
        Backend *be = (Backend*)$backend_ptr;
        be->destroy(be);
        $backend_ptr = NULL;
    }
    XtFree($label_mem);
}

@proc set_values
{
    int do_expose = 0;
    int redraw_flag = 0;
    int size_changed = 0;

    if ($label != $old$label) {
        XtFree($old$label_mem);
        if ($label == 0) $label = "";
        $label = $label_mem = XtNewString($label);
        redraw_flag = 1;
        size_changed = 1;
    }

    if ($fontFace != $old$fontFace || $fontSize != $old$fontSize) {
        redraw_flag = 1;
        size_changed = 1;
    }

    if ($alignment != $old$alignment) { redraw_flag = 1; size_changed = 1; }

    if ($topGap != $old$topGap || $bottomGap != $old$bottomGap ||
        $leftGap != $old$leftGap || $rightGap != $old$rightGap ) {
        redraw_flag = 1;
        size_changed = 1;
    }

    if ($update != $old$update) {
        redraw_flag = 1;
    }

    if ($fg_norm != $old$fg_norm || $bg_norm != $old$bg_norm ||
        $fg_sel != $old$fg_sel || $bg_sel != $old$bg_sel ||
        $fg_hi != $old$fg_hi || $bg_hi != $old$bg_hi ||
        $state != $old$state ||
        $selection_start != $old$selection_start ||
        $selection_end != $old$selection_end ) {
        redraw_flag = 1;
    }

    if (redraw_flag) {
        $dirty = 1;
        do_expose = 1;
        if (XtIsRealized($)) update_cache($);
    }

    if (size_changed && $autoHeight) {
        int w, h;
        calculate_size($, 0, &w, &h);
        if (w != $width || h != $height) {
             XtVaSetValues($, XtNwidth, (Dimension)w, XtNheight, (Dimension)h, NULL);
        }
    }

    if (redraw_flag || size_changed) {
        TRACE(2, "LAYOUT handle %p, class %s, name %s, width %d, height %d, x %d, y %d, color %08x, content %s", 
              $, "Wlabel", $name, (int)$width, (int)$height, (int)$x, (int)$y, 0, $label);
    }

    return do_expose;
}

@proc query_geometry
{
    int tw = (request->request_mode & CWWidth) ? request->width : 0;
    int w, h;
    calculate_size($, tw, &w, &h);

    reply->request_mode = CWWidth | CWHeight;
    reply->width = w;
    reply->height = h;

    $prefered_width = w;
    $prefered_height = h;

    return XtGeometryAlmost;
}

@proc resize
{
    // On resize, we need to recreate the backend because pixmap size changes
    if ($backend_ptr) {
        Backend *be = (Backend*)$backend_ptr;
        be->destroy(be);
        $backend_ptr = NULL;
        $pixmap = 0;
    }
    $dirty = 1;
    if (XtIsRealized($)) reshape_widget($);
}

@proc expose
{
    redraw_label($);
}

@proc redraw_label($)
{
    if (!XtIsRealized($)) return;
    
    if ($state != $last_state) { $dirty = 1; $last_state = $state; }

    if ($dirty || !$backend_ptr) {
        update_cache($);
        $dirty = 0;
    }

    if ($pixmap) {
        XClearWindow(XtDisplay($), XtWindow($));
        XCopyArea(XtDisplay($), $pixmap, XtWindow($), 
                  $gc[0],
                  0, 0, $width, $height, 0, 0);
    }
}

@proc update_cache($)
{
    if (!$backend_ptr) {
        if (!XtIsRealized($)) return;
        $backend_ptr = backend_xpixmap_create(XtDisplay($), XtWindow($), $width, $height);
        if (!$backend_ptr) return;
        $pixmap = backend_xpixmap_get_pixmap((Backend*)$backend_ptr);
    }

    if ($para_ptr) {
        retex_paragraph_free($para_ptr);
        $para_ptr = NULL;
    }

    Backend *be = (Backend*)$backend_ptr;
    
    int inner_w_px = (int)$width - ($leftGap + $rightGap);
    if (inner_w_px < 10) inner_w_px = 10;
    double layout_width_pt = px2pt($, inner_w_px);

    $para_ptr = retex_layout(be, $label, layout_width_pt, $fontFace, $fontSize, $alignment);
    if (!$para_ptr) return;

    /* Clear background - use widget dimensions in points */
    be->draw_rect(be, 0, 0, px2pt($, $width), px2pt($, $height), xftcolor_to_argb($, COLOR_BG_NORM + $state));

    double text_h_pt = retex_paragraph_get_height($para_ptr);
    double text_w_pt = retex_paragraph_get_width($para_ptr);
    
    double inner_h_pt = px2pt($, (double)$height - ($topGap + $bottomGap));
    if (inner_h_pt < 0) inner_h_pt = 0;

    double v_centering_offset_pt = (inner_h_pt - text_h_pt) / 2.0;
    if (v_centering_offset_pt < 0) v_centering_offset_pt = 0;

    double h_centering_offset_pt = (px2pt($, inner_w_px) - text_w_pt) / 2.0;
    if (h_centering_offset_pt < 0) h_centering_offset_pt = 0;

    /* re-tex renderer expects y to be the baseline of the first line (in points). */
    double x_pt = px2pt($, (double)$leftGap) + h_centering_offset_pt;
    double y_pt = px2pt($, (double)$topGap) + v_centering_offset_pt + retex_paragraph_get_first_line_height($para_ptr);

    $layout_x_offset_pt = x_pt;
    $layout_y_offset_pt = y_pt - retex_paragraph_get_first_line_height($para_ptr);

    TRACE(2, "update_cache: text_w=%.2f, text_h=%.2f, layout_x_off=%.2f, layout_y_off=%.2f", 
          text_w_pt, text_h_pt, $layout_x_offset_pt, $layout_y_offset_pt);

    be->set_color(be, xftcolor_to_argb($, COLOR_FG_NORM + $state));
    retex_paragraph_set_selection($para_ptr, $selection_start, $selection_end);
    retex_paragraph_render($para_ptr, be, x_pt, y_pt, xftcolor_to_argb($, COLOR_FG_NORM + $state));
}

@TRANSLATIONS
@trans <Btn1Down>: select_start()
@trans <Btn1Motion>: select_extend()
@trans <Btn1Up>: select_end()
@trans <Key>Return: info()

@ACTIONS
@proc info
{
    fprintf(stderr, "Wlabel info: %s, selection: %d to %d\n", $label, $selection_start, $selection_end);
}

@proc select_start
{
    int x = event->xbutton.x;
    int y = event->xbutton.y;
    double x_pt = px2pt($, x) - $layout_x_offset_pt;
    double y_pt = px2pt($, y) - $layout_y_offset_pt;
    
    TRACE(2, "clicked: x=%d, y=%d, x_pt=%.2f, y_pt=%.2f, layout_x_off=%.2f, layout_y_off=%.2f", 
          x, y, x_pt, y_pt, $layout_x_offset_pt, $layout_y_offset_pt);

    if (!$para_ptr) update_cache($);
    if ($para_ptr) {
        int idx = retex_paragraph_get_node_at($para_ptr, x_pt, y_pt);
        TRACE(2, "select_start: hit idx=%d", idx);
        if (idx != -1) {
            $selection_start = $selection_end = idx;
            $dirty = 1;
            redraw_label($);
            // Own PRIMARY selection
            XtOwnSelection($, XA_PRIMARY, event->xbutton.time, convert_selection, NULL, NULL);
        }
    }
}

@proc select_extend
{
    int x = event->xmotion.x;
    int y = event->xmotion.y;
    double x_pt = px2pt($, x) - $layout_x_offset_pt;
    double y_pt = px2pt($, y) - $layout_y_offset_pt;
    
    TRACE(2, "drag: x=%d, y=%d", x, y);

    if ($para_ptr) {
        int idx = retex_paragraph_get_node_at($para_ptr, x_pt, y_pt);
        if (idx != -1) {
            $selection_end = idx;
            $dirty = 1;
            redraw_label($);
        }
    }
}

@proc select_end
{
    int x = event->xbutton.x;
    int y = event->xbutton.y;
    TRACE(2, "released: x=%d, y=%d", x, y);
}

@UTILITIES

@proc Boolean convert_selection($, Atom *selection, Atom *target, Atom *type, XtPointer *value, unsigned long *length, int *format)
{
    if (*target == XA_STRING) {
        *type = XA_STRING;
        int s = ($selection_start < $selection_end) ? $selection_start : $selection_end;
        int e = ($selection_start < $selection_end) ? $selection_end : $selection_start;
        if (s < 0) return False;
        
        int len = strlen($label);
        if (s >= len) return False;
        if (e >= len) e = len - 1;
        
        int sel_len = e - s + 1;
        char *res = XtMalloc(sel_len + 1);
        strncpy(res, $label + s, sel_len);
        res[sel_len] = 0;
        
        *value = res;
        *length = sel_len;
        *format = 8;
        return True;
    }
    return False;
}

@proc uint32_t xftcolor_to_argb($, int index)
{
    XftColor *xc = &$xft_col[index];
    uint32_t r = (xc->color.red >> 8) & 0xFF;
    uint32_t g = (xc->color.green >> 8) & 0xFF;
    uint32_t b = (xc->color.blue >> 8) & 0xFF;
    uint32_t a = (xc->color.alpha >> 8) & 0xFF;
    return (a << 24) | (r << 16) | (g << 8) | b;
}

@proc double get_dpi($)
{
    Display *dpy = XtDisplay($);
    char *s = XGetDefault(dpy, "Xft", "dpi");
    if (s) {
        double dpi = atof(s);
        if (dpi < 1.0 || dpi > 1000.0) return 96.0;
        return dpi;
    }
    return 96.0;
}

@proc double pt2px($, double pt)
{
    return pt * get_dpi($) / 72.0;
}

@proc double px2pt($, double px)
{
    return px * 72.0 / get_dpi($);
}

@proc calculate_size($, int tw, int *w, int *h)
{
    Display *dpy = XtDisplay($);
    Window root = DefaultRootWindow(dpy);
    
    Backend *be = backend_xpixmap_create(dpy, root, 10, 10);
    if (!be) { *w=10; *h=10; return; }
    
    /* Calculate internal target width for retex (subtract horizontal gaps) */
    int adj_tw = (tw > 0) ? (tw - ($leftGap + $rightGap)) : 20000;
    if (adj_tw < 10) adj_tw = 10;
    double target_width_pt = px2pt($, adj_tw);

    RetexParagraph *p = retex_layout(be, $label, target_width_pt, $fontFace, $fontSize, $alignment);
    
    if (p) {
        /* Resulting width is either requested width or natural text width + gaps */
        if (tw > 0) {
            *w = tw;
        } else {
            *w = (int)ceil(pt2px($, retex_paragraph_get_width(p))) + $leftGap + $rightGap;
        }
        /* Resulting height is strictly text height + vertical gaps */
        *h = (int)ceil(pt2px($, retex_paragraph_get_height(p))) + $topGap + $bottomGap;
        
        retex_paragraph_free(p);
    } else {
        *w = 50 + $leftGap + $rightGap;
        *h = 20 + $topGap + $bottomGap;
    }
    
    be->destroy(be);
}

@proc reshape_widget($)
{
	int w;
	if( $cornerRoundPercent >0 && $cornerRoundPercent < 100 ) {
	    w = Min($height,$width);
	    w = w * $cornerRoundPercent / 100;
	    XmuReshapeWidget( $, XmuShapeRoundedRectangle, w, w );
	}
}

@IMPORTS
@incl <math.h>
@incl "retex.h"
@incl "backend_xpixmap.h"
@incl "mls.h"
@incl "conststr.h"
@incl "converters.h"
@incl <X11/Xmu/Converters.h>
@incl <X11/Xft/Xft.h>
@incl <X11/Xatom.h>
