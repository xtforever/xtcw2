@class Wbravo (Wheel)
@ A piece-table plain-text editor rendered with retex

@TRANSLATIONS
@trans <Key>Right:     forward_char()
@trans <Key>Left:      backward_char()
@trans <Key>Up:        move_up()
@trans <Key>Down:      move_down()
@trans <Key>Home:      move_home()
@trans <Key>End:       move_end()
@trans <Key>Prior:     page_up()
@trans <Key>Next:      page_down()
@trans <Key>Delete:    delete_forward()
@trans <Key>BackSpace: delete_backward()
@trans <Key>Return:    insert_newline()
@trans <Ctrl>z:        undo()
@trans <Ctrl>y:        redo()
@trans <Ctrl>c:        copy_selection()
@trans <Ctrl>x:        cut_selection()
@trans <Ctrl>v:        paste()
@trans <Ctrl>b:        bold()
@trans <Ctrl>i:        italic()
@trans <Ctrl>r:        roman()
@trans <Btn1Down>:     set_cursor() SetFocus()
@trans <Btn1Motion>:   extend_selection()
@trans <Key>:          insert_char()
@trans <FocusIn>:      focus_in()
@trans <FocusOut>:     focus_out()

@PUBLIC
@ UTF-8 document text
@var String text = <String> ""
@var String fontFace = "Sans"
@var int fontSize = 13
@ 0=left, 1=center, 2=right, 3=justify
@var int alignment = 0
@var int topGap = 4
@var int bottomGap = 4
@var int leftGap = 4
@var int rightGap = 4

@PRIVATE
@def COL_BG = 0
@def COL_FG = 1
@def COL_SELBG = 2
@def COL_SELFG = 3

@var void *ptable
@var void *backend_ptr
@var void *para_ptr
@var Pixmap pixmap
@var GC blit_gc
@var XftColor xcol[4]
@var String text_mem
@ Owned copy of $fontFace when the font name came from a loaded state file.
@var char *fontFace_mem
@var int caret_cp
@var int anchor_cp
@var int scroll_line
@var Bool dirty
@var int *undo_cp
@var int *undo_anchor
@var int undo_n
@var int undo_cap
@var int *redo_cp
@var int *redo_anchor
@var int redo_n
@var int redo_cap
@var char *sel_buf
@var int sel_len
@var char *out_buf
@var int out_cap
@var Atom utf8_atom
@var int last_width
@var int last_height
@ pending look applied to newly typed characters
@var RLook look
@ Per-paragraph formatting: one entry per blank-line separated paragraph.
@var void *para_fmt
@var int para_n
@var int para_cap
@ Paragraph starts captured before an edit, for remapping formats afterwards.
@var int *old_para_start
@var int old_para_n
@var int edit_old_len
@ Paragraph-format snapshots paired with the caret undo/redo stacks.
@var void *undo_para
@var int *undo_para_n
@var void *redo_para
@var int *redo_para_n

@METHODS

@proc class_initialize
{
    converters_init();
    m_init();
    conststr_init();
}

@proc initialize
{
    Display *dpy = XtDisplay($);

    $ptable = rtable_create();
    $backend_ptr = NULL;
    $para_ptr = NULL;
    $pixmap = 0;
    $blit_gc = 0;
    $caret_cp = 0;
    $anchor_cp = 0;
    $scroll_line = 0;
    $dirty = 1;
    $last_width = 0;
    $last_height = 0;

    $undo_cp = NULL; $undo_anchor = NULL; $undo_n = 0; $undo_cap = 0;
    $redo_cp = NULL; $redo_anchor = NULL; $redo_n = 0; $redo_cap = 0;
    $sel_buf = NULL; $sel_len = 0;
    $out_buf = NULL; $out_cap = 0;

    $para_fmt = NULL; $para_n = 0; $para_cap = 0;
    $old_para_start = NULL; $old_para_n = 0; $edit_old_len = 0;
    $undo_para = NULL; $undo_para_n = NULL;
    $redo_para = NULL; $redo_para_n = NULL;
    /* Xt borrows String resources; LUI passes Lua strings that may be
     * collected later.  Keep our own copy for relayout/open_font. */
    $fontFace_mem = strdup($fontFace ? $fontFace : "Sans");
    $fontFace = $fontFace_mem;

    $utf8_atom = XInternAtom(dpy, "UTF8_STRING", False);

    $text_mem = XtNewString($text ? $text : "");
    $text = $text_mem;

    alloc_colors($);
    load_text($);

    if ($width == 0) $width = 400;
    if ($height == 0) $height = 200;
}

@proc destroy
{
    if ($para_ptr) { retex_paragraph_free((RetexParagraph*)$para_ptr); $para_ptr = NULL; }
    if ($backend_ptr) {
        Backend *be = (Backend*)$backend_ptr;
        be->destroy(be);
        $backend_ptr = NULL;
    }
    if ($ptable) { rtable_free((RTable*)$ptable); $ptable = NULL; }

    free($undo_cp); free($undo_anchor);
    free($redo_cp); free($redo_anchor);
    free($sel_buf); free($out_buf);

    para_clear_history($);
    free($undo_para); free($undo_para_n);
    free($redo_para); free($redo_para_n);
    free($para_fmt);
    free($old_para_start);
    free($fontFace_mem);

    free_colors($);
    XtFree($text_mem);
}

@proc set_values
{
    int redraw_flag = 0;

    if ($text != $old$text) {
        XtFree($old$text_mem);
        $text = $text_mem = XtNewString($text ? $text : "");
        load_text($);
        redraw_flag = 1;
    }
    if ($fontFace != $old$fontFace || $fontSize != $old$fontSize ||
        $alignment != $old$alignment) {
        if ($fontFace != $old$fontFace) {
            free($fontFace_mem);
            $fontFace_mem = strdup($fontFace ? $fontFace : "Sans");
            $fontFace = $fontFace_mem;
        }
        if ($alignment != $old$alignment) {
            int i;
            for (i = 0; i < $para_n; i++)
                ((RetexParaFormat*)$para_fmt)[i].align = $alignment;
        }
        $dirty = 1;
        redraw_flag = 1;
    }
    if ($topGap != $old$topGap || $bottomGap != $old$bottomGap ||
        $leftGap != $old$leftGap || $rightGap != $old$rightGap) {
        $dirty = 1;
        redraw_flag = 1;
    }
    if (redraw_flag && XtIsRealized($))
        relayout($);
    return redraw_flag;
}

@proc get_values_hook
{
    int i;
    for (i = 0; i < *num_args; i++) {
        if (strcmp(args[i].name, "text") == 0) {
            *((char**)args[i].value) = get_text_buffer($);
            return;
        }
    }
}

@proc realize
{
    XtCreateWindow($, (unsigned int) InputOutput, (Visual *) CopyFromParent,
                   *mask, attributes);
    $dirty = 1;
    redraw($);
}

@proc resize
{
    $dirty = 1;
    redraw($);
}

@proc expose
{
    redraw($);
}

@proc accept_focus
{
    return True;
}

@proc set_values_almost
{
    request->width = reply->width;
    request->height = reply->height;
    request->request_mode = CWWidth | CWHeight;
    $dirty = 1;
}

@ override the Wheel theme hook: our $xcol[]/blit GC cache the colours
@proc void colors_changed
{
    #colors_changed($);
    free_colors($);
    alloc_colors($);
    $dirty = 1;
    if (XtIsRealized($)) redraw($);
}

@UTILITIES

@proc void alloc_colors($)
{
    XGCValues v;

    xft_color_alloc($, $bg_norm, $xcol + COL_BG);
    xft_color_alloc($, $fg_norm, $xcol + COL_FG);
    xft_color_alloc($, $bg_sel,  $xcol + COL_SELBG);
    xft_color_alloc($, $fg_sel,  $xcol + COL_SELFG);

    v.foreground = $bg_norm;
    v.graphics_exposures = False;
    $blit_gc = XtGetGC($, GCForeground | GCGraphicsExposures, &v);
}

@proc void free_colors($)
{
    Display *dpy = XtDisplay($);
    int i;
    for (i = 0; i < 4; i++)
        XftColorFree(dpy, DefaultVisual(dpy, DefaultScreen(dpy)), None, $xcol + i);
    if ($blit_gc) { XtReleaseGC($, $blit_gc); $blit_gc = 0; }
}

@proc uint32_t xftcolor_to_argb($, int index)
{
    XftColor *xc = &$xcol[index];
    uint32_t r = xc->color.red >> 8;
    uint32_t g = xc->color.green >> 8;
    uint32_t b = xc->color.blue >> 8;
    uint32_t a = xc->color.alpha >> 8;
    if (a == 0) a = 0xFF;
    return (a << 24) | (r << 16) | (g << 8) | b;
}

@proc double get_dpi($)
{
    Display *dpy = XtDisplay($);
    char *s = XGetDefault(dpy, "Xft", "dpi");
    if (s) {
        double dpi = atof(s);
        if (dpi < 1.0 || dpi > 1000.0) return 96.0;
        return dpi;
    }
    return 96.0;
}

@proc double pt2px($, double pt) { return pt * get_dpi($) / 72.0; }
@proc double px2pt($, double px) { return px * 72.0 / get_dpi($); }

@proc int make_utf8($)
{
    if (!$ptable) return 0;
    return rtable_to_utf8((RTable*)$ptable);
}

@proc char* get_text_buffer($)
{
    int h = make_utf8($);
    int len = h ? m_len(h) : 1;
    if (len > $out_cap) {
        char *nb = (char*)realloc($out_buf, len);
        if (!nb) return "";
        $out_buf = nb;
        $out_cap = len;
    }
    if (h) {
        memcpy($out_buf, m_buf(h), len);
        m_free(h);
    } else {
        $out_buf[0] = 0;
    }
    return $out_buf;
}

@proc int cp_to_byte($, int cp)
{
    int h = make_utf8($);
    int b;
    if (!h) return 0;
    b = utf8_cp_index_to_byte((char*)m_buf(h), cp);
    m_free(h);
    return b;
}

@proc int byte_to_cp($, int byte)
{
    int h = make_utf8($);
    int cp;
    if (!h) return 0;
    cp = utf8_byte_to_cp_index((char*)m_buf(h), byte);
    m_free(h);
    return cp;
}

@proc int doc_len($)
{
    if (!$ptable) return 0;
    return rtable_len((RTable*)$ptable);
}

@ the default look (the widget's base font) used when loading text.
@proc void get_look($, RLook *out)
{
    out->face = $fontFace ? conststr_lookup_c($fontFace) : 0;
    out->style = 0;
    out->size = (float)$fontSize;
}

@ paragraph formatting helpers

@proc RetexParaFormat* para_alloc_default($, int n)
{
    RetexParaFormat *f;
    int i;
    if (n < 1) n = 1;
    f = (RetexParaFormat*)calloc((size_t)n, sizeof(RetexParaFormat));
    if (!f) return NULL;
    for (i = 0; i < n; i++) f[i].align = $alignment;
    return f;
}

@ Free the undo/redo per-paragraph snapshots and reset the history depth.
@proc void para_clear_history($)
{
    int i;
    RetexParaFormat **up = (RetexParaFormat**)$undo_para;
    RetexParaFormat **rp = (RetexParaFormat**)$redo_para;
    if (up) {
        for (i = 0; i < $undo_n; i++) free(up[i]);
    }
    if (rp) {
        for (i = 0; i < $redo_n; i++) free(rp[i]);
    }
    $undo_n = 0;
    $redo_n = 0;
}

@ Allocate a copy of the current paragraph formats.  *n_out gets the count.
@proc RetexParaFormat* para_copy($, int *n_out)
{
    RetexParaFormat *c = NULL;
    int n = $para_n > 0 ? $para_n : 0;
    if (n > 0 && $para_fmt) {
        c = (RetexParaFormat*)malloc((size_t)n * sizeof(RetexParaFormat));
        if (c) memcpy(c, $para_fmt, (size_t)n * sizeof(RetexParaFormat));
    }
    if (n_out) *n_out = n;
    return c;
}

@ Rebuild the paragraph-format array from the current document.
@proc void para_init($)
{
    int *starts = NULL, n = 0;
    RetexParaFormat *f;
    para_compute($, &starts, &n);
    free(starts);
    if (n < 1) n = 1;
    free($para_fmt);
    f = para_alloc_default($, n);
    $para_fmt = f;
    $para_n = f ? n : 0;
    $para_cap = $para_n;
    free($old_para_start);
    $old_para_start = NULL;
    $old_para_n = 0;
}

@ Compute paragraph start atom offsets from the current document.
@proc void para_compute($, int **starts_out, int *n_out)
{
    RAtom *atoms;
    int natoms = 0, n;
    int *s = NULL;

    atoms = rtable_to_array((RTable*)$ptable, &natoms);
    n = retex_paragraphs(atoms, natoms, NULL, 0);
    if (n < 1) n = 1;
    s = (int*)malloc((size_t)n * sizeof(int));
    if (s) retex_paragraphs(atoms, natoms, s, n);
    free(atoms);
    *starts_out = s;
    *n_out = n;
}

@ Greatest paragraph index whose start is <= pos.
@proc int para_index_for_pos($, const int *starts, int n, int pos)
{
    int i, k = 0;
    if (!starts || n <= 0) return 0;
    for (i = 0; i < n; i++) {
        if (starts[i] <= pos) k = i;
        else break;
    }
    return k;
}

@ Parse an alignment action argument: 0..3 or left/center/right/justify.
@ Returns -1 for an unrecognised value.
@proc int parse_alignment($, const char *s)
{
    if (!s || !*s) return -1;
    if (s[0] >= '0' && s[0] <= '9') {
        int v = atoi(s);
        return (v >= 0 && v <= 3) ? v : -1;
    }
    if (strcmp(s, "left") == 0)    return RETEX_ALIGN_LEFT;
    if (strcmp(s, "center") == 0 ||
        strcmp(s, "centre") == 0)  return RETEX_ALIGN_CENTER;
    if (strcmp(s, "right") == 0)   return RETEX_ALIGN_RIGHT;
    if (strcmp(s, "justify") == 0) return RETEX_ALIGN_JUSTIFY;
    return -1;
}

@ Capture the paragraph starts before an edit (edit_begin).
@proc void para_snapshot($)
{
    int *s = NULL, n = 0;
    para_compute($, &s, &n);
    free($old_para_start);
    $old_para_start = s;
    $old_para_n = n;
}

@ Remap paragraph formats after a text edit of `delta` atoms at edit_pos.
@proc void para_resync($, int edit_pos, int delta)
{
    int *ns = NULL, nn = 0;
    int i, k;
    RetexParaFormat *nf;

    para_compute($, &ns, &nn);
    nf = (RetexParaFormat*)malloc((size_t)nn * sizeof(RetexParaFormat));
    if (nf) {
        for (i = 0; i < nn; i++) {
            int os = (ns[i] <= edit_pos) ? ns[i] : ns[i] - delta;
            RetexParaFormat base;
            memset(&base, 0, sizeof(base));
            base.align = $alignment;
            k = para_index_for_pos($, $old_para_start, $old_para_n, os);
            if (k >= $para_n) k = $para_n > 0 ? $para_n - 1 : 0;
            nf[i] = ($para_fmt && $para_n > 0) ? ((RetexParaFormat*)$para_fmt)[k] : base;
        }
    }
    free($para_fmt);
    $para_fmt = nf;
    $para_n = nf ? nn : 0;
    $para_cap = $para_n;
    free(ns);
    free($old_para_start);
    $old_para_start = NULL;
    $old_para_n = 0;
}

@ Paragraph range touched by the caret/selection.
@proc void para_selection($, int *p0, int *p1)
{
    int *starts = NULL, n = 0, lo, hi;

    para_compute($, &starts, &n);
    if ($caret_cp != $anchor_cp) {
        lo = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
        hi = $caret_cp < $anchor_cp ? $anchor_cp : $caret_cp;
        *p0 = para_index_for_pos($, starts, n, lo);
        *p1 = para_index_for_pos($, starts, n, hi > lo ? hi - 1 : lo);
    } else {
        *p0 = *p1 = para_index_for_pos($, starts, n, $caret_cp);
    }
    free(starts);
    if (*p0 < 0) *p0 = 0;
    if (*p1 < *p0) *p1 = *p0;
    if ($para_n > 0 && *p1 >= $para_n) *p1 = $para_n - 1;
}

@ Commit a paragraph-format change.
@proc void para_commit($)
{
    $dirty = 1;
    ensure_visible($);
    redraw($);
}

@ Assign one alignment to the paragraphs touched by the caret/selection.
@proc void para_set_align($, int align)
{
    int p0, p1, i;
    if ($para_n <= 0 || !$para_fmt) return;
    para_selection($, &p0, &p1);
    edit_begin($);
    for (i = p0; i <= p1 && i < $para_n; i++)
        ((RetexParaFormat*)$para_fmt)[i].align = align;
    para_commit($);
}

@ field: 1 = left indent, 2 = right indent, 3 = first-line indent.
@proc void para_add_indent($, int field, double delta)
{
    int p0, p1, i;
    double *v;
    if ($para_n <= 0 || !$para_fmt) return;
    para_selection($, &p0, &p1);
    edit_begin($);
    for (i = p0; i <= p1 && i < $para_n; i++) {
        switch (field) {
            case 2: v = &((RetexParaFormat*)$para_fmt)[i].indent_right; break;
            case 3: v = &((RetexParaFormat*)$para_fmt)[i].first_line; break;
            default: v = &((RetexParaFormat*)$para_fmt)[i].indent_left; break;
        }
        *v += delta;
        if (*v < 0.0) *v = 0.0;
    }
    para_commit($);
}

@ field: 1 = left indent, 2 = right indent, 3 = first-line indent.
@ Set an absolute indent (points) on the caret/selection paragraphs.
@proc void para_set_indent($, int field, double value)
{
    int p0, p1, i;
    double *v;
    if ($para_n <= 0 || !$para_fmt) return;
    if (value < 0.0) value = 0.0;
    para_selection($, &p0, &p1);
    edit_begin($);
    for (i = p0; i <= p1 && i < $para_n; i++) {
        switch (field) {
            case 2: v = &((RetexParaFormat*)$para_fmt)[i].indent_right; break;
            case 3: v = &((RetexParaFormat*)$para_fmt)[i].first_line; break;
            default: v = &((RetexParaFormat*)$para_fmt)[i].indent_left; break;
        }
        *v = value;
    }
    para_commit($);
}

@ Install a paragraph-format snapshot (takes ownership of p).
@proc void para_restore($, RetexParaFormat *p, int n)
{
    free($para_fmt);
    $para_fmt = p;
    $para_n = n;
    $para_cap = n;
    if (!$para_fmt || $para_n < 1) para_init($);
}

@ Set space before (where=0) or after (where=1) a paragraph, in points.
@proc void para_set_space($, int where, double value)
{
    int p0, p1, i;
    if ($para_n <= 0 || !$para_fmt) return;
    if (value < 0.0) value = 0.0;
    para_selection($, &p0, &p1);
    edit_begin($);
    for (i = p0; i <= p1 && i < $para_n; i++) {
        if (where) ((RetexParaFormat*)$para_fmt)[i].space_after = value;
        else ((RetexParaFormat*)$para_fmt)[i].space_before = value;
    }
    para_commit($);
}

@ Adopt the look of the character next to the caret so typing continues the run.
@proc void sync_look($)
{
    RAtom a;
    int len = $ptable ? rtable_len((RTable*)$ptable) : 0;
    int pos = $caret_cp;
    if (len <= 0) return;
    if (pos > 0) pos = pos - 1;
    if (pos >= len) pos = len - 1;
    if (rtable_get((RTable*)$ptable, pos, &a) && a.kind == RATOM_CHAR)
        $look = a.look;
}

@ Apply a style-bit change to the selection, or to the pending look (typing).
@proc void apply_style_bits($, int setb, int clrb)
{
    int lo, hi;
    if ($caret_cp != $anchor_cp) {
        lo = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
        hi = $caret_cp < $anchor_cp ? $anchor_cp : $caret_cp;
        edit_begin($);
        rtable_apply_style((RTable*)$ptable, lo, hi - lo, setb, clrb);
        $dirty = 1;
        ensure_visible($);
        redraw($);
        sync_look($);
    } else {
        $look.style = ($look.style & ~clrb) | setb;
    }
}

@ Toggle a style bit on the selection, or on the pending look.
@proc void toggle_style($, int bit)
{
    RAtom a;
    int on = 0, lo;
    if ($caret_cp != $anchor_cp) {
        lo = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
        if (rtable_get((RTable*)$ptable, lo, &a) && a.kind == RATOM_CHAR)
            on = a.look.style & bit;
        apply_style_bits($, on ? 0 : bit, on ? bit : 0);
    } else {
        $look.style ^= bit;
    }
}

@ Change the font face of the selection, or of the pending look.
@proc void apply_face($, int face)
{
    int lo, hi;
    if ($caret_cp != $anchor_cp) {
        lo = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
        hi = $caret_cp < $anchor_cp ? $anchor_cp : $caret_cp;
        edit_begin($);
        rtable_set_face((RTable*)$ptable, lo, hi - lo, face);
        $dirty = 1;
        ensure_visible($);
        redraw($);
        sync_look($);
    } else {
        $look.face = face;
    }
}

@ Change the font size of the selection, or of the pending look.
@proc void apply_size($, float size)
{
    int lo, hi;
    if ($caret_cp != $anchor_cp) {
        lo = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
        hi = $caret_cp < $anchor_cp ? $anchor_cp : $caret_cp;
        edit_begin($);
        rtable_set_size((RTable*)$ptable, lo, hi - lo, size);
        $dirty = 1;
        ensure_visible($);
        redraw($);
        sync_look($);
    } else {
        $look.size = size;
    }
}

@proc void load_text($)
{
    RLook lk;
    get_look($, &lk);
    $look = lk;
    if ($ptable) {
        rtable_load_plain((RTable*)$ptable, $text ? $text : "", lk);
    }
    $caret_cp = 0;
    $anchor_cp = 0;
    $scroll_line = 0;
    para_clear_history($);
    $undo_n = 0;
    $redo_n = 0;
    para_init($);
    $dirty = 1;
}

@proc double scroll_offset_pt($)
{
    RetexLine l;
    if ($para_ptr && $scroll_line > 0 &&
        retex_paragraph_get_line((RetexParagraph*)$para_ptr, $scroll_line, &l))
        return l.y;
    return 0.0;
}

@proc int caret_line($)
{
    sync_layout($);
    int byte, nl, i;
    RetexLine l;
    if (!$para_ptr) return 0;
    byte = cp_to_byte($, $caret_cp);
    nl = retex_paragraph_get_line_count((RetexParagraph*)$para_ptr);
    for (i = 0; i < nl; i++) {
        if (retex_paragraph_get_line((RetexParagraph*)$para_ptr, i, &l) &&
            byte <= l.end_byte)
            return i;
    }
    return nl > 0 ? nl - 1 : 0;
}

@proc void sync_layout($)
{
    if ($dirty && XtIsRealized($) && XtWindow($))
        update_cache($);
}

@proc void relayout($)
{
    int wpx, natoms;
    RAtom *atoms;

    if (!$backend_ptr) return;
    if ($para_ptr) {
        retex_paragraph_free((RetexParagraph*)$para_ptr);
        $para_ptr = NULL;
    }
    wpx = (int)$width - ($leftGap + $rightGap);
    if (wpx < 10) wpx = 10;
    if (!$para_fmt || $para_n < 1) para_init($);
    atoms = rtable_to_array((RTable*)$ptable, &natoms);
    $para_ptr = retex_layout_styled_paras((Backend*)$backend_ptr, atoms, natoms,
                                          px2pt($, wpx), $fontFace, $fontSize,
                                          $para_fmt, $para_n,
                                          (RetexAlign)$alignment);
    free(atoms);
}

@proc void apply_selection($)
{
    int lo, hi, h, sb, eb;
    if (!$para_ptr) return;
    if ($caret_cp == $anchor_cp) {
        retex_paragraph_set_selection((RetexParagraph*)$para_ptr, -1, -1);
        return;
    }
    lo = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
    hi = $caret_cp < $anchor_cp ? $anchor_cp : $caret_cp;
    h = make_utf8($);
    if (!h) return;
    sb = utf8_cp_index_to_byte((char*)m_buf(h), lo);
    eb = utf8_cp_index_to_byte((char*)m_buf(h), hi);
    m_free(h);
    retex_paragraph_set_selection((RetexParagraph*)$para_ptr, sb, eb > sb ? eb - 1 : sb);
}

@proc void draw_caret_in_cache($, Backend *be)
{
    int byte, first, nl;
    double cx, cy, ch, y0 = 0.0;
    RetexLine l0;

    if (!$para_ptr) return;
    byte = cp_to_byte($, $caret_cp);
    if (!retex_paragraph_get_caret_pos((RetexParagraph*)$para_ptr, byte, &cx, &cy, &ch))
        return;

    nl = retex_paragraph_get_line_count((RetexParagraph*)$para_ptr);
    first = $scroll_line;
    if (first < 0) first = 0;
    if (first >= nl) first = nl > 0 ? nl - 1 : 0;
    if (retex_paragraph_get_line((RetexParagraph*)$para_ptr, first, &l0))
        y0 = l0.y;

    be->draw_rect(be,
                  px2pt($, (double)$leftGap) + cx,
                  px2pt($, (double)$topGap) + (cy - y0),
                  px2pt($, 2.0), ch,
                  xftcolor_to_argb($, COL_FG));
}

@proc void update_cache($)
{
    int w, h, first, nl;
    RendererColors colors;
    Backend *be;

    if (!XtIsRealized($) || XtWindow($) == 0) return;

    w = $width > 4000 ? 4000 : ($width < 1 ? 1 : $width);
    h = $height > 4000 ? 4000 : ($height < 1 ? 1 : $height);

    if ($backend_ptr && (w != $last_width || h != $last_height)) {
        Backend *old = (Backend*)$backend_ptr;
        old->destroy(old);
        $backend_ptr = NULL;
        $pixmap = 0;
    }
    if (!$backend_ptr) {
        $backend_ptr = backend_xpixmap_create(XtDisplay($), XtWindow($), w, h);
        if (!$backend_ptr) return;
        $pixmap = backend_xpixmap_get_pixmap((Backend*)$backend_ptr);
        $last_width = w;
        $last_height = h;
    }

    relayout($);
    be = (Backend*)$backend_ptr;

    be->draw_rect(be, 0, 0, px2pt($, (double)w), px2pt($, (double)h),
                  xftcolor_to_argb($, COL_BG));

    colors.text = xftcolor_to_argb($, COL_FG);
    colors.bg = xftcolor_to_argb($, COL_BG);
    colors.reverse_text = xftcolor_to_argb($, COL_SELBG);
    colors.reverse_bg = xftcolor_to_argb($, COL_FG);
    colors.sel_text = xftcolor_to_argb($, COL_SELFG);
    colors.sel_bg = xftcolor_to_argb($, COL_SELBG);

    apply_selection($);

    nl = retex_paragraph_get_line_count((RetexParagraph*)$para_ptr);
    first = $scroll_line;
    if (first < 0) first = 0;
    if (first >= nl) first = nl > 0 ? nl - 1 : 0;

    if (nl > 0)
        retex_paragraph_render_range((RetexParagraph*)$para_ptr, be,
                                     first, nl - 1,
                                     px2pt($, (double)$leftGap),
                                     px2pt($, (double)$topGap),
                                     &colors, 0);

    draw_caret_in_cache($, be);
    be->flush(be);
    $dirty = 0;
}

@proc void redraw($)
{
    if (!XtIsRealized($)) return;
    if ($dirty || !$backend_ptr) update_cache($);
    if ($pixmap) {
        int w = $width > 4000 ? 4000 : $width;
        int h = $height > 4000 ? 4000 : $height;
        XCopyArea(XtDisplay($), $pixmap, XtWindow($), $blit_gc, 0, 0, w, h, 0, 0);
    }
}

@proc void ensure_visible($)
{
    int cl = caret_line($);
    int visible;
    RetexLine l;
    double line_px;

    if (retex_paragraph_get_line((RetexParagraph*)$para_ptr, 0, &l))
        line_px = pt2px($, l.height);
    else
        line_px = 1.0;
    visible = (int)(((double)$height - $topGap - $bottomGap) / (line_px > 1.0 ? line_px : 1.0));
    if (visible < 1) visible = 1;

    if (cl < $scroll_line) $scroll_line = cl;
    else if (cl >= $scroll_line + visible) $scroll_line = cl - visible + 1;
    if ($scroll_line < 0) $scroll_line = 0;
    $dirty = 1;
}

@proc void set_caret_cp($, int cp, Bool extend)
{
    int len = doc_len($);
    if (cp < 0) cp = 0;
    if (cp > len) cp = len;
    $caret_cp = cp;
    if (!extend) $anchor_cp = cp;
    sync_look($);
    ensure_visible($);
}

@proc void set_caret_from_byte($, int byte, Bool extend)
{
    set_caret_cp($, byte_to_cp($, byte), extend);
}

@ editing

@proc void push_undo($, int cp, int anchor)
{
    int nn = 0;
    RetexParaFormat *pc;
    if ($undo_n >= $undo_cap) {
        int nc = $undo_cap ? $undo_cap * 2 : 8;
        int *a = (int*)realloc($undo_cp, nc * sizeof(int));
        int *b;
        RetexParaFormat **pp;
        int *pn;
        if (!a) return;
        $undo_cp = a;
        b = (int*)realloc($undo_anchor, nc * sizeof(int));
        if (!b) return;
        $undo_anchor = b;
        pp = (RetexParaFormat**)realloc($undo_para, nc * sizeof(RetexParaFormat*));
        if (!pp) return;
        $undo_para = pp;
        pn = (int*)realloc($undo_para_n, nc * sizeof(int));
        if (!pn) return;
        $undo_para_n = pn;
        $undo_cap = nc;
    }
    pc = para_copy($, &nn);
    $undo_cp[$undo_n] = cp;
    $undo_anchor[$undo_n] = anchor;
    ((RetexParaFormat**)$undo_para)[$undo_n] = pc;
    $undo_para_n[$undo_n] = nn;
    $undo_n++;
}

@proc void push_redo($, int cp, int anchor)
{
    int nn = 0;
    RetexParaFormat *pc;
    if ($redo_n >= $redo_cap) {
        int nc = $redo_cap ? $redo_cap * 2 : 8;
        int *a = (int*)realloc($redo_cp, nc * sizeof(int));
        int *b;
        RetexParaFormat **pp;
        int *pn;
        if (!a) return;
        $redo_cp = a;
        b = (int*)realloc($redo_anchor, nc * sizeof(int));
        if (!b) return;
        $redo_anchor = b;
        pp = (RetexParaFormat**)realloc($redo_para, nc * sizeof(RetexParaFormat*));
        if (!pp) return;
        $redo_para = pp;
        pn = (int*)realloc($redo_para_n, nc * sizeof(int));
        if (!pn) return;
        $redo_para_n = pn;
        $redo_cap = nc;
    }
    pc = para_copy($, &nn);
    $redo_cp[$redo_n] = cp;
    $redo_anchor[$redo_n] = anchor;
    ((RetexParaFormat**)$redo_para)[$redo_n] = pc;
    $redo_para_n[$redo_n] = nn;
    $redo_n++;
}

@proc void edit_begin($)
{
    int i;
    RetexParaFormat **rp;
    if (!$ptable) return;
    rtable_snapshot((RTable*)$ptable);
    para_snapshot($);
    $edit_old_len = rtable_len((RTable*)$ptable);
    push_undo($, $caret_cp, $anchor_cp);
    /* A new edit invalidates the redo history (and its format snapshots). */
    rp = (RetexParaFormat**)$redo_para;
    if (rp) {
        for (i = 0; i < $redo_n; i++) { free(rp[i]); rp[i] = NULL; }
    }
    $redo_n = 0;
}

@proc void delete_selection_only($)
{
    int lo, hi;
    if ($caret_cp == $anchor_cp) return;
    lo = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
    hi = $caret_cp < $anchor_cp ? $anchor_cp : $caret_cp;
    rtable_delete((RTable*)$ptable, lo, hi - lo);
    $caret_cp = lo;
    $anchor_cp = lo;
}

@proc void insert_cps($, uint32_t *cps, int n)
{
    int pos;
    if (n <= 0 || !$ptable) return;
    edit_begin($);
    delete_selection_only($);
    pos = $caret_cp;
    rtable_insert_cps((RTable*)$ptable, pos, cps, n, $look);
    $caret_cp += n;
    $anchor_cp = $caret_cp;
    para_resync($, pos, rtable_len((RTable*)$ptable) - $edit_old_len);
    $dirty = 1;
    ensure_visible($);
}

@proc void decode_key($, char *buf, int len, uint32_t *cps, int *np)
{
    int n = 0, i;
    if (utf8_validate(buf))
        n = utf32_from_utf8(buf, cps, 64);
    if (n < 0) n = 0;
    if (n == 0) {
        for (i = 0; i < len && n < 64; i++)
            cps[n++] = (unsigned char)buf[i];
    }
    *np = n;
}

@proc void move_vertical($, int delta)
{
    int byte, line, nl, nbyte;
    double cx, cy, ch;
    RetexLine target;

    if (!$para_ptr) return;
    line = caret_line($);
    nl = retex_paragraph_get_line_count((RetexParagraph*)$para_ptr);
    line += delta;
    if (line < 0) line = 0;
    if (line >= nl) line = nl - 1;
    if (!retex_paragraph_get_line((RetexParagraph*)$para_ptr, line, &target)) return;

    byte = cp_to_byte($, $caret_cp);
    if (!retex_paragraph_get_caret_pos((RetexParagraph*)$para_ptr, byte, &cx, &cy, &ch))
        return;
    nbyte = retex_paragraph_get_offset_at((RetexParagraph*)$para_ptr,
                                          cx, target.y + target.height / 2.0);
    set_caret_from_byte($, nbyte, False);
}

@ selection ownership and clipboard

@proc void fill_selection_text($)
{
    int lo, hi, h, sb, eb, len;
    char *nb;

    $sel_len = 0;
    if ($caret_cp == $anchor_cp) return;
    lo = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
    hi = $caret_cp < $anchor_cp ? $anchor_cp : $caret_cp;
    h = make_utf8($);
    if (!h) return;
    sb = utf8_cp_index_to_byte((char*)m_buf(h), lo);
    eb = utf8_cp_index_to_byte((char*)m_buf(h), hi);
    len = eb - sb;
    if (len < 0) len = 0;
    nb = (char*)realloc($sel_buf, len + 1);
    if (!nb) { m_free(h); return; }
    $sel_buf = nb;
    if (len > 0) memcpy($sel_buf, (char*)m_buf(h) + sb, len);
    $sel_buf[len] = 0;
    $sel_len = len;
    m_free(h);
}

@proc Boolean ConvertSelection($, Atom *selection, Atom *target,
                               Atom *type, XtPointer *value,
                               unsigned long *length, int *format)
{
    if (*target == $utf8_atom) {
        int l = $sel_len;
        *type = $utf8_atom;
        *format = 8;
        *length = (unsigned long)l;
        *value = XtMalloc(l > 0 ? l : 1);
        if (l > 0 && $sel_buf) memcpy(*value, $sel_buf, l);
        return True;
    }
    *type = None;
    *value = NULL;
    *length = 0;
    *format = 0;
    return False;
}

@proc void LoseSelection($, Atom *selection)
{
}

@proc void RequestSelection($, XtPointer client, Atom *selection,
                            Atom *type, XtPointer value,
                            unsigned long *length, int *format)
{
    char *s = (char*)value;
    uint32_t cps[256];
    int n = 0;

    if (!s || !*length) return;
    if (utf8_validate(s))
        n = utf32_from_utf8(s, cps, 256);
    if (n < 0) n = 0;
    if (n == 0) {
        unsigned long i;
        for (i = 0; i < *length && n < 256; i++)
            cps[n++] = (unsigned char)s[i];
    }
    insert_cps($, cps, n);
    redraw($);
}

@ ---------------------------------------------------------------------
@ Full-state snapshot (save/load) for debugging and error reproduction.
@ The file is a binary container: widget resources, the rich document
@ (atoms + looks), paragraph formats, caret/selection and the complete
@ undo/redo history (including the rtable piece snapshots).
@ ---------------------------------------------------------------------

@proc int st_wr(FILE *f, const void *p, int n)
{
    if (n <= 0) return 0;
    return fwrite(p, 1, (size_t)n, f) == (size_t)n ? 0 : -1;
}

@proc int st_rd(FILE *f, void *p, int n)
{
    if (n <= 0) return 0;
    return fread(p, 1, (size_t)n, f) == (size_t)n ? 0 : -1;
}

@proc int st_wr_u32(FILE *f, uint32_t v)
{
    unsigned char b[4];
    b[0] = (unsigned char)(v & 0xff);
    b[1] = (unsigned char)((v >> 8) & 0xff);
    b[2] = (unsigned char)((v >> 16) & 0xff);
    b[3] = (unsigned char)((v >> 24) & 0xff);
    return st_wr(f, b, 4);
}

@proc uint32_t st_rd_u32(FILE *f, int *ok)
{
    unsigned char b[4];
    if (st_rd(f, b, 4) != 0) {
        if (ok) *ok = 0;
        return 0;
    }
    return (uint32_t)b[0] | ((uint32_t)b[1] << 8) |
           ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
}

@proc int st_wr_i32(FILE *f, int v) { return st_wr_u32(f, (uint32_t)v); }

@proc int st_rd_i32(FILE *f, int *ok) { return (int)st_rd_u32(f, ok); }

@proc int st_wr_f32(FILE *f, float v)
{
    uint32_t u;
    memcpy(&u, &v, 4);
    return st_wr_u32(f, u);
}

@proc float st_rd_f32(FILE *f, int *ok)
{
    uint32_t u = st_rd_u32(f, ok);
    float v;
    memcpy(&v, &u, 4);
    return v;
}

@proc int st_wr_f64(FILE *f, double v)
{
    uint64_t u;
    unsigned char b[8];
    int i;
    memcpy(&u, &v, 8);
    for (i = 0; i < 8; i++)
        b[i] = (unsigned char)((u >> (8 * i)) & 0xff);
    return st_wr(f, b, 8);
}

@proc double st_rd_f64(FILE *f, int *ok)
{
    unsigned char b[8];
    uint64_t u = 0;
    double v;
    int i;
    if (st_rd(f, b, 8) != 0) {
        if (ok) *ok = 0;
        return 0.0;
    }
    for (i = 0; i < 8; i++)
        u |= ((uint64_t)b[i]) << (8 * i);
    memcpy(&v, &u, 8);
    return v;
}

@proc int st_wr_str(FILE *f, const char *s)
{
    int n = s ? (int)strlen(s) : 0;
    if (st_wr_u32(f, (uint32_t)n) != 0) return -1;
    return st_wr(f, s, n);
}

@proc char* st_rd_str(FILE *f, int *ok)
{
    uint32_t n = st_rd_u32(f, ok);
    char *s;
    if (!ok || !*ok) return NULL;
    if (n > (uint32_t)(64 * 1024 * 1024)) {
        *ok = 0;
        return NULL;
    }
    s = (char*)malloc((size_t)n + 1);
    if (!s) {
        *ok = 0;
        return NULL;
    }
    if (st_rd(f, s, (int)n) != 0) {
        free(s);
        *ok = 0;
        return NULL;
    }
    s[n] = 0;
    return s;
}

@proc int st_wr_para(FILE *f, const RetexParaFormat *p)
{
    int ok = 1;
    ok &= st_wr_i32(f, p->align) == 0;
    ok &= st_wr_f64(f, p->indent_left) == 0;
    ok &= st_wr_f64(f, p->indent_right) == 0;
    ok &= st_wr_f64(f, p->first_line) == 0;
    ok &= st_wr_f64(f, p->space_before) == 0;
    ok &= st_wr_f64(f, p->space_after) == 0;
    return ok ? 0 : -1;
}

@proc int st_rd_para(FILE *f, RetexParaFormat *p, int *ok)
{
    p->align = st_rd_i32(f, ok);
    p->indent_left = st_rd_f64(f, ok);
    p->indent_right = st_rd_f64(f, ok);
    p->first_line = st_rd_f64(f, ok);
    p->space_before = st_rd_f64(f, ok);
    p->space_after = st_rd_f64(f, ok);
    return (ok && *ok) ? 0 : -1;
}

@ Write the complete editor state to path.  Returns 1 on success.
@proc int save_state_file($, const char *path)
{
    FILE *f;
    unsigned char *blob = NULL;
    int blob_len = 0, ok = 1, i, j, h;
    RetexParaFormat **up, **rp;
    const char *text;

    if (!path || !$ptable) return 0;
    f = fopen(path, "wb");
    if (!f) return 0;

    ok &= st_wr(f, "WBRAVOST", 8) == 0;
    ok &= st_wr_u32(f, 1) == 0;          /* format version */
    ok &= st_wr_u32(f, 0) == 0;          /* reserved */

    /* widget resources / current editing state */
    ok &= st_wr_str(f, $fontFace ? $fontFace : "") == 0;
    ok &= st_wr_i32(f, $fontSize) == 0;
    ok &= st_wr_i32(f, $alignment) == 0;
    ok &= st_wr_i32(f, $topGap) == 0;
    ok &= st_wr_i32(f, $bottomGap) == 0;
    ok &= st_wr_i32(f, $leftGap) == 0;
    ok &= st_wr_i32(f, $rightGap) == 0;
    ok &= st_wr_i32(f, $scroll_line) == 0;
    ok &= st_wr_i32(f, $caret_cp) == 0;
    ok &= st_wr_i32(f, $anchor_cp) == 0;
    ok &= st_wr_str(f, m_str($look.face)) == 0;
    ok &= st_wr_i32(f, $look.style) == 0;
    ok &= st_wr_f32(f, $look.size) == 0;

    /* current text (redundant with the atoms, kept for readability/tools) */
    h = make_utf8($);
    text = h ? (const char*)m_buf(h) : "";
    ok &= st_wr_str(f, text) == 0;
    if (h) m_free(h);

    /* per-paragraph formats */
    ok &= st_wr_u32(f, (uint32_t)$para_n) == 0;
    for (i = 0; i < $para_n && $para_fmt; i++)
        ok &= st_wr_para(f, &((RetexParaFormat*)$para_fmt)[i]) == 0;

    /* rich piece table: atoms, looks, pieces and undo/redo spans */
    blob = rtable_serialize((RTable*)$ptable, &blob_len);
    if (!blob) {
        ok = 0;
    } else {
        ok &= st_wr_u32(f, (uint32_t)blob_len) == 0;
        ok &= st_wr(f, blob, blob_len) == 0;
        free(blob);
    }

    /* widget-level undo history (caret + paragraph snapshot per entry) */
    up = (RetexParaFormat**)$undo_para;
    ok &= st_wr_u32(f, (uint32_t)$undo_n) == 0;
    for (i = 0; i < $undo_n; i++) {
        int pn = (up && up[i]) ? $undo_para_n[i] : 0;
        ok &= st_wr_i32(f, $undo_cp[i]) == 0;
        ok &= st_wr_i32(f, $undo_anchor[i]) == 0;
        ok &= st_wr_u32(f, (uint32_t)pn) == 0;
        for (j = 0; j < pn; j++)
            ok &= st_wr_para(f, &up[i][j]) == 0;
    }

    rp = (RetexParaFormat**)$redo_para;
    ok &= st_wr_u32(f, (uint32_t)$redo_n) == 0;
    for (i = 0; i < $redo_n; i++) {
        int pn = (rp && rp[i]) ? $redo_para_n[i] : 0;
        ok &= st_wr_i32(f, $redo_cp[i]) == 0;
        ok &= st_wr_i32(f, $redo_anchor[i]) == 0;
        ok &= st_wr_u32(f, (uint32_t)pn) == 0;
        for (j = 0; j < pn; j++)
            ok &= st_wr_para(f, &rp[i][j]) == 0;
    }

    if (fclose(f) != 0) ok = 0;
    return ok;
}

@ Restore the complete editor state from path.  Returns 1 on success.
@proc int load_state_file($, const char *path)
{
    FILE *f;
    int ok = 1, version = 0, i, j;
    char magic[8];
    char *face = NULL, *look_face = NULL, *saved_text = NULL;
    int fontSize = 0, align = 0, tg = 0, bg = 0, lg = 0, rg = 0;
    int scroll = 0, caret = 0, anchor = 0, look_style = 0;
    float look_size = 0.0f;
    int pn = 0, blob_len = 0, undo_n = 0, redo_n = 0;
    RetexParaFormat *pf = NULL;
    unsigned char *blob = NULL;
    int *ucp = NULL, *uanchor = NULL, *upn = NULL;
    int *rcp = NULL, *ranchor = NULL, *rpn = NULL;
    RetexParaFormat **upara = NULL, **rpara = NULL;

    if (!path || !$ptable) return 0;
    f = fopen(path, "rb");
    if (!f) return 0;

    if (st_rd(f, magic, 8) != 0 || memcmp(magic, "WBRAVOST", 8) != 0)
        goto fail;
    version = st_rd_i32(f, &ok);
    if (!ok || version != 1) goto fail;
    (void)st_rd_u32(f, &ok);            /* reserved */

    face = st_rd_str(f, &ok);
    fontSize = st_rd_i32(f, &ok);
    align = st_rd_i32(f, &ok);
    tg = st_rd_i32(f, &ok);
    bg = st_rd_i32(f, &ok);
    lg = st_rd_i32(f, &ok);
    rg = st_rd_i32(f, &ok);
    scroll = st_rd_i32(f, &ok);
    caret = st_rd_i32(f, &ok);
    anchor = st_rd_i32(f, &ok);
    look_face = st_rd_str(f, &ok);
    look_style = st_rd_i32(f, &ok);
    look_size = st_rd_f32(f, &ok);
    saved_text = st_rd_str(f, &ok);
    if (!ok) goto fail;

    pn = (int)st_rd_u32(f, &ok);
    if (!ok || pn < 0 || pn > 1000000) goto fail;
    if (pn < 1) pn = 1;
    pf = (RetexParaFormat*)calloc((size_t)pn, sizeof(RetexParaFormat));
    if (!pf) goto fail;
    for (i = 0; i < pn; i++)
        if (st_rd_para(f, &pf[i], &ok) != 0) goto fail;

    blob_len = (int)st_rd_u32(f, &ok);
    if (!ok || blob_len <= 0 || blob_len > (1 << 30)) goto fail;
    blob = (unsigned char*)malloc((size_t)blob_len);
    if (!blob) goto fail;
    if (st_rd(f, blob, blob_len) != 0) goto fail;

    undo_n = (int)st_rd_u32(f, &ok);
    if (!ok || undo_n < 0 || undo_n > 1000000) goto fail;
    if (undo_n > 0) {
        ucp = (int*)calloc((size_t)undo_n, sizeof(int));
        uanchor = (int*)calloc((size_t)undo_n, sizeof(int));
        upn = (int*)calloc((size_t)undo_n, sizeof(int));
        upara = (RetexParaFormat**)calloc((size_t)undo_n, sizeof(RetexParaFormat*));
        if (!ucp || !uanchor || !upn || !upara) goto fail;
        for (i = 0; i < undo_n; i++) {
            ucp[i] = st_rd_i32(f, &ok);
            uanchor[i] = st_rd_i32(f, &ok);
            upn[i] = (int)st_rd_u32(f, &ok);
            if (!ok || upn[i] < 0 || upn[i] > 1000000) goto fail;
            if (upn[i] > 0) {
                upara[i] = (RetexParaFormat*)calloc((size_t)upn[i], sizeof(RetexParaFormat));
                if (!upara[i]) goto fail;
                for (j = 0; j < upn[i]; j++)
                    if (st_rd_para(f, &upara[i][j], &ok) != 0) goto fail;
            }
        }
    }

    redo_n = (int)st_rd_u32(f, &ok);
    if (!ok || redo_n < 0 || redo_n > 1000000) goto fail;
    if (redo_n > 0) {
        rcp = (int*)calloc((size_t)redo_n, sizeof(int));
        ranchor = (int*)calloc((size_t)redo_n, sizeof(int));
        rpn = (int*)calloc((size_t)redo_n, sizeof(int));
        rpara = (RetexParaFormat**)calloc((size_t)redo_n, sizeof(RetexParaFormat*));
        if (!rcp || !ranchor || !rpn || !rpara) goto fail;
        for (i = 0; i < redo_n; i++) {
            rcp[i] = st_rd_i32(f, &ok);
            ranchor[i] = st_rd_i32(f, &ok);
            rpn[i] = (int)st_rd_u32(f, &ok);
            if (!ok || rpn[i] < 0 || rpn[i] > 1000000) goto fail;
            if (rpn[i] > 0) {
                rpara[i] = (RetexParaFormat*)calloc((size_t)rpn[i], sizeof(RetexParaFormat));
                if (!rpara[i]) goto fail;
                for (j = 0; j < rpn[i]; j++)
                    if (st_rd_para(f, &rpara[i][j], &ok) != 0) goto fail;
            }
        }
    }

    if (!ok) goto fail;
    fclose(f);
    f = NULL;

    /* apply the rich document + history */
    if (rtable_deserialize((RTable*)$ptable, blob, blob_len) != 0) goto fail;
    free(blob);
    blob = NULL;

    /* Keep widget-level stacks within the restored rtable depths. */
    {
        int ud = rtable_undo_depth((RTable*)$ptable);
        int rd = rtable_redo_depth((RTable*)$ptable);
        if (undo_n > ud) {
            for (i = ud; i < undo_n; i++) free(upara[i]);
            undo_n = ud;
        }
        if (redo_n > rd) {
            for (i = rd; i < redo_n; i++) free(rpara[i]);
            redo_n = rd;
        }
    }

    /* text resource mirrors the restored document */
    {
        int h = make_utf8($);
        const char *s = h ? (const char*)m_buf(h) : "";
        XtFree($text_mem);
        $text_mem = XtNewString(s);
        $text = $text_mem;
        if (h) m_free(h);
    }

    /* replace widget-level history and paragraph formats */
    para_clear_history($);
    free($undo_cp); free($undo_anchor); free($undo_para); free($undo_para_n);
    free($redo_cp); free($redo_anchor); free($redo_para); free($redo_para_n);
    $undo_cp = ucp; $undo_anchor = uanchor; $undo_para = upara; $undo_para_n = upn;
    $undo_n = undo_n; $undo_cap = undo_n;
    $redo_cp = rcp; $redo_anchor = ranchor; $redo_para = rpara; $redo_para_n = rpn;
    $redo_n = redo_n; $redo_cap = redo_n;
    ucp = NULL; uanchor = NULL; upara = NULL; upn = NULL;
    rcp = NULL; ranchor = NULL; rpara = NULL; rpn = NULL;

    free($para_fmt);
    $para_fmt = pf;
    $para_n = pn;
    $para_cap = pn;
    pf = NULL;

    free($old_para_start);
    $old_para_start = NULL;
    $old_para_n = 0;
    $edit_old_len = rtable_len((RTable*)$ptable);

    /* resources / pending look / caret */
    $fontSize = fontSize;
    $alignment = align;
    $topGap = tg;
    $bottomGap = bg;
    $leftGap = lg;
    $rightGap = rg;

    free($fontFace_mem);
    if (!face || !*face) {
        free(face);
        face = strdup("Sans");
    }
    $fontFace_mem = face;
    $fontFace = $fontFace_mem;
    face = NULL;

    $look.face = (look_face && *look_face) ? conststr_lookup_c(look_face) : 0;
    $look.style = look_style;
    $look.size = look_size;

    {
        int len = doc_len($);
        if (caret < 0) caret = 0;
        if (caret > len) caret = len;
        if (anchor < 0) anchor = 0;
        if (anchor > len) anchor = len;
        $caret_cp = caret;
        $anchor_cp = anchor;
        $scroll_line = scroll < 0 ? 0 : scroll;
    }

    free(look_face);
    free(saved_text);
    $dirty = 1;
    if (XtIsRealized($)) redraw($);
    return 1;

fail:
    if (f) fclose(f);
    free(face);
    free(look_face);
    free(saved_text);
    free(pf);
    free(blob);
    if (upara) {
        for (i = 0; i < undo_n; i++) free(upara[i]);
        free(upara);
    }
    free(ucp); free(uanchor); free(upn);
    if (rpara) {
        for (i = 0; i < redo_n; i++) free(rpara[i]);
        free(rpara);
    }
    free(rcp); free(ranchor); free(rpn);
    return 0;
}


@ACTIONS

@ External control interface.  All of these are ordinary Xt action procs, so
@ any application can drive the editor with
@     XtCallActionProc(w, "name", NULL, params, nparams);
@ without linking Wbravo's private helpers.  Groups:
@   document    set_text, insert_text, insert_newline, delete_backward,
@               delete_forward, undo, redo, cut_selection, copy_selection, paste
@   caret/sel   set_caret, set_caret_byte, set_selection, select_all, move_*,
@               forward_char, backward_char, page_up, page_down
@   text style  bold, italic, roman, set_bold, set_italic, set_font, set_size
@   paragraph   align_left/center/right/justify, set_alignment, indent,
@               outdent, indent_right, outdent_right, indent_first,
@               outdent_first, set_indent_left, set_indent_right,
@               set_first_line_indent, set_space_before, set_space_after
@   focus       SetFocus, set_cursor, extend_selection
@   snapshot    save_state <path>, load_state <path> (complete editor state:
@               document + looks + paragraphs + undo/redo + resources)
@ Parameters are the action's String arguments (params[0], params[1], ...);
@ numeric actions clamp or ignore malformed values.

@proc SetFocus
{
    Widget shell, parent;
    shell = parent = $;
    while (parent) {
        if (XtIsShell(shell = parent)) break;
        parent = XtParent(parent);
    }
    XtSetKeyboardFocus(shell, $);
}

@proc bold
{
    toggle_style($, 1);
}

@proc italic
{
    toggle_style($, 2);
}

@proc roman
{
    apply_style_bits($, 0, 3);   /* clear bold + italic */
}

@proc set_font
{
    if (num_params && *num_params >= 1 && params[0])
        apply_face($, conststr_lookup_c(params[0]));
}

@proc set_size
{
    if (num_params && *num_params >= 1 && params[0])
        apply_size($, (float)atof(params[0]));
}

@ paragraph actions

@proc align_left    { para_set_align($, RETEX_ALIGN_LEFT); }
@proc align_center  { para_set_align($, RETEX_ALIGN_CENTER); }
@proc align_right   { para_set_align($, RETEX_ALIGN_RIGHT); }
@proc align_justify { para_set_align($, RETEX_ALIGN_JUSTIFY); }

@proc indent        { para_add_indent($, 1, 24.0); }
@proc outdent       { para_add_indent($, 1, -24.0); }
@proc indent_right  { para_add_indent($, 2, 24.0); }
@proc outdent_right { para_add_indent($, 2, -24.0); }
@proc indent_first  { para_add_indent($, 3, 24.0); }
@proc outdent_first { para_add_indent($, 3, -24.0); }

@proc set_space_before
{
    if (num_params && *num_params >= 1 && params[0])
        para_set_space($, 0, atof(params[0]));
}

@proc set_space_after
{
    if (num_params && *num_params >= 1 && params[0])
        para_set_space($, 1, atof(params[0]));
}

@ External control interface.  Every action below can be invoked from another
@ application with XtCallActionProc(); parameters are the action's String args.

@ Replace the whole document (keeps the text resource in sync).
@proc set_text
{
    if (num_params && *num_params >= 1 && params[0]) {
        XtVaSetValues($, XtNtext, params[0], NULL);
        if (XtIsRealized($)) redraw($);
    }
}

@ Save the complete editor state (document + looks + paragraphs + undo/redo
@ + resources) to params[0].  Intended for debugging/error reproduction.
@proc save_state
{
    if (num_params && *num_params >= 1 && params[0])
        save_state_file($, params[0]);
}

@ Restore a complete editor state previously written by save_state.
@proc load_state
{
    if (num_params && *num_params >= 1 && params[0])
        load_state_file($, params[0]);
}

@ Move the caret to a code-point offset (0 = before the first character).
@proc set_caret
{
    if (num_params && *num_params >= 1 && params[0]) {
        set_caret_cp($, atoi(params[0]), False);
        $dirty = 1;
        redraw($);
    }
}

@ Move the caret to a UTF-8 byte offset.
@proc set_caret_byte
{
    if (num_params && *num_params >= 1 && params[0]) {
        set_caret_from_byte($, atoi(params[0]), False);
        $dirty = 1;
        redraw($);
    }
}

@ Set the selection: params[0] = anchor (start), params[1] = caret (end),
@ both code-point offsets.  Equal values collapse the selection.
@proc set_selection
{
    int a, b, len;
    if (num_params && *num_params >= 2 && params[0] && params[1]) {
        len = doc_len($);
        a = atoi(params[0]);
        b = atoi(params[1]);
        if (a < 0) a = 0;
        if (a > len) a = len;
        if (b < 0) b = 0;
        if (b > len) b = len;
        $anchor_cp = a;
        $caret_cp = b;
        sync_look($);
        $dirty = 1;
        ensure_visible($);
        redraw($);
    }
}

@ Select the whole document.
@proc select_all
{
    $anchor_cp = 0;
    $caret_cp = doc_len($);
    sync_look($);
    $dirty = 1;
    ensure_visible($);
    redraw($);
}

@ Set paragraph alignment: 0|1|2|3 or left|center|right|justify.
@proc set_alignment
{
    int al;
    if (num_params && *num_params >= 1 && params[0]) {
        al = parse_alignment($, params[0]);
        if (al >= 0) para_set_align($, al);
    }
}

@ Absolute paragraph indents in points (left / right / first line).
@proc set_indent_left
{
    if (num_params && *num_params >= 1 && params[0])
        para_set_indent($, 1, atof(params[0]));
}

@proc set_indent_right
{
    if (num_params && *num_params >= 1 && params[0])
        para_set_indent($, 2, atof(params[0]));
}

@proc set_first_line_indent
{
    if (num_params && *num_params >= 1 && params[0])
        para_set_indent($, 3, atof(params[0]));
}

@ Explicitly set bold/italic on the selection, or on the pending typing look:
@ params[0] is 1/0 (default 1 when omitted).
@proc set_bold
{
    int on = 1;
    if (num_params && *num_params >= 1 && params[0])
        on = atoi(params[0]) != 0;
    apply_style_bits($, on ? 1 : 0, on ? 0 : 1);
}

@proc set_italic
{
    int on = 1;
    if (num_params && *num_params >= 1 && params[0])
        on = atoi(params[0]) != 0;
    apply_style_bits($, on ? 2 : 0, on ? 0 : 2);
}

@proc insert_text
{
    uint32_t cps[256];
    int n = 0;
    if (!num_params || *num_params < 1 || !params[0]) return;
    decode_key($, params[0], (int)strlen(params[0]), cps, &n);
    insert_cps($, cps, n);
    redraw($);
}

@proc insert_char
{
    unsigned char buf[64];
    KeySym ks;
    uint32_t cps[64];
    int len, n;
    len = _XawLookupString($, (XKeyEvent*)event, (char*)buf, sizeof buf, &ks);
    if (len <= 0) return;
    decode_key($, (char*)buf, len, cps, &n);
    insert_cps($, cps, n);
    redraw($);
}

@proc insert_newline
{
    uint32_t cp = '\n';
    insert_cps($, &cp, 1);
    redraw($);
}

@proc delete_backward
{
    int pos;
    if ($caret_cp != $anchor_cp) {
        pos = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
        edit_begin($);
        delete_selection_only($);
        para_resync($, pos, rtable_len((RTable*)$ptable) - $edit_old_len);
    } else if ($caret_cp > 0) {
        edit_begin($);
        pos = $caret_cp - 1;
        rtable_delete((RTable*)$ptable, pos, 1);
        $caret_cp--;
        $anchor_cp = $caret_cp;
        para_resync($, pos, -1);
    }
    $dirty = 1;
    ensure_visible($);
    redraw($);
}

@proc delete_forward
{
    int pos;
    if ($caret_cp != $anchor_cp) {
        pos = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
        edit_begin($);
        delete_selection_only($);
        para_resync($, pos, rtable_len((RTable*)$ptable) - $edit_old_len);
    } else if ($caret_cp < doc_len($)) {
        edit_begin($);
        pos = $caret_cp;
        rtable_delete((RTable*)$ptable, pos, 1);
        para_resync($, pos, -1);
    }
    $dirty = 1;
    ensure_visible($);
    redraw($);
}

@proc forward_char
{
    set_caret_cp($, $caret_cp + 1, False);
    redraw($);
}

@proc backward_char
{
    set_caret_cp($, $caret_cp - 1, False);
    redraw($);
}

@proc move_up
{
    move_vertical($, -1);
    redraw($);
}

@proc move_down
{
    move_vertical($, 1);
    redraw($);
}

@proc move_home
{
    int line = caret_line($);
    RetexLine l;
    if (retex_paragraph_get_line((RetexParagraph*)$para_ptr, line, &l))
        set_caret_from_byte($, l.start_byte, False);
    redraw($);
}

@proc move_end
{
    int line = caret_line($);
    RetexLine l;
    if (retex_paragraph_get_line((RetexParagraph*)$para_ptr, line, &l))
        set_caret_from_byte($, l.end_byte, False);
    redraw($);
}

@proc page_up
{
    sync_layout($);
    $scroll_line -= 10;
    if ($scroll_line < 0) $scroll_line = 0;
    $dirty = 1;
    redraw($);
}

@proc page_down
{
    sync_layout($);
    int nl = retex_paragraph_get_line_count((RetexParagraph*)$para_ptr);
    $scroll_line += 10;
    if ($scroll_line > nl - 1) $scroll_line = nl > 0 ? nl - 1 : 0;
    $dirty = 1;
    redraw($);
}

@proc set_cursor
{
    sync_layout($);
    int mx = event->xbutton.x - $leftGap;
    int my = event->xbutton.y - $topGap;
    double xpt = px2pt($, (double)mx);
    double ypt = px2pt($, (double)my) + scroll_offset_pt($);
    int byte;

    if (!$para_ptr) return;
    byte = retex_paragraph_get_offset_at((RetexParagraph*)$para_ptr, xpt, ypt);
    set_caret_from_byte($, byte, False);
    $dirty = 1;
    redraw($);
}

@proc extend_selection
{
    sync_layout($);
    int mx = event->xbutton.x - $leftGap;
    int my = event->xbutton.y - $topGap;
    double xpt = px2pt($, (double)mx);
    double ypt = px2pt($, (double)my) + scroll_offset_pt($);
    int byte;

    if (!$para_ptr) return;
    byte = retex_paragraph_get_offset_at((RetexParagraph*)$para_ptr, xpt, ypt);
    set_caret_from_byte($, byte, True);
    $dirty = 1;
    redraw($);
}

@proc focus_in
{
    $dirty = 1;
    redraw($);
}

@proc focus_out
{
    $dirty = 1;
    redraw($);
}

@proc undo
{
    if (rtable_undo((RTable*)$ptable)) {
        push_redo($, $caret_cp, $anchor_cp);
        if ($undo_n > 0) {
            $undo_n--;
            $caret_cp = $undo_cp[$undo_n];
            $anchor_cp = $undo_anchor[$undo_n];
            if ($undo_para) {
                RetexParaFormat *p = ((RetexParaFormat**)$undo_para)[$undo_n];
                int n = $undo_para_n[$undo_n];
                ((RetexParaFormat**)$undo_para)[$undo_n] = NULL;
                para_restore($, p, n);
            }
        }
        sync_look($);
        $dirty = 1;
        ensure_visible($);
        redraw($);
    }
}

@proc redo
{
    if (rtable_redo((RTable*)$ptable)) {
        push_undo($, $caret_cp, $anchor_cp);
        if ($redo_n > 0) {
            $redo_n--;
            $caret_cp = $redo_cp[$redo_n];
            $anchor_cp = $redo_anchor[$redo_n];
            if ($redo_para) {
                RetexParaFormat *p = ((RetexParaFormat**)$redo_para)[$redo_n];
                int n = $redo_para_n[$redo_n];
                ((RetexParaFormat**)$redo_para)[$redo_n] = NULL;
                para_restore($, p, n);
            }
        }
        sync_look($);
        $dirty = 1;
        ensure_visible($);
        redraw($);
    }
}

@proc copy_selection
{
    if ($caret_cp == $anchor_cp) return;
    fill_selection_text($);
    XtOwnSelection($, XA_PRIMARY, CurrentTime, ConvertSelection, LoseSelection, NULL);
}

@proc cut_selection
{
    int pos;
    if ($caret_cp == $anchor_cp) return;
    fill_selection_text($);
    XtOwnSelection($, XA_PRIMARY, CurrentTime, ConvertSelection, LoseSelection, NULL);
    pos = $caret_cp < $anchor_cp ? $caret_cp : $anchor_cp;
    edit_begin($);
    delete_selection_only($);
    para_resync($, pos, rtable_len((RTable*)$ptable) - $edit_old_len);
    $dirty = 1;
    ensure_visible($);
    redraw($);
}

@proc paste
{
    XtGetSelectionValue($, XA_PRIMARY, $utf8_atom,
                        RequestSelection, NULL, CurrentTime);
}

@IMPORTS
@incl <assert.h>
@incl <X11/Intrinsic.h>
@incl <X11/Xatom.h>
@incl <X11/Xmu/Converters.h>
@incl <X11/Xft/Xft.h>
@incl <X11/Xaw/XawImP.h>
@incl <math.h>
@incl <stdlib.h>
@incl <string.h>
@incl <stdio.h>
@incl <stdint.h>
@incl "converters.h"
@incl "xutil.h"
@incl "mls.h"
@incl "conststr.h"
@incl "font.h"
@incl "backend.h"
@incl "backend_xpixmap.h"
@incl "retex.h"
@incl "rtable.h"
@incl "utf8.h"
@incl "utf32.h"
