@class WComboBox (Wlabel)
@ Read-only themed combo box with a scrollable WListView popup.

@PUBLIC
@ MLS list of string items
@var int items = 0
@ selected item index, -1 = none
@var int selected = -1
@ text shown when nothing is selected
@var String placeholder = <String> "Select..."
@ maximum popup height in rows
@var int linesHeight = 8
@ keyboard focus indicator
@var Boolean hasFocus = False

@PRIVATE
@var Widget shell
@var Widget list
@var Window catcher
@var int entry_mode
@var Boolean updating_label
@var Boolean commit_pending
@var XtIntervalId commit_timer
@var Pixel focus_ring

@METHODS

@proc destroy
{
    free_catcher($);
    if ($commit_timer) { XtRemoveTimeOut($commit_timer); $commit_timer = 0; }
    if ($shell) {
        XtDestroyWidget($shell);
        $shell = NULL;
        $list = NULL;
    }
    $entry_mode = 0;
    $commit_pending = False;

    if ($para_ptr) { retex_paragraph_free((RetexParagraph*)$para_ptr); $para_ptr = NULL; }
    if ($backend_ptr) {
        Backend *be = (Backend*)$backend_ptr;
        be->destroy(be);
        $backend_ptr = NULL;
    }
    XtFree($label_mem); $label_mem = NULL;
    theme_unregister($);
}

@proc initialize
{
    $shell = NULL;
    $list = NULL;
    $catcher = None;
    $entry_mode = 0;
    $updating_label = False;
    $commit_pending = False;
    $commit_timer = 0;
    $useControlColors = True;
    if ($rightGap == 0) $rightGap = 18;
    $focus_ring = theme_color_defined("accent") ? get_color("accent") : $fg_norm;
    wheel_colors_changed($);
    update_label($);
}

@proc expose
{
    #expose($, event, region);
    draw_arrow($);
}

@TRANSLATIONS
@trans <Btn1Down>: notify()
@trans <FocusIn>: focus_in()
@trans <FocusOut>: focus_out()
@trans <Key>Up: move_up()
@trans <Key>Down: move_down()
@trans <Key>Home: first()
@trans <Key>End: last()
@trans <Key>Return: activate()
@trans <Key>space: activate()
@trans <Key>Escape: dismiss()

@ACTIONS
@proc notify
{
    focus_self($);
    open_popup($);
}

@ open the popup, or close it and commit the current selection
@proc activate
{
    if ($entry_mode) {
        close_popup($);
        XtCallCallbackList($, $callback, (XtPointer)(intptr_t)$selected);
    } else {
        open_popup($);
    }
}

@proc focus_in
{
    $hasFocus = True;
    draw_arrow($);
}

@proc focus_out
{
    $hasFocus = False;
    draw_arrow($);
}

@ focus the combo box from Lua / Xt actions
@proc focus
{
    focus_self($);
}

@proc move_up
{
    int n = $items ? m_len($items) : 0;
    if (n < 1) return;
    if ($selected > 0) $selected--;
    else if ($selected < 0) $selected = 0;
    update_label($);
    sync_list_selection($);
    XtCallCallbackList($, $callback, (XtPointer)(intptr_t)$selected);
}

@proc move_down
{
    int n = $items ? m_len($items) : 0;
    if (n < 1) return;
    if ($selected < 0) $selected = 0;
    else if ($selected < n - 1) $selected++;
    update_label($);
    sync_list_selection($);
    XtCallCallbackList($, $callback, (XtPointer)(intptr_t)$selected);
}

@proc first
{
    if (! $items || m_len($items) < 1) return;
    $selected = 0;
    update_label($);
    sync_list_selection($);
    XtCallCallbackList($, $callback, (XtPointer)(intptr_t)$selected);
}

@proc last
{
    int n = $items ? m_len($items) : 0;
    if (n < 1) return;
    $selected = n - 1;
    update_label($);
    sync_list_selection($);
    XtCallCallbackList($, $callback, (XtPointer)(intptr_t)$selected);
}

@ refresh the displayed label after items/selected were changed from Lua
@proc refresh
{
    update_label($);
}

@proc dismiss
{
    close_popup($);
}

@ select an item by zero-based index; params[0] is the index
@proc select_index
{
    if (! num_params || ! params || ! params[0]) return;
    int idx = atoi(params[0]);
    if (idx < 0 || idx >= m_len($items)) return;
    $selected = idx;
    update_label($);
    close_popup($);
    XtCallCallbackList($, $callback, (XtPointer)(intptr_t)$selected);
}

@UTILITIES

@proc void focus_self($)
{
    Widget shell = $, parent = $;
    while (parent) {
        if (XtIsShell(shell = parent)) break;
        parent = XtParent(parent);
    }
    if (shell) {
        XtSetKeyboardFocus(shell, $);
        $hasFocus = True;
        draw_arrow($);
    }
}

@proc void draw_arrow($)
{
    if (!XtIsRealized($)) return;
    Display *dpy = XtDisplay($);
    Window win = XtWindow($);
    GC gc = DefaultGC(dpy, DefaultScreen(dpy));
    XSetForeground(dpy, gc, $fg_norm);

    int cx = (int)$width - 10;
    int cy = (int)$height / 2;
    XPoint pts[3];
    pts[0].x = (short)(cx - 4); pts[0].y = (short)(cy - 2);
    pts[1].x = (short)(cx + 4); pts[1].y = (short)(cy - 2);
    pts[2].x = (short)cx;       pts[2].y = (short)(cy + 3);
    XFillPolygon(dpy, win, gc, pts, 3, Convex, CoordModeOrigin);

    if ($hasFocus && (int)$width > 1 && (int)$height > 1) {
        XSetForeground(dpy, gc, $focus_ring);
        XDrawRectangle(dpy, win, gc, 0, 0,
                       (int)$width - 1, (int)$height - 1);
    }
}

@proc void update_label($)
{
    if ($updating_label) return;
    $updating_label = True;
    const char *text = $placeholder ? $placeholder : "";
    if ($items && $selected >= 0 && $selected < m_len($items))
        text = STR($items, $selected);
    XtVaSetValues($, XtNlabel, text, NULL);
    $updating_label = False;
}

@ keep the popup list in sync when the combo's own key actions move the
  selection while the popup is open
@proc void sync_list_selection($)
{
    if ($entry_mode && $list)
        XtVaSetValues($list, "selected", $selected, NULL);
}

@proc void free_catcher($)
{
    if ($catcher != None) {
        Display *dpy = XtDisplay($);
        XtUnregisterDrawable(dpy, $catcher);
        XDestroyWindow(dpy, $catcher);
        $catcher = None;
    }
}

@proc void make_catcher($)
{
    Display *dpy = XtDisplay($);
    free_catcher($);

    Widget top = $;
    while (top && !XtIsShell(top)) top = XtParent(top);

    Position tx = 0, ty = 0;
    int cw = WidthOfScreen(XtScreen($));
    int ch = HeightOfScreen(XtScreen($));
    if (top) {
        XtTranslateCoords(top, 0, 0, &tx, &ty);
        if ((int)top->core.width > 0) cw = (int)top->core.width;
        if ((int)top->core.height > 0) ch = (int)top->core.height;
    }

    XSetWindowAttributes a;
    memset(&a, 0, sizeof a);
    a.override_redirect = True;
    a.event_mask = ButtonPressMask | ButtonReleaseMask;
    $catcher = XCreateWindow(dpy, DefaultRootWindow(dpy),
                             (int)tx, (int)ty, (unsigned)cw, (unsigned)ch, 0,
                             0, InputOnly, CopyFromParent,
                             CWOverrideRedirect | CWEventMask, &a);
    XMapRaised(dpy, $catcher);
    XtRegisterDrawable(dpy, $catcher, $shell);
}

@proc catcher_event(Widget w, $, XEvent *ev, Boolean *cont)
{
    if (ev->type != ButtonPress) return;
    if ($catcher == None) return;
    if (ev->xbutton.window == $catcher) close_popup($);
}

@proc void open_popup($)
{
    if ($entry_mode) return;
    if (! $items || m_len($items) < 1) return;

    if ($shell) {
        XtDestroyWidget($shell);
        $shell = NULL;
        $list = NULL;
    }

    $shell = XtCreatePopupShell("combo_shell", overrideShellWidgetClass,
                                $, NULL, 0);
    XtAddEventHandler($shell, ButtonPressMask, False,
                      (XtEventHandler) catcher_event, (XtPointer)$);

    int n = m_len($items);
    int visible = $linesHeight > 0 ? $linesHeight : 8;
    if (visible > n) visible = n;
    if (visible < 1) visible = 1;

    $list = XtVaCreateManagedWidget("combo_list", wListViewWidgetClass, $shell,
                                    "rows", $items,
                                    "selected", $selected,
                                    "columnCount", 1,
                                    "showHeader", False,
                                    "gridLines", False,
                                    "alternateRows", False,
                                    "allowHoriz", False,
                                    "allowVert", True,
                                    "visibleRows", visible,
                                    "borderWidth", 0,
                                    NULL);
    XtAddCallback($list, "notify", (XtCallbackProc) list_notify_cb, (XtPointer)$);
    XtAddCallback($list, "clicked", (XtCallbackProc) list_clicked_cb, (XtPointer)$);
    XtAddCallback($list, "activate", (XtCallbackProc) list_activate_cb, (XtPointer)$);
    XtAddEventHandler($list, KeyPressMask, False,
                      (XtEventHandler) list_key_event, (XtPointer)$);

    Dimension ch = 0;
    XtVaGetValues($, XtNheight, &ch, NULL);
    int rx = 0, ry = 0;
    Window child_win = None;
    XTranslateCoordinates(XtDisplay($), XtWindow($),
                          DefaultRootWindow(XtDisplay($)),
                          0, (int)ch + 2, &rx, &ry, &child_win);
    XtRealizeWidget($shell);

    XtWidgetGeometry req, pref;
    memset(&req, 0, sizeof req);
    pref.request_mode = 0;
    XtQueryGeometry($list, &req, &pref);
    int h = (pref.request_mode & CWHeight) ? (int)pref.height : (int)$list->core.height;
    if (h < 1) h = 1;

    XtResizeWidget($shell, $width, (Dimension)h, 0);
    XtVaSetValues($shell, XtNx, (int)rx, XtNy, (int)ry, NULL);
    make_catcher($);
    XtPopup($shell, XtGrabNone);
    XRaiseWindow(XtDisplay($), XtWindow($shell));
    $entry_mode = 1;
}

@proc void close_popup($)
{
    if (! $entry_mode) return;
    free_catcher($);
    if ($commit_timer) { XtRemoveTimeOut($commit_timer); $commit_timer = 0; }
    if ($shell) {
        XtPopdown($shell);
        XtDestroyWidget($shell);
        $shell = NULL;
        $list = NULL;
    }
    $entry_mode = 0;
    $commit_pending = False;
}

@proc void commit_selected($)
{
    if (! $entry_mode) return;
    int idx = $selected;
    $commit_pending = False;
    $commit_timer = 0;
    close_popup($);
    XtCallCallbackList($, $callback, (XtPointer)(intptr_t)idx);
}

@proc void commit_index($, int idx)
{
    int n = $items ? m_len($items) : 0;
    if (idx < 0 || idx >= n) return;
    $selected = idx;
    update_label($);
    if ($commit_pending) return;
    $commit_pending = True;
    $commit_timer = XtAppAddTimeOut(XtWidgetToApplicationContext($), 0,
                                    (XtTimerCallbackProc) commit_timeout,
                                    (XtPointer)$);
}

@proc void commit_timeout(XtPointer client, XtIntervalId *id)
{
    (void)id;
    commit_selected((Widget)client);
}

@proc void list_notify_cb(Widget w, $, void *class_data)
{
    (void)w;
    int idx = (int)(intptr_t)class_data;
    int n = $items ? m_len($items) : 0;
    if (idx >= 0 && idx < n) {
        $selected = idx;
        update_label($);
    }
}

@proc void list_clicked_cb(Widget w, $, void *class_data)
{
    (void)w;
    commit_index($, (int)(intptr_t)class_data);
}

@proc void list_activate_cb(Widget w, $, void *class_data)
{
    (void)w;
    commit_index($, (int)(intptr_t)class_data);
}

@proc void list_key_event(Widget w, $, XEvent *ev, Boolean *cont)
{
    (void)w;
    if (ev->type != KeyPress) return;
    if (XLookupKeysym(&ev->xkey, 0) == XK_Escape) {
        close_popup($);
        if (cont) *cont = False;
    }
}

@IMPORTS
@incl <X11/Shell.h>
@incl <X11/StringDefs.h>
@incl <X11/Intrinsic.h>
@incl <X11/keysym.h>
@incl <X11/Xft/Xft.h>
@incl <string.h>
@incl <stdlib.h>
@incl "mls.h"
@incl "retex.h"
@incl "backend.h"
@incl "theme.h"
@incl "xtcw/WListView.h"
