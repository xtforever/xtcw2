@class Wtext(Wlabel)
@  Text Anzeige - Now a wrapper around Wlabel (re-tex)

@EXPORTS
@incl "util.h"

@PUBLIC
@var String text = NULL
@var String family = <String> "Sans"
@var int sizeSmall  = 8 
@var int sizeMedium = 14
@var int sizeLarge  = 20
@var int sizeHuge   = 38

@PRIVATE 

@METHODS
@proc initialize
{
    if ($text) {
        /* Copy text to label */
        XtFree($label_mem); /* Free existing (from Wlabel init) */
        $label = $label_mem = XtNewString($text);
    }
    /* Map family to fontFace */
    if ($family) {
        $fontFace = $family;
    }
    /* Map sizeMedium to fontSize (default) */
    $fontSize = $sizeMedium;
}

@proc set_values
{  
    int redraw_flag = 0;
    if ($text != $old$text) {
        XtFree($label_mem);
        $label = $label_mem = XtNewString($text);
        redraw_flag = 1;
    }
    if ($family != $old$family) {
        $fontFace = $family;
        redraw_flag = 1;
    }
    
    /* Check sizes? Just use sizeMedium for now as main size */
    if ($sizeMedium != $old$sizeMedium) {
        $fontSize = $sizeMedium;
        redraw_flag = 1;
    }

    if (redraw_flag) {
        $dirty = 1;
    }
    return True; /* re-expose */
}

@IMPORTS
@incl "util.h"
@incl "xutil.h"