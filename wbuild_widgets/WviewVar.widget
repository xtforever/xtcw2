@class WviewVar ( Wlabel )

@public
@var String varname  = <String> ""

@private
@var XrmQuark qvar
@var String prefix

@methods
@proc initialize
{
        if( !$varname || !*$varname ) {
            fprintf(stderr, "FATAL: WviewVar widget '%s' requires a non-empty 'varname' resource\n", XtName($));
            exit(1);
        }
        if( !mv_is_initialized() ) {
            fprintf(stderr, "FATAL: WviewVar widget '%s' requires the micro-vars system (call mv_init())\n", XtName($));
            exit(1);
        }
        $qvar = XrmStringToQuark( $varname );
        char *s = $label;
        if (!s) s = $name;
        $prefix = XtNewString(s);
        
        mv_onwrite( $qvar, do_update, $, 0 );
        do_update($, NULL, NULL); 
}

@proc destroy
{
    XtFree($prefix);
}

@utilities

@proc do_update($, void*d, void*d2)
{
        int val = *mv_var( $qvar );
        char buf[256];
        snprintf(buf, sizeof(buf), "%s\n%d", $prefix, val);
        
        /* Update label using XtSetValues to trigger Wlabel's update logic */
        Arg args[1];
        XtSetArg(args[0], XtNlabel, buf);
        XtSetValues($, args, 1);
}

@imports
@incl "xutil.h"
@incl "mls.h"
@incl "micro_vars.h"