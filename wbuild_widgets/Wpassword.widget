@class Wpassword (Wedit)
@ Password input with hidden text

@PUBLIC
@var <Callback> XtCallbackList callback = NULL

@PRIVATE
@var String display_text

@METHODS 
@proc initialize
{
    $display_text = "";
    TRACE(2,"Wpassword:%s initialized", $name);
}

@TRANSLATIONS
@trans   <Key>Return: submit()

@ACTIONS

@proc submit
{
    XtCallCallbackList( $, $callback, event );
}

@EXPORTS
@proc String wpassword_get_text($)
{
    return $label;
}

@IMPORTS
@incl "mls.h"
@incl <X11/Xft/Xft.h>
@incl "converters-xft.h"
