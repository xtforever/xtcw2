@class Wbutton (Wlabel)
@ simple Button with Wheel Support 

@METHODS 
@proc initialize
{
        TRACE(2,"Wbutton:%s focus group: %s", $name, $focus_group );
        /* Controls use the button_* colour roles and the shared UI font. */
        $useControlColors = True;
        wheel_colors_changed($);
        wtooltip_set($, $tooltip);
}

@proc destroy
{
        wtooltip_unregister($);
        if ($para_ptr) { retex_paragraph_free((RetexParagraph*)$para_ptr); $para_ptr = NULL; }
        if ($backend_ptr) {
                Backend *be = (Backend*)$backend_ptr;
                be->destroy(be);
                $backend_ptr = NULL;
        }
        XtFree($label_mem); $label_mem = NULL;
        theme_unregister($);
}

@proc exec_command
{
  Cardinal null;
  if( cmd == WHEEL_FIRE ) {
    if( $state == STATE_SELECTED ) { notify($, NULL,NULL, &null ); return 1; }
  }
  
  return 0;
}


@TRANSLATIONS
@trans   <EnterWindow>: highlight()
@trans   <LeaveWindow>: reset()
@trans   <BtnDown>:     notify()

@ACTIONS

@proc highlight
{
  if( $state == STATE_SELECTED ) return;
  $state = STATE_SELECTED;
  $expose($,NULL,NULL);
}

@proc reset
{
  if( $state == STATE_NORMAL ) return;
  $state = STATE_NORMAL;
  $expose($,NULL,NULL);
}

@proc notify
{
  XtCallCallbackList( $, $callback, event );
}

@IMPORTS
@incl "mls.h"
@incl <X11/Xft/Xft.h>
@incl "converters-xft.h"
@incl "tooltip.h"
@incl "theme.h"
@incl "retex.h"
@incl "backend.h"
