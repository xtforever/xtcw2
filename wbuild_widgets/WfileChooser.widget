@class WfileChooser (Gridbox)
@ A file chooser built on WListView: directory navigation, filter and icons.

@PUBLIC
@ directory shown in the list (updated when navigating)
@var String directory = <String> "."
@ file filter pattern, e.g. "*" or "*.txt"
@var String pattern = <String> "*"
@ show dot files
@var Boolean showHidden = False
@ allow the current directory itself to be accepted
@var Boolean selectDirs = False
@ optional icons (SVG or XPM); empty = text-only Name column
@var String folderIcon = <String> ""
@var String fileIcon = <String> ""
@ last accepted path (valid until the next selection)
@var String selectedPath = <String> ""
@ called with the full path on OK / double-click
@var <Callback> XtCallbackList accept = NULL
@ called when Cancel is pressed
@var <Callback> XtCallbackList cancel = NULL

@PRIVATE
@type fent_t = struct {
  char *name;
  int isdir;
  long long size;
  long mtime;
}

@var Widget dir_label
@var Widget up_btn
@var Widget home_btn
@var Widget filter_ed
@var Widget hidden_toggle
@var Widget refresh_btn
@var Widget list
@var Widget ok_btn
@var Widget cancel_btn
@var int rows
@var char *dir_mem
@var char *selected_mem

@METHODS

@proc class_initialize
{
  m_init();
  converters_init();
}

@proc initialize
{
  $rows = 0;
  $dir_mem = NULL;
  $selected_mem = NULL;

  XtVaSetValues($, "defaultDistance", 4, NULL);
  do_layout($);

  if ($directory && *$directory)
    set_directory($, $directory);
  else {
    char cwd[4096];
    if (getcwd(cwd, sizeof(cwd))) set_directory($, cwd);
  }
  refresh($);
}

@proc destroy
{
  if ($rows) { m_free_strings($rows, 0); $rows = 0; }
  free($dir_mem); $dir_mem = NULL;
  free($selected_mem); $selected_mem = NULL;
}

@proc set_values
{
  int redraw = 0;
  if ($directory != $old$directory) {
    set_directory($, $directory ? $directory : ".");
    redraw = 1;
  }
  if ($pattern != $old$pattern || $showHidden != $old$showHidden) {
    refresh($);
    redraw = 1;
  }
  if ($selectedPath != $old$selectedPath) {
    free($selected_mem);
    $selected_mem = $selectedPath ? strdup($selectedPath) : NULL;
    if ($selected_mem) $selectedPath = $selected_mem;
    redraw = 1;
  }
  return redraw;
}

@UTILITIES

@proc void do_layout($)
{
  $dir_label = XtVaCreateManagedWidget("dir", wlabelWidgetClass, $,
      "label", ".",
      "gridx", 0, "gridy", 0, "gridWidth", 3,
      "weightx", 1, "weighty", 0, "fill", 3, NULL);

  $up_btn = XtVaCreateManagedWidget("up", wbuttonWidgetClass, $,
      "label", "Up",
      "gridx", 3, "gridy", 0, "weightx", 0, "weighty", 0, "fill", 3, NULL);
  XtAddCallback($up_btn, "callback", (XtCallbackProc)up_cb, $);

  $home_btn = XtVaCreateManagedWidget("home", wbuttonWidgetClass, $,
      "label", "Home",
      "gridx", 4, "gridy", 0, "weightx", 0, "weighty", 0, "fill", 3, NULL);
  XtAddCallback($home_btn, "callback", (XtCallbackProc)home_cb, $);

  $filter_ed = XtVaCreateManagedWidget("filter", weditWidgetClass, $,
      "label", "*",
      "gridx", 0, "gridy", 1, "gridWidth", 3,
      "weightx", 1, "weighty", 0, "fill", 1,
      "fontName", "Sans-13", "height", 26, NULL);
  XtAddCallback($filter_ed, "callback", (XtCallbackProc)filter_cb, $);

  $hidden_toggle = XtVaCreateManagedWidget("hidden", wcheckboxWidgetClass, $,
      "label", "Hidden",
      "gridx", 3, "gridy", 1, "weightx", 0, "weighty", 0, "fill", 1, NULL);
  XtAddCallback($hidden_toggle, "callback", (XtCallbackProc)hidden_cb, $);

  $refresh_btn = XtVaCreateManagedWidget("refresh", wbuttonWidgetClass, $,
      "label", "Refresh",
      "gridx", 4, "gridy", 1, "weightx", 0, "weighty", 0, "fill", 1, NULL);
  XtAddCallback($refresh_btn, "callback", (XtCallbackProc)refresh_cb, $);

  $list = XtVaCreateManagedWidget("list", wListViewWidgetClass, $,
      "gridx", 0, "gridy", 2, "gridWidth", 5,
      "weightx", 1, "weighty", 1, "fill", 3,
      "columnCount", 4,
      "columnTitles", "Name\tSize\tDate\tType",
      "columnWidths", 0,
      "columnAligns", 0,
      "columnKinds", 0,
      "visibleRows", 12,
      "showHeader", 1,
      "gridLines", 1,
      "alternateRows", 1,
      NULL);
  XtAddCallback($list, "activate", (XtCallbackProc)list_activate_cb, $);

  $ok_btn = XtVaCreateManagedWidget("ok", wbuttonWidgetClass, $,
      "label", "OK",
      "gridx", 3, "gridy", 3, "weightx", 0, "weighty", 0, "fill", 3, NULL);
  XtAddCallback($ok_btn, "callback", (XtCallbackProc)ok_cb, $);

  $cancel_btn = XtVaCreateManagedWidget("cancel", wbuttonWidgetClass, $,
      "label", "Cancel",
      "gridx", 4, "gridy", 3, "weightx", 0, "weighty", 0, "fill", 3, NULL);
  XtAddCallback($cancel_btn, "callback", (XtCallbackProc)cancel_cb, $);

  /* Initial list configuration: weighted Name column, fixed others. */
  {
    int widths[4] = { 0, 90, 150, 80 };
    int aligns[4] = { 0, 2, 0, 0 };
    int kinds[4] = { 2, 0, 0, 0 };
    int wl = m_create(4, sizeof(int));
    int al = m_create(4, sizeof(int));
    int kd = m_create(4, sizeof(int));
    int i;
    for (i = 0; i < 4; i++) {
      m_put(wl, &widths[i]);
      m_put(al, &aligns[i]);
      m_put(kd, &kinds[i]);
    }
    XtVaSetValues($list, "columnWidths", wl, "columnAligns", al,
                  "columnKinds", kd, NULL);
  }
}

@proc void refresh($)
{
  int newrows = build_rows($);
  int old = $rows;
  $rows = newrows;
  XtVaSetValues($list, "rows", $rows, NULL);
  if (old) m_free_strings(old, 0);
  if ($dir_label)
    XtVaSetValues($dir_label, "label", $dir_mem ? $dir_mem : ".", NULL);
}

@proc void set_directory($, const char *path)
{
  char resolved[4096];

  if (!path || !*path) return;
  if (!realpath(path, resolved)) {
    strncpy(resolved, path, sizeof(resolved) - 1);
    resolved[sizeof(resolved) - 1] = 0;
  }
  free($dir_mem);
  $dir_mem = strdup(resolved);
  $directory = $dir_mem;
  if ($dir_label) XtVaSetValues($dir_label, "label", $dir_mem, NULL);
  refresh($);
}

@proc void set_selected($, const char *path)
{
  free($selected_mem);
  $selected_mem = path ? strdup(path) : NULL;
  $selectedPath = $selected_mem ? $selected_mem : "";
}

@proc void go_up($)
{
  char buf[4096];
  char *slash;
  if (!$dir_mem) return;
  strncpy(buf, $dir_mem, sizeof(buf) - 1);
  buf[sizeof(buf) - 1] = 0;
  slash = strrchr(buf, '/');
  if (!slash) return;
  if (slash == buf) slash[1] = 0;
  else *slash = 0;
  set_directory($, buf);
}

@proc void go_home($)
{
  const char *home = getenv("HOME");
  set_directory($, (home && *home) ? home : "/");
}

@proc int fent_cmp(const void *va, const void *vb)
{
  const fent_t *a = (const fent_t*)va;
  const fent_t *b = (const fent_t*)vb;
  if (a->isdir != b->isdir) return a->isdir ? -1 : 1;
  return strcasecmp(a->name, b->name);
}

@proc void size_str(long long n, char *buf, int bufsz)
{
  if (n < 1024) snprintf(buf, (size_t)bufsz, "%lld B", n);
  else if (n < 1024LL * 1024) snprintf(buf, (size_t)bufsz, "%lld KB", n / 1024);
  else if (n < 1024LL * 1024 * 1024)
    snprintf(buf, (size_t)bufsz, "%.1f MB", (double)n / (1024.0 * 1024.0));
  else
    snprintf(buf, (size_t)bufsz, "%.1f GB", (double)n / (1024.0 * 1024.0 * 1024.0));
}

@proc void type_str(const char *name, int isdir, char *buf, int bufsz)
{
  const char *dot;
  if (isdir) { snprintf(buf, (size_t)bufsz, "dir"); return; }
  dot = strrchr(name, '.');
  if (dot && dot[1]) snprintf(buf, (size_t)bufsz, "%s", dot + 1);
  else snprintf(buf, (size_t)bufsz, "file");
}

@proc void date_str(long mtime, char *buf, int bufsz)
{
  time_t t = (time_t)mtime;
  struct tm *tm = localtime(&t);
  if (tm) strftime(buf, (size_t)bufsz, "%Y-%m-%d %H:%M", tm);
  else snprintf(buf, (size_t)bufsz, "-");
}

@proc int build_rows($)
{
  DIR *d;
  struct dirent *de;
  fent_t *ents = NULL;
  int n = 0, cap = 0, i;
  int newrows;
  const char *pat = ($pattern && *$pattern) ? $pattern : "*";

  if (!$dir_mem) return 0;
  d = opendir($dir_mem);
  if (!d) {
    newrows = m_create(1, sizeof(char*));
    {
      char *s = strdup("(cannot open directory)");
      m_put(newrows, &s);
    }
    return newrows;
  }

  while ((de = readdir(d)) != NULL) {
    char full[4096];
    struct stat st;
    int isdir = 0;
    int take = 1;

    if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
    if (!$showHidden && de->d_name[0] == '.') continue;

    snprintf(full, sizeof(full), "%s/%s", $dir_mem, de->d_name);
    if (stat(full, &st) == 0) {
      isdir = S_ISDIR(st.st_mode) ? 1 : 0;
    }
    if (!isdir && strcmp(pat, "*") != 0 && fnmatch(pat, de->d_name, 0) != 0)
      take = 0;
    if (!take) continue;

    if (n == cap) {
      int nc = cap ? cap * 2 : 64;
      fent_t *ne = (fent_t*)realloc(ents, (size_t)nc * sizeof(fent_t));
      if (!ne) break;
      ents = ne;
      cap = nc;
    }
    ents[n].name = strdup(de->d_name);
    ents[n].isdir = isdir;
    ents[n].size = (long long)st.st_size;
    ents[n].mtime = (long)st.st_mtime;
    n++;
  }
  closedir(d);

  if (n > 1)
    qsort(ents, (size_t)n, sizeof(fent_t), fent_cmp);

  newrows = m_create(n > 0 ? n : 1, sizeof(char*));
  for (i = 0; i < n; i++) {
    char namecell[8192];
    char sz[64];
    char dt[64];
    char ty[128];
    char *row;

    if (ents[i].isdir) {
      if ($folderIcon && *$folderIcon)
        snprintf(namecell, sizeof(namecell), "@%s|%s", $folderIcon, ents[i].name);
      else
        snprintf(namecell, sizeof(namecell), "%s", ents[i].name);
      snprintf(sz, sizeof(sz), "-");
    } else {
      if ($fileIcon && *$fileIcon)
        snprintf(namecell, sizeof(namecell), "@%s|%s", $fileIcon, ents[i].name);
      else
        snprintf(namecell, sizeof(namecell), "%s", ents[i].name);
      size_str(ents[i].size, sz, sizeof(sz));
    }
    date_str(ents[i].mtime, dt, sizeof(dt));
    type_str(ents[i].name, ents[i].isdir, ty, sizeof(ty));

    {
      size_t need = strlen(namecell) + strlen(sz) + strlen(dt) + strlen(ty) + 4;
      row = (char*)malloc(need);
      if (row) snprintf(row, need, "%s\t%s\t%s\t%s", namecell, sz, dt, ty);
    }
    if (row) m_put(newrows, &row);
  }

  for (i = 0; i < n; i++) free(ents[i].name);
  free(ents);
  return newrows;
}

@proc void row_name($, int row, char *out, int outsz)
{
  char *s;
  if (!out || outsz <= 0) return;
  out[0] = 0;
  if ($rows && row >= 0 && row < m_len($rows)) s = STR($rows, row);
  else s = "";
  if (s[0] == '@') {
    char *bar = strchr(s, '|');
    if (bar) s = bar + 1;
    else s++;
  }
  {
    char *tab = strchr(s, '\t');
    int len = tab ? (int)(tab - s) : (int)strlen(s);
    if (len > outsz - 1) len = outsz - 1;
    memcpy(out, s, (size_t)len);
    out[len] = 0;
  }
}

@proc void activate_row($, int row)
{
  char name[4096];
  char path[4096];
  struct stat st;

  row_name($, row, name, sizeof(name));
  if (!name[0] || !$dir_mem) return;
  snprintf(path, sizeof(path), "%s/%s", $dir_mem, name);

  if (stat(path, &st) == 0 && S_ISDIR(st.st_mode)) {
    set_directory($, path);
  } else {
    set_selected($, path);
    XtCallCallbackList($, $accept, (XtPointer)$selected_mem);
  }
}

@proc void list_activate_cb(Widget w, $, void *d)
{
  (void)w;
  activate_row($, (int)(intptr_t)d);
}

@proc void up_cb(Widget w, $, void *d)
{
  (void)w; (void)d;
  go_up($);
}

@proc void home_cb(Widget w, $, void *d)
{
  (void)w; (void)d;
  go_home($);
}

@proc void refresh_cb(Widget w, $, void *d)
{
  (void)w; (void)d;
  refresh($);
}

@proc void filter_cb(Widget w, $, void *d)
{
  char *s = NULL;
  (void)w; (void)d;
  XtVaGetValues($filter_ed, "label", &s, NULL);
  if (s) $pattern = s;
  refresh($);
}

@proc void hidden_cb(Widget w, $, void *d)
{
  Boolean b = False;
  (void)w; (void)d;
  XtVaGetValues($hidden_toggle, "checked", &b, NULL);
  $showHidden = b;
  refresh($);
}

@proc void ok_cb(Widget w, $, void *d)
{
  int sel = -1;
  (void)w; (void)d;
  XtVaGetValues($list, "selected", &sel, NULL);
  if (sel >= 0) {
    activate_row($, sel);
  } else if ($selectDirs && $dir_mem) {
    set_selected($, $dir_mem);
    XtCallCallbackList($, $accept, (XtPointer)$selected_mem);
  }
}

@proc void cancel_cb(Widget w, $, void *d)
{
  (void)w; (void)d;
  XtCallCallbackList($, $cancel, NULL);
}

@IMPORTS
@incl <X11/Intrinsic.h>
@incl <X11/StringDefs.h>
@incl <stdlib.h>
@incl <stdio.h>
@incl <string.h>
@incl <strings.h>
@incl <stdint.h>
@incl <unistd.h>
@incl <dirent.h>
@incl <sys/stat.h>
@incl <fnmatch.h>
@incl <time.h>
@incl "mls.h"
@incl "converters.h"
@incl "xtcw/Wlabel.h"
@incl "xtcw/Wbutton.h"
@incl "xtcw/Wedit.h"
@incl "xtcw/Wcheckbox.h"
@incl "xtcw/WListView.h"
