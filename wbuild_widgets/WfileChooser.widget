@ Layout follows dialog-guide.md sections 9.3/15.3: toolbar, scrolling list,
@ stable status line and a right-aligned action bar with one accent primary.
@class WfileChooser (Gridbox)
@ A file chooser built on WListView: directory navigation, filter and icons.

@PUBLIC
@ directory shown in the list (updated when navigating)
@var String directory = <String> "."
@ file filter pattern, e.g. "*" or "*.txt"
@var String pattern = <String> "*"
@ show dot files
@var Boolean showHidden = False
@ allow the current directory itself to be accepted
@var Boolean selectDirs = False
@ optional icons (SVG or XPM); empty = text-only Name column
@var String folderIcon = <String> ""
@var String fileIcon = <String> ""
@ last accepted path (valid until the next selection)
@var String selectedPath = <String> ""
@ called with the full path on Open / double-click
@var <Callback> XtCallbackList accept = NULL
@ called when Cancel is pressed
@var <Callback> XtCallbackList cancel = NULL

@PRIVATE
@type fent_t = struct {
  char *name;
  int isdir;
  long long size;
  long mtime;
}

@var Widget dir_label
@var Widget up_btn
@var Widget home_btn
@var Widget filter_label
@var Widget filter_ed
@var Widget hidden_toggle
@var Widget refresh_btn
@var Widget list
@var Widget status
@var Widget ok_btn
@var Widget cancel_btn
@var int rows
@ Owned names parallel to rows (real names, not the display-escaped cells).
@var int names
@ Owned column model arrays passed to WListView (it reads them on relayout).
@var int col_widths_mem
@var int col_aligns_mem
@var int col_kinds_mem
@var char *dir_mem
@var char *selected_mem
@ Owned copies of borrowed String resources used after creation.
@var char *pattern_mem
@var char *folder_mem
@var char *file_mem

@METHODS

@proc class_initialize
{
  m_init();
  converters_init();
}

@proc initialize
{
  $rows = 0;
  $names = 0;
  $col_widths_mem = 0;
  $col_aligns_mem = 0;
  $col_kinds_mem = 0;
  $dir_mem = NULL;
  $selected_mem = NULL;
  $pattern_mem = strdup($pattern ? $pattern : "*");
  $pattern = $pattern_mem;
  $folder_mem = strdup($folderIcon ? $folderIcon : "");
  $folderIcon = $folder_mem;
  $file_mem = strdup($fileIcon ? $fileIcon : "");
  $fileIcon = $file_mem;

  XtVaSetValues($, "defaultDistance", theme_metric("window_margin", 16), NULL);
  do_layout($);

  if ($directory && *$directory)
    set_directory($, $directory);
  else {
    char cwd[4096];
    if (getcwd(cwd, sizeof(cwd))) set_directory($, cwd);
  }
  refresh($);
}

@proc destroy
{
  if ($rows) { m_free_strings($rows, 0); $rows = 0; }
  if ($names) { m_free_strings($names, 0); $names = 0; }
  if ($col_widths_mem) { m_free($col_widths_mem); $col_widths_mem = 0; }
  if ($col_aligns_mem) { m_free($col_aligns_mem); $col_aligns_mem = 0; }
  if ($col_kinds_mem) { m_free($col_kinds_mem); $col_kinds_mem = 0; }
  free($dir_mem); $dir_mem = NULL;
  free($selected_mem); $selected_mem = NULL;
  free($pattern_mem); $pattern_mem = NULL;
  free($folder_mem); $folder_mem = NULL;
  free($file_mem); $file_mem = NULL;
}

@proc set_values
{
  int redraw = 0;
  if ($directory != $old$directory) {
    set_directory($, $directory ? $directory : ".");
    redraw = 1;
  }
  if ($pattern != $old$pattern || $folderIcon != $old$folderIcon ||
      $fileIcon != $old$fileIcon || $showHidden != $old$showHidden) {
    if ($pattern != $old$pattern) {
      free($pattern_mem);
      $pattern_mem = strdup($pattern ? $pattern : "*");
      $pattern = $pattern_mem;
    }
    if ($folderIcon != $old$folderIcon) {
      free($folder_mem);
      $folder_mem = strdup($folderIcon ? $folderIcon : "");
      $folderIcon = $folder_mem;
    }
    if ($fileIcon != $old$fileIcon) {
      free($file_mem);
      $file_mem = strdup($fileIcon ? $fileIcon : "");
      $fileIcon = $file_mem;
    }
    refresh($);
    redraw = 1;
  }
  if ($selectedPath != $old$selectedPath) {
    free($selected_mem);
    $selected_mem = $selectedPath ? strdup($selectedPath) : NULL;
    if ($selected_mem) $selectedPath = $selected_mem;
    redraw = 1;
  }
  return redraw;
}

@UTILITIES

@proc Widget root_shell($)
{
  Widget root = $;
  while (!XtIsShell(root) && XtParent(root)) root = XtParent(root);
  return root;
}

@proc void escape_handler(Widget w, $, XEvent *ev, Boolean *cont)
{
  (void)w;
  if (ev->type == KeyPress && XLookupKeysym(&ev->xkey, 0) == XK_Escape) {
    XtCallCallbackList($, $cancel, NULL);
    if (cont) *cont = False;
  }
}

@proc void add_escape_handler($, Widget w)
{
  if (w)
    XtAddEventHandler(w, KeyPressMask, False,
                      (XtEventHandler)escape_handler, $);
}

@proc void do_layout($)
{
  int gap = theme_metric("control_gap", 8);
  int agap = theme_metric("action_gap", 8);

  /* Toolbar: navigation and view toggles on the first row, path and filter on
   * the second. At the 520 px default this keeps the path readable instead of
   * clipping it between the navigation buttons and the filter. */
  {
    Widget toolbar = XtVaCreateManagedWidget("toolbar", vBoxWidgetClass, $,
        "defaultDistance", gap,
        "borderWidth", 0,
        "gridx", 0, "gridy", 0, "gridWidth", 1,
        "weightx", 1, "weighty", 0, "fill", 3, NULL);
    Widget nav = XtVaCreateManagedWidget("nav", gridboxWidgetClass, toolbar,
        "defaultDistance", gap,
        "borderWidth", 0, NULL);
    Widget pathrow = XtVaCreateManagedWidget("pathrow", gridboxWidgetClass, toolbar,
        "defaultDistance", gap,
        "borderWidth", 0, NULL);

    $up_btn = XtVaCreateManagedWidget("up", wbuttonWidgetClass, nav,
        "label", "Up",
        "gridx", 0, "gridy", 0, "weightx", 0, "weighty", 0, "fill", 1, NULL);
    XtAddCallback($up_btn, "callback", (XtCallbackProc)up_cb, $);

    $home_btn = XtVaCreateManagedWidget("home", wbuttonWidgetClass, nav,
        "label", "Home",
        "gridx", 1, "gridy", 0, "weightx", 0, "weighty", 0, "fill", 1, NULL);
    XtAddCallback($home_btn, "callback", (XtCallbackProc)home_cb, $);

    XtVaCreateManagedWidget("navSpacer", gridboxWidgetClass, nav,
        "defaultDistance", 0,
        "borderWidth", 0,
        "gridx", 2, "gridy", 0, "weightx", 1, "weighty", 0, "fill", 1, NULL);

    $hidden_toggle = XtVaCreateManagedWidget("hidden", wcheckboxWidgetClass, nav,
        "label", "Hidden",
        "checked", False,
        "gridx", 3, "gridy", 0, "weightx", 0, "weighty", 0, "fill", 1, NULL);
    XtAddCallback($hidden_toggle, "callback", (XtCallbackProc)hidden_cb, $);

    $refresh_btn = XtVaCreateManagedWidget("refresh", wbuttonWidgetClass, nav,
        "label", "Refresh",
        "gridx", 4, "gridy", 0, "weightx", 0, "weighty", 0, "fill", 1, NULL);
    XtAddCallback($refresh_btn, "callback", (XtCallbackProc)refresh_cb, $);

    $dir_label = XtVaCreateManagedWidget("dir", wlabelWidgetClass, pathrow,
        "label", ".",
        "gridx", 0, "gridy", 0, "weightx", 2, "weighty", 0, "fill", 3, NULL);

    $filter_label = XtVaCreateManagedWidget("filterLabel", wlabelWidgetClass, pathrow,
        "label", "Filter",
        "gridx", 1, "gridy", 0, "weightx", 0, "weighty", 0, "fill", 1, NULL);

    $filter_ed = XtVaCreateManagedWidget("filter", weditWidgetClass, pathrow,
        "label", "*",
        "gridx", 2, "gridy", 0, "weightx", 1, "weighty", 0, "fill", 3, NULL);
    XtAddCallback($filter_ed, "callback", (XtCallbackProc)filter_cb, $);
  }

  /* Content fills the middle. */
  $list = XtVaCreateManagedWidget("list", wListViewWidgetClass, $,
      "gridx", 0, "gridy", 1, "gridWidth", 1,
      "weightx", 1, "weighty", 1, "fill", 3,
      "columnCount", 4,
      "columnTitles", "Name\tSize\tModified\tType",
      "columnWidths", 0,
      "columnAligns", 0,
      "columnKinds", 0,
      "visibleRows", 12,
      "showHeader", 1,
      "gridLines", 1,
      "alternateRows", 1,
      NULL);
  XtAddCallback($list, "activate", (XtCallbackProc)list_activate_cb, $);

  /* Stable status/validation line. It always reserves one line of height so
   * validation and empty/error states cannot resize the dialog horizontally. */
  $status = XtVaCreateManagedWidget("status", wlabelWidgetClass, $,
      "label", " ",
      "alignment", 0,
      "borderWidth", 0,
      "useSmallFont", True,
      "gridx", 0, "gridy", 2, "gridWidth", 1,
      "weightx", 1, "weighty", 0, "fill", 3, NULL);

  /* Action bar: Cancel left of the primary Open, trailing edge. */
  {
    Widget actions = XtVaCreateManagedWidget("actions", gridboxWidgetClass, $,
        "defaultDistance", agap,
        "borderWidth", 0,
        "gridx", 0, "gridy", 3, "gridWidth", 1,
        "weightx", 1, "weighty", 0, "fill", 3, NULL);

    XtVaCreateManagedWidget("actionSpacer", gridboxWidgetClass, actions,
        "defaultDistance", 0,
        "borderWidth", 0,
        "gridx", 0, "gridy", 0, "weightx", 1, "weighty", 0, "fill", 1, NULL);

    $cancel_btn = XtVaCreateManagedWidget("cancel", wbuttonWidgetClass, actions,
        "label", "Cancel",
        "gridx", 1, "gridy", 0, "weightx", 0, "weighty", 0, "fill", 1, NULL);
    XtAddCallback($cancel_btn, "callback", (XtCallbackProc)cancel_cb, $);

    $ok_btn = XtVaCreateManagedWidget("ok", wbuttonWidgetClass, actions,
        "label", "Open", "primary", True,
        "gridx", 2, "gridy", 0, "weightx", 0, "weighty", 0, "fill", 1, NULL);
    XtAddCallback($ok_btn, "callback", (XtCallbackProc)ok_cb, $);
  }

  /* Style guide: uniform control padding on all toolbar/action buttons. */
  {
    Widget btns[6];
    int pad = theme_metric("control_padding", 6);
    int vpad = 4; /* XS from the spacing scale */
    int bi;
    btns[0] = $up_btn; btns[1] = $home_btn; btns[2] = $hidden_toggle;
    btns[3] = $refresh_btn; btns[4] = $cancel_btn; btns[5] = $ok_btn;
    for (bi = 0; bi < 6; bi++)
      XtVaSetValues(btns[bi], "leftGap", pad, "rightGap", pad,
                    "topGap", vpad, "bottomGap", vpad, NULL);
  }

  /* Initial list configuration: weighted Name column, fixed others. */
  {
    int widths[4] = { 0, 90, 170, 80 };
    int aligns[4] = { 0, 2, 0, 0 };
    int kinds[4] = { 2, 0, 0, 0 };
    int i;
    $col_widths_mem = m_create(4, sizeof(int));
    $col_aligns_mem = m_create(4, sizeof(int));
    $col_kinds_mem = m_create(4, sizeof(int));
    for (i = 0; i < 4; i++) {
      m_put($col_widths_mem, &widths[i]);
      m_put($col_aligns_mem, &aligns[i]);
      m_put($col_kinds_mem, &kinds[i]);
    }
    XtVaSetValues($list, "columnWidths", $col_widths_mem,
                  "columnAligns", $col_aligns_mem,
                  "columnKinds", $col_kinds_mem, NULL);
  }

  /* Escape is handled by the dialog, but Xt does not walk up from the focused
   * child to the composite's translation table. Install a handler on every
   * focusable child so Escape works regardless of where focus is. */
  add_escape_handler($, $up_btn);
  add_escape_handler($, $home_btn);
  add_escape_handler($, $filter_ed);
  add_escape_handler($, $hidden_toggle);
  add_escape_handler($, $refresh_btn);
  add_escape_handler($, $list);
  add_escape_handler($, $cancel_btn);
  add_escape_handler($, $ok_btn);
}

@proc void path_display(const char *path, char *out, size_t outsz)
{
  const char *home = getenv("HOME");
  const char *disp = path ? path : "";
  char tmp[4096];
  size_t hl = (home && *home) ? strlen(home) : 0;

  if (hl > 0 && strncmp(disp, home, hl) == 0 &&
      (disp[hl] == 0 || disp[hl] == '/'))
    snprintf(tmp, sizeof(tmp), "~%s", disp + hl);
  else
    snprintf(tmp, sizeof(tmp), "%s", disp);

  if (strlen(tmp) <= 60) {
    snprintf(out, outsz, "%s", tmp);
    return;
  }
  /* Middle truncation keeps both the root and the leaf readable. */
  snprintf(out, outsz, "%.24s\xE2\x80\xA6%s", tmp, tmp + strlen(tmp) - 32);
}

@proc void update_status($, int err)
{
  char msg[4096];
  const char *pat = ($pattern && *$pattern) ? $pattern : "*";
  int count = ($rows && m_len($rows) > 0) ? m_len($rows) : 0;

  if (err) {
    char shown[256];
    path_display($dir_mem, shown, sizeof(shown));
    snprintf(msg, sizeof(msg),
             "Can\xE2\x80\x99t open \xE2\x80\x9C%s\xE2\x80\x9D. Choose another folder.",
             shown);
  } else if (count == 0) {
    if (strcmp(pat, "*") != 0)
      snprintf(msg, sizeof(msg), "No files match the filter.");
    else
      snprintf(msg, sizeof(msg), "This folder is empty.");
  } else {
    snprintf(msg, sizeof(msg), " ");
  }
  if ($status) XtVaSetValues($status, "label", msg, NULL);
}

@proc void refresh($)
{
  int newnames = 0, err = 0;
  int newrows = build_rows($, &newnames, &err);
  int old = $rows;
  int oldnames = $names;
  $rows = newrows;
  $names = newnames;
  XtVaSetValues($list, "rows", $rows, "selected", -1, NULL);
  if (old) m_free_strings(old, 0);
  if (oldnames) m_free_strings(oldnames, 0);
  update_status($, err);
}

@proc void set_directory($, const char *path)
{
  char resolved[4096];

  if (!path || !*path) return;
  if (!realpath(path, resolved)) {
    strncpy(resolved, path, sizeof(resolved) - 1);
    resolved[sizeof(resolved) - 1] = 0;
  }
  free($dir_mem);
  $dir_mem = strdup(resolved);
  $directory = $dir_mem;
  if ($dir_label) {
    char shown[256];
    path_display($dir_mem, shown, sizeof(shown));
    XtVaSetValues($dir_label, "label", shown, NULL);
  }
  refresh($);
}

@proc void set_selected($, const char *path)
{
  free($selected_mem);
  $selected_mem = path ? strdup(path) : NULL;
  $selectedPath = $selected_mem ? $selected_mem : "";
}

@proc void go_up($)
{
  char buf[4096];
  char *slash;
  if (!$dir_mem) return;
  strncpy(buf, $dir_mem, sizeof(buf) - 1);
  buf[sizeof(buf) - 1] = 0;
  slash = strrchr(buf, '/');
  if (!slash) return;
  if (slash == buf) slash[1] = 0;
  else *slash = 0;
  set_directory($, buf);
}

@proc void go_home($)
{
  const char *home = getenv("HOME");
  set_directory($, (home && *home) ? home : "/");
}

@proc int fent_cmp(const void *va, const void *vb)
{
  const fent_t *a = (const fent_t*)va;
  const fent_t *b = (const fent_t*)vb;
  if (a->isdir != b->isdir) return a->isdir ? -1 : 1;
  return strcasecmp(a->name, b->name);
}

@proc void size_str(long long n, char *buf, int bufsz)
{
  if (n < 1024) snprintf(buf, (size_t)bufsz, "%lld B", n);
  else if (n < 1024LL * 1024) snprintf(buf, (size_t)bufsz, "%lld KB", n / 1024);
  else if (n < 1024LL * 1024 * 1024)
    snprintf(buf, (size_t)bufsz, "%.1f MB", (double)n / (1024.0 * 1024.0));
  else
    snprintf(buf, (size_t)bufsz, "%.1f GB", (double)n / (1024.0 * 1024.0 * 1024.0));
}

@proc void type_str(const char *name, int isdir, char *buf, int bufsz)
{
  const char *dot;
  if (isdir) { snprintf(buf, (size_t)bufsz, "dir"); return; }
  dot = strrchr(name, '.');
  if (dot && dot[1]) snprintf(buf, (size_t)bufsz, "%s", dot + 1);
  else snprintf(buf, (size_t)bufsz, "file");
}

@proc void date_str(long mtime, char *buf, int bufsz)
{
  time_t t = (time_t)mtime;
  struct tm *tm = localtime(&t);
  if (tm) strftime(buf, (size_t)bufsz, "%Y-%m-%d %H:%M", tm);
  else snprintf(buf, (size_t)bufsz, "-");
}

@proc void display_name(const char *name, int has_icon, char *out, int outsz)
{
  int i, o = 0;
  if (!out || outsz <= 0) return;
  /* A leading '@' is WListView's icon marker. Without an icon prefix, keep a
   * leading space so a real filename like "@notes.txt" is not parsed as one. */
  if (!has_icon && name[0] == '@' && o < outsz - 1) out[o++] = ' ';
  for (i = 0; name[i] && o < outsz - 1; i++) {
    unsigned char c = (unsigned char)name[i];
    if (c == '\t' || c == '\n' || c == '\r') c = ' ';
    out[o++] = (char)c;
  }
  out[o] = 0;
}

@proc int build_rows($, int *names_out, int *err_out)
{
  DIR *d;
  struct dirent *de;
  fent_t *ents = NULL;
  int n = 0, cap = 0, i;
  int newrows, newnames;
  const char *pat = ($pattern && *$pattern) ? $pattern : "*";

  *names_out = 0;
  *err_out = 0;
  if (!$dir_mem) {
    *names_out = m_create(1, sizeof(char*));
    return m_create(1, sizeof(char*));
  }
  d = opendir($dir_mem);
  if (!d) {
    *err_out = 1;
    *names_out = m_create(1, sizeof(char*));
    return m_create(1, sizeof(char*));
  }

  while ((de = readdir(d)) != NULL) {
    char full[8192];
    struct stat st;
    int isdir = 0;
    int have_stat;
    int take = 1;

    if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
    if (!$showHidden && de->d_name[0] == '.') continue;

    snprintf(full, sizeof(full), "%s/%s", $dir_mem, de->d_name);
    have_stat = (stat(full, &st) == 0);
    if (have_stat) isdir = S_ISDIR(st.st_mode) ? 1 : 0;
    if (!isdir && strcmp(pat, "*") != 0 && fnmatch(pat, de->d_name, 0) != 0)
      take = 0;
    if (!take) continue;

    if (n == cap) {
      int nc = cap ? cap * 2 : 64;
      fent_t *ne = (fent_t*)realloc(ents, (size_t)nc * sizeof(fent_t));
      if (!ne) break;
      ents = ne;
      cap = nc;
    }
    ents[n].name = strdup(de->d_name);
    ents[n].isdir = isdir;
    ents[n].size = have_stat ? (long long)st.st_size : 0;
    ents[n].mtime = have_stat ? (long)st.st_mtime : 0;
    n++;
  }
  closedir(d);

  if (n > 1)
    qsort(ents, (size_t)n, sizeof(fent_t), fent_cmp);

  newrows = m_create(n > 0 ? n : 1, sizeof(char*));
  newnames = m_create(n > 0 ? n : 1, sizeof(char*));
  for (i = 0; i < n; i++) {
    char disp[8192];
    char namecell[16384];
    char sz[64];
    char dt[64];
    char ty[128];
    char *row;
    char *nm;
    int has_icon;

    has_icon = ents[i].isdir ? ($folderIcon && *$folderIcon)
                             : ($fileIcon && *$fileIcon);
    display_name(ents[i].name, has_icon, disp, sizeof(disp));

    if (has_icon)
      snprintf(namecell, sizeof(namecell), "@%s|%s",
               ents[i].isdir ? $folderIcon : $fileIcon, disp);
    else
      snprintf(namecell, sizeof(namecell), "%s", disp);

    if (ents[i].isdir) snprintf(sz, sizeof(sz), "-");
    else size_str(ents[i].size, sz, sizeof(sz));
    date_str(ents[i].mtime, dt, sizeof(dt));
    type_str(ents[i].name, ents[i].isdir, ty, sizeof(ty));

    nm = strdup(ents[i].name);
    if (nm) m_put(newnames, &nm);

    {
      size_t need = strlen(namecell) + strlen(sz) + strlen(dt) + strlen(ty) + 4;
      row = (char*)malloc(need);
      if (row) snprintf(row, need, "%s\t%s\t%s\t%s", namecell, sz, dt, ty);
    }
    if (row) m_put(newrows, &row);
  }

  for (i = 0; i < n; i++) free(ents[i].name);
  free(ents);
  *names_out = newnames;
  return newrows;
}

@proc void row_name($, int row, char *out, int outsz)
{
  char *s;
  if (!out || outsz <= 0) return;
  out[0] = 0;
  if ($names && row >= 0 && row < m_len($names)) s = STR($names, row);
  else s = "";
  snprintf(out, (size_t)outsz, "%s", s);
}

@proc void accept_path($, const char *path)
{
  set_selected($, path);
  XtCallCallbackList($, $accept, (XtPointer)$selected_mem);
}

@proc void accept_current($)
{
  int sel = -1;
  XtVaGetValues($list, "selected", &sel, NULL);

  if (sel >= 0) {
    char name[4096];
    char path[8192];
    struct stat st;

    row_name($, sel, name, sizeof(name));
    if (!name[0] || !$dir_mem) return;
    snprintf(path, sizeof(path), "%s/%s", $dir_mem, name);

    if (stat(path, &st) == 0 && S_ISDIR(st.st_mode) && !$selectDirs) {
      set_directory($, path);
      return;
    }
    accept_path($, path);
  } else if ($selectDirs && $dir_mem) {
    accept_path($, $dir_mem);
  } else if ($status && $rows && m_len($rows) > 0) {
    XtVaSetValues($status, "label", "Select a file to open.", NULL);
  }
}

@proc void activate_row($, int row)
{
  char name[4096];
  char path[8192];
  struct stat st;

  row_name($, row, name, sizeof(name));
  if (!name[0] || !$dir_mem) return;
  snprintf(path, sizeof(path), "%s/%s", $dir_mem, name);

  if (stat(path, &st) == 0 && S_ISDIR(st.st_mode))
    set_directory($, path);
  else
    accept_path($, path);
}

@proc void list_activate_cb(Widget w, $, void *d)
{
  (void)w;
  activate_row($, (int)(intptr_t)d);
}

@proc void up_cb(Widget w, $, void *d)
{
  (void)w; (void)d;
  go_up($);
}

@proc void home_cb(Widget w, $, void *d)
{
  (void)w; (void)d;
  go_home($);
}

@proc void refresh_cb(Widget w, $, void *d)
{
  (void)w; (void)d;
  refresh($);
}

@proc void filter_cb(Widget w, $, void *d)
{
  char *s = NULL;
  (void)w; (void)d;
  XtVaGetValues($filter_ed, "label", &s, NULL);
  /* Wedit's label points into its own growing buffer; copy it. */
  free($pattern_mem);
  $pattern_mem = strdup(s ? s : "*");
  $pattern = $pattern_mem;
  refresh($);
}

@proc void hidden_cb(Widget w, $, void *d)
{
  Boolean checked = False;
  (void)d;
  XtVaGetValues(w, "checked", &checked, NULL);
  $showHidden = checked ? True : False;
  refresh($);
}

@proc void ok_cb(Widget w, $, void *d)
{
  (void)w; (void)d;
  accept_current($);
}

@proc void cancel_cb(Widget w, $, void *d)
{
  (void)w; (void)d;
  XtCallCallbackList($, $cancel, NULL);
}

@TRANSLATIONS
@trans   <Key>Escape: cancel_dialog()
@trans   <Key>Return: accept_default()

@ACTIONS

@proc cancel_dialog
{
  XtCallCallbackList($, $cancel, NULL);
}

@proc accept_default
{
  accept_current($);
}

@proc focus_default
{
  Widget shell = root_shell($);
  if (shell) XtSetKeyboardFocus(shell, $list);
}

