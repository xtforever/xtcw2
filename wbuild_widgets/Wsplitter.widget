@class Wsplitter(Composite)
@ A simple two-pane splitter widget that manages its first two children.

@PUBLIC
@var int vertical = 1
@var int fraction = 500
@var int dividerWidth = 6

@PRIVATE
@var Boolean dragging
@var int dragStartPos
@var int dragStartFraction
@var Cursor h_resize_cursor
@var Cursor v_resize_cursor
@var int cursor_state

@METHODS

@proc initialize
{
    $dragging = FALSE;
    $dragStartPos = 0;
    $dragStartFraction = 0;
    $h_resize_cursor = XCreateFontCursor(XtDisplay($), XC_sb_h_double_arrow);
    $v_resize_cursor = XCreateFontCursor(XtDisplay($), XC_sb_v_double_arrow);
    $cursor_state = 0;
    if ($width == 0) $width = 100;
    if ($height == 0) $height = 100;
}

@proc destroy
{
    if ($h_resize_cursor) {
        XFreeCursor(XtDisplay($), $h_resize_cursor);
        $h_resize_cursor = None;
    }
    if ($v_resize_cursor) {
        XFreeCursor(XtDisplay($), $v_resize_cursor);
        $v_resize_cursor = None;
    }
}

@proc resize
{
    do_layout($);
}

@proc change_managed
{
    do_layout($);
}

@proc expose
{
    draw_divider($);
}

@TRANSLATIONS
@trans <Btn1Down>:     start_drag()
@trans <Btn1Motion>:   do_drag()
@trans <Btn1Up>:       end_drag()
@trans <MotionNotify>: motion()
@trans <LeaveWindow>:  leave()

@ACTIONS

@proc start_drag
{
    int x = event->xbutton.x;
    int y = event->xbutton.y;

    if (on_divider($, x, y)) {
        $dragging = TRUE;
        $dragStartPos = $vertical ? x : y;
        $dragStartFraction = $fraction;
    }
}

@proc do_drag
{
    if (! $dragging) return;

    int pos = $vertical ? event->xmotion.x : event->xmotion.y;
    int total = $vertical ? $width : $height;
    
    if (total > 0) {
        int delta = (pos - $dragStartPos) * 1000 / total;
        $fraction = $dragStartFraction + delta;
        if ($fraction < 50) $fraction = 50;
        if ($fraction > 950) $fraction = 950;
        do_layout($);
        $expose($, NULL, NULL);
    }
}

@proc end_drag
{
    $dragging = FALSE;
    update_cursor($, event->xbutton.x, event->xbutton.y);
}

@proc motion
{
    if ($dragging) return;
    update_cursor($, event->xmotion.x, event->xmotion.y);
}

@proc leave
{
    if (! $dragging) set_cursor($, 0);
}

@UTILITIES

@proc int divider_position($)
{
    if ($vertical)
        return ($width - $dividerWidth) * $fraction / 1000;
    return ($height - $dividerWidth) * $fraction / 1000;
}

@proc int on_divider($, int x, int y)
{
    int pos = divider_position($);
    int p = $vertical ? x : y;
    int center = pos + $dividerWidth / 2;
    int d = p - center;

    if (d < 0) d = -d;
    return d <= $dividerWidth;
}

@proc update_cursor($, int x, int y)
{
    set_cursor($, on_divider($, x, y));
}

@proc set_cursor($, int on)
{
    int want = on ? ($vertical ? 1 : 2) : 0;
    Cursor cursor;

    if (! XtIsRealized($)) return;
    if (want == $cursor_state) return;
    $cursor_state = want;

    if (want) {
        cursor = (want == 1) ? $h_resize_cursor : $v_resize_cursor;
        if (cursor) XDefineCursor(XtDisplay($), XtWindow($), cursor);
    } else {
        XUndefineCursor(XtDisplay($), XtWindow($));
    }
}

@proc do_layout($)
{
    if ($num_children < 2) {
        /* If less than 2 children, just give the first one all space */
        if ($num_children == 1) {
            Widget child = $children[0];
            if (XtIsManaged(child)) {
                XtConfigureWidget(child, 0, 0, $width, $height, child->core.border_width);
            }
        }
        return;
    }

    Widget child1 = NULL;
    Widget child2 = NULL;
    int managed_count = 0;

    for (int i = 0; i < $num_children; i++) {
        if (XtIsManaged($children[i])) {
            if (managed_count == 0) child1 = $children[i];
            else if (managed_count == 1) child2 = $children[i];
            managed_count++;
        }
    }

    if (!child1) return;

    int div_w = $dividerWidth;
    if ($vertical) {
        int w1 = divider_position($);
        int w2 = $width - div_w - w1;

        XtConfigureWidget(child1, 0, 0, w1, $height, child1->core.border_width);
        if (child2) {
            XtConfigureWidget(child2, w1 + div_w, 0, w2, $height, child2->core.border_width);
        }
    } else {
        int h1 = divider_position($);
        int h2 = $height - div_w - h1;

        XtConfigureWidget(child1, 0, 0, $width, h1, child1->core.border_width);
        if (child2) {
            XtConfigureWidget(child2, 0, h1 + div_w, $width, h2, child2->core.border_width);
        }
    }
}

@proc draw_divider($)
{
    if (!XtIsRealized($)) return;
    
    Display *dpy = XtDisplay($);
    Window win = XtWindow($);
    GC gc = DefaultGC(dpy, DefaultScreen(dpy));
    int div_pos = divider_position($);

    /* Clear the divider area or draw a handle */
    if ($vertical)
        XFillRectangle(dpy, win, gc, div_pos, 0, $dividerWidth, $height);
    else
        XFillRectangle(dpy, win, gc, 0, div_pos, $width, $dividerWidth);
}

@IMPORTS
@incl "mls.h"
@incl "xutil.h"
@incl <X11/cursorfont.h>
