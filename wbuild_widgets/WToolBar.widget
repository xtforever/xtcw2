@class WToolBar (Composite)
@ Themed horizontal toolbar with natural-width action children.

@PUBLIC
@ toolbar height; -1 uses the theme control_height metric
@var int toolbarHeight = -1
@ gap between actions
@var int itemGap = -1
@ inner padding around the action row
@var int toolbarPadding = -1

@PRIVATE
@var int layout_guard

@METHODS

@proc initialize
{
    $layout_guard = 0;
    if ($toolbarHeight < 0)
        $toolbarHeight = theme_metric("control_height", 28);
    if ($toolbarHeight < 8) $toolbarHeight = 8;
    if ($itemGap < 0)
        $itemGap = theme_metric("control_gap", 8);
    if ($itemGap < 0) $itemGap = 0;
    if ($toolbarPadding < 0)
        $toolbarPadding = 4;
    if ($toolbarPadding < 0) $toolbarPadding = 0;

    if ($height == 0) $height = (Dimension)$toolbarHeight;
    XtVaSetValues($, XtNborderWidth, 0, NULL);
    theme_register($, toolbar_colors_changed);
    toolbar_colors_changed($);
}

@proc destroy
{
    theme_unregister($);
}

@proc realize
{
    #realize($, mask, attributes);
    toolbar_layout($);
}

@proc resize
{
    toolbar_layout($);
}

@proc expose
{
    Display *dpy = XtDisplay($);
    Window win = XtWindow($);
    if (!win) return;
    GC gc = DefaultGC(dpy, DefaultScreen(dpy));
    XSetForeground(dpy, gc, $background_pixel);
    XFillRectangle(dpy, win, gc, 0, 0, $width, $height);
}

@proc set_values
{
    if ($toolbarHeight != $old$toolbarHeight ||
        $itemGap != $old$itemGap ||
        $toolbarPadding != $old$toolbarPadding) {
        toolbar_layout($);
        return True;
    }
    return ($background_pixel != $old$background_pixel);
}

@proc change_managed
{
    if ($layout_guard) return;
    toolbar_layout($);
}

@proc insert_child
{
    (void)$;
    #insert_child(child);
}

@proc delete_child
{
    (void)$;
    #delete_child(child);
}

@proc query_geometry
{
    int w = 2 * $toolbarPadding;
    int h = $toolbarHeight;
    WidgetList children = NULL;
    Cardinal num_children = 0;
    XtVaGetValues($, XtNchildren, &children, XtNnumChildren, &num_children, NULL);

    for (Cardinal i = 0; i < num_children; i++) {
        Widget child = children ? children[i] : NULL;
        if (!child || !XtIsManaged(child)) continue;
        XtWidgetGeometry req, pref;
        memset(&req, 0, sizeof req);
        pref.request_mode = 0;
        int cw = (XtQueryGeometry(child, &req, &pref) == XtGeometryAlmost &&
                  (pref.request_mode & CWWidth)) ? (int)pref.width : (int)child->core.width;
        if (cw < 1) cw = 1;
        if (w > 2 * $toolbarPadding) w += $itemGap;
        w += cw;
    }
    if (w < 1) w = 1;
    if (h < 1) h = 1;

    reply->request_mode = CWWidth | CWHeight;
    reply->width = (Dimension)w;
    reply->height = (Dimension)h;
    return XtGeometryAlmost;
}

@proc set_values_almost
{
    request->width = reply->width;
    request->height = reply->height;
    request->request_mode = CWWidth | CWHeight;
}

@proc geometry_manager
{
    Dimension w = (request->request_mode & CWWidth) ? request->width : $child$width;
    Dimension h = (request->request_mode & CWHeight) ? request->height : $child$height;
    XtConfigureWidget(child, $child$x, $child$y, w, h, $child$border_width);
    toolbar_layout($);
    return XtGeometryDone;
}

@UTILITIES

@proc void toolbar_colors_changed($)
{
    Pixel bg = theme_color_defined("toolbar_bg") ? get_color("toolbar_bg")
             : (theme_color_defined("list_header_bg") ? get_color("list_header_bg")
             : (theme_color_defined("bg_hi") ? get_color("bg_hi")
             : (theme_color_defined("bg_norm") ? get_color("bg_norm") : 0)));
    if (bg) XtVaSetValues($, XtNbackground, bg, NULL);
    if (XtIsRealized($)) {
        XClearWindow(XtDisplay($), XtWindow($));
        toolbar_layout($);
    }
}

@proc void toolbar_layout($)
{
    if ($layout_guard) return;
    $layout_guard = 1;

    int pad = $toolbarPadding;
    int gap = $itemGap;
    int h = $toolbarHeight;
    if (h < 1) h = (int)$height;
    int inner_h = h - 2 * pad;
    if (inner_h < 1) inner_h = 1;

    int x = pad;
    WidgetList children = NULL;
    Cardinal num_children = 0;
    XtVaGetValues($, XtNchildren, &children, XtNnumChildren, &num_children, NULL);

    for (Cardinal i = 0; i < num_children; i++) {
        Widget child = children ? children[i] : NULL;
        if (!child || !XtIsManaged(child)) continue;

        XtWidgetGeometry req, pref;
        memset(&req, 0, sizeof req);
        pref.request_mode = 0;
        int w = (XtQueryGeometry(child, &req, &pref) == XtGeometryAlmost &&
                 (pref.request_mode & CWWidth)) ? (int)pref.width : (int)child->core.width;
        if (w < 1) w = 1;

        XtConfigureWidget(child, (Position)x, (Position)pad,
                          (Dimension)w, (Dimension)inner_h,
                          child->core.border_width);
        x += w + gap;
    }

    $layout_guard = 0;
}

@IMPORTS
@incl <string.h>
@incl "theme.h"
